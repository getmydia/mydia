---
import { Image } from 'astro:assets';
import homepage from '../assets/screenshots/homepage.png';
import tvShows from '../assets/screenshots/tv-shows.png';
import movies from '../assets/screenshots/movies.png';
import calendar from '../assets/screenshots/calendar.png';

const screenshots = [
  { src: homepage, alt: 'Mydia Server dashboard', label: 'Dashboard' },
  { src: tvShows, alt: 'TV shows library', label: 'TV Shows' },
  { src: movies, alt: 'Movies library', label: 'Movies' },
  { src: calendar, alt: 'Episode calendar', label: 'Calendar' },
];
---

<section class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">
      See it in action
    </h2>
    <p class="text-base-content/60 text-center mb-12 max-w-xl mx-auto">
      A clean, modern interface for managing your media collection.
    </p>

    <!-- Featured screenshot -->
    <div class="mb-8 rounded-xl overflow-hidden border border-base-300 shadow-2xl">
      <Image
        src={screenshots[0].src}
        alt={screenshots[0].alt}
        width={1600}
        class="w-full h-auto"
        loading="lazy"
      />
    </div>

    <!-- Thumbnail grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {screenshots.slice(1).map(screenshot => (
        <div class="group">
          <div class="rounded-lg overflow-hidden border border-base-300 hover:border-primary/30 transition-colors shadow-lg">
            <Image
              src={screenshot.src}
              alt={screenshot.alt}
              width={800}
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
          <p class="text-sm text-base-content/50 text-center mt-2">{screenshot.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
