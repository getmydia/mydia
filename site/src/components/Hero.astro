---
interface Link {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  badge?: string;
  title: string;
  accent?: string;
  subtitle: string;
  primary?: Link;
  secondary?: Link;
}

const { badge, title, accent, subtitle, primary, secondary } = Astro.props;

const external = (link: Link) =>
  link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<section class="py-24 px-4">
  <div class="max-w-4xl mx-auto text-center">
    {badge && <span class="badge badge-primary badge-outline mb-6">{badge}</span>}
    <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight mb-6">
      {title}
      {accent && (<><br /><span class="text-primary">{accent}</span></>)}
    </h1>
    <p class="text-lg sm:text-xl text-base-content/70 max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>
    {(primary || secondary) && (
      <div class="flex flex-wrap justify-center gap-3 mt-10">
        {primary && <a href={primary.href} class="btn btn-primary btn-lg" {...external(primary)}>{primary.label}</a>}
        {secondary && <a href={secondary.href} class="btn btn-outline btn-lg" {...external(secondary)}>{secondary.label}</a>}
      </div>
    )}
  </div>
</section>
