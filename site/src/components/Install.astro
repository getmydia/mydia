---
import { composeYaml } from '../data/compose';

// Steps 1 and 2 read differently when the page has filled in generated
// keys. `body` is what renders without JavaScript, where nothing is filled in.
const steps = [
  {
    title: 'Generate secret keys',
    body: 'Run openssl rand -base64 48 twice, once for SECRET_KEY_BASE and once for GUARDIAN_SECRET_KEY.',
    withSecrets: 'Both keys in the Compose file below were generated in your browser. Turn off the toggle to use your own.',
  },
  {
    title: 'Create docker-compose.yml',
    body: 'Save the Compose file below as docker-compose.yml, paste both secret keys into it, and set the media volume path to your library directory.',
    withSecrets: 'Save the Compose file below as docker-compose.yml and set the media volume path to your library directory.',
  },
  {
    title: 'Start Mydia Server',
    body: 'Run docker compose up -d, then open http://localhost:4000 to create your admin account.',
  },
];
---

<section id="install" class="py-20 px-4 scroll-mt-16">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-4">Install with Docker Compose</h2>
    <p class="text-base-content/60 text-center mb-10 max-w-xl mx-auto">
      Mydia Server runs as a single container with SQLite included.
    </p>

    <ol class="space-y-4 mb-8">
      {steps.map((step, i) => (
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-primary/10 text-primary font-semibold flex items-center justify-center flex-shrink-0">{i + 1}</span>
          <div>
            <h3 class="font-semibold">{step.title}</h3>
            <p class="text-base-content/60 text-sm" data-step-text data-without={step.body} data-with={step.withSecrets ?? step.body}>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="hidden flex-wrap items-center justify-between gap-2 mb-2" data-secrets-controls>
      <label class="flex items-center gap-2 text-sm text-base-content/70 cursor-pointer">
        <input type="checkbox" class="toggle toggle-primary toggle-sm" checked data-secrets-toggle />
        Fill in generated secret keys
      </label>
      <button type="button" class="btn btn-xs btn-ghost" data-secrets-regenerate>Regenerate</button>
    </div>

    <div class="relative" data-install-code>
      <button type="button" class="btn btn-sm btn-ghost absolute top-2 right-2" data-copy-button>Copy</button>
      <pre class="bg-base-300 rounded-xl p-4 pr-20 overflow-x-auto text-sm"><code data-copy-source>{composeYaml}</code></pre>
    </div>

    <div class="text-center mt-8">
      <a
        href="https://docs.mydia.dev/latest/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >Full guide</a>
    </div>
  </div>
</section>

<script>
  import { composeWithSecrets, composeYaml, randomSecret } from '../data/compose';

  // Progressive enhancement: without JavaScript (or without Web Crypto) the
  // section stays as rendered, with placeholders and the openssl step.
  document.querySelectorAll<HTMLElement>('#install').forEach((section) => {
    const controls = section.querySelector<HTMLElement>('[data-secrets-controls]');
    const toggle = section.querySelector<HTMLInputElement>('[data-secrets-toggle]');
    const regenerate = section.querySelector<HTMLButtonElement>('[data-secrets-regenerate]');
    const code = section.querySelector<HTMLElement>('[data-copy-source]');
    if (!controls || !toggle || !regenerate || !code || !globalThis.crypto?.getRandomValues) return;

    const fresh = () => ({ secretKeyBase: randomSecret(), guardianSecretKey: randomSecret() });
    let secrets = fresh();

    const render = () => {
      const on = toggle.checked;
      code.textContent = on ? composeWithSecrets(secrets) : composeYaml;
      regenerate.classList.toggle('invisible', !on);
      section.querySelectorAll<HTMLElement>('[data-step-text]').forEach((el) => {
        el.textContent = (on ? el.dataset.with : el.dataset.without) ?? el.textContent;
      });
    };

    toggle.addEventListener('change', render);
    regenerate.addEventListener('click', () => {
      secrets = fresh();
      render();
    });
    controls.classList.remove('hidden');
    controls.classList.add('flex');
    render();
  });

  document.querySelectorAll<HTMLElement>('[data-install-code]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-button]');
    const source = root.querySelector<HTMLElement>('[data-copy-source]');
    if (!button || !source) return;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source.textContent ?? '');
        button.textContent = 'Copied';
      } catch {
        // No clipboard outside a secure context, or permission denied.
        button.textContent = 'Copy failed, select the text above';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
      }, 2000);
    });
  });
</script>
