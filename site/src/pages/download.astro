      href: 'https://docs.mydia.dev/latest/using/how-to/install-player-linux/',
    },
    sizeFor: 'linux',
  },
  {
    id: 'web',
    name: 'Web',
    tagline: 'Nothing to install',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
    options: [],
    note: 'There is nothing to download. Your own Mydia server already serves the player at /player. Sign in and it is there.',
    docs: {
      label: 'How-to guides',
      href: 'https://docs.mydia.dev/latest/using/how-to/',
    },
  },
];
---

<Base
  title="Download Mydia Player"
  description="Download the Mydia Player for Android, iOS, macOS, Windows and Linux."
>
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="badge badge-primary badge-outline mb-4">Mydia Player</span>
        <h1 class="text-3xl sm:text-5xl font-bold mb-4">Download Mydia Player</h1>
        <p class="text-base-content/60 max-w-xl mx-auto mb-8">
          Stream your library from anywhere over an encrypted peer-to-peer connection.
          No port forwarding, no VPN.
        </p>

        <a id="primary-download" href="#platforms" class="btn btn-primary btn-lg gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z" />
            <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z" />
          </svg>
          <span data-primary-label>Download Mydia Player</span>
        </a>

        <p id="release-line" class="text-sm text-base-content/50 mt-4 hidden"></p>
      </div>

      <div id="platforms" class="grid md:grid-cols-2 gap-5 scroll-mt-20">
        {platforms.map(platform => (
          <div id={platform.id} class="card bg-base-200/60 border border-base-300 scroll-mt-20">
            <div class="card-body gap-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-primary"
                    viewBox="0 0 24 24"
                    fill={platform.id === 'web' ? 'none' : 'currentColor'}
                    stroke={platform.id === 'web' ? 'currentColor' : 'none'}
                    stroke-width={platform.id === 'web' ? '2' : '0'}
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d={platform.icon} />
                  </svg>
                </div>
                <div>
                  <h2 class="card-title text-lg">{platform.name}</h2>
                  <p class="text-sm text-base-content/50">
                    {platform.tagline}
                    {platform.sizeFor && (
                      <span data-size={platform.sizeFor} class="hidden"></span>
                    )}
                  </p>
                </div>
              </div>

              {platform.options.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {platform.options.map(option => (
                    <a
                      href={option.href}
                      class:list={['btn', 'btn-sm', option.primary ? 'btn-primary' : 'btn-outline']}
                    >
                      {option.label}
                    </a>
                  ))}
                </div>
              )}

              {platform.commands && (
                <pre
                  class="px-3 py-2 rounded bg-base-300/60 text-base-content/80 text-xs overflow-x-auto"
                ><code>{platform.commands}</code></pre>
              )}

              <p class="text-sm text-base-content/50 leading-relaxed">{platform.note}</p>

              {platform.docs && (
                <a href={platform.docs.href} class="link link-hover text-primary text-sm">
                  {platform.docs.label}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-base-content/40 mt-10">
        Every download resolves to the newest stable release.
        <a href="https://github.com/getmydia/mydia/releases" class="link link-hover text-primary">
          Browse all releases
        </a>
      </p>
    </div>
  </section>
</Base>

<script>
  interface Target {
    href: string;
    label: string;
  }

  // Linux points at its card rather than the tarball: the recommended path is
  // Flatpak, and that needs two commands rather than a file.
  const TARGETS: Record<string, Target> = {
    android: { href: '/download/android', label: 'Download for Android' },
    ios: { href: '/download/ios', label: 'Get the iOS beta' },
    macos: { href: '/download/macos', label: 'Download for macOS' },
    windows: { href: '/download/windows', label: 'Download for Windows' },
    linux: { href: '#linux', label: 'Get it for Linux' },
  };

  function detect(): string | null {
    const ua = navigator.userAgent.toLowerCase();
    const declared = String(
      (navigator as Navigator & { userAgentData?: { platform?: string } })
        .userAgentData?.platform ?? '',
    ).toLowerCase();

    // Android before Linux: every Android user agent also contains "linux".
    if (ua.includes('android')) return 'android';
    if (/iphone|ipad|ipod/.test(ua)) return 'ios';
    if (declared.includes('macos') || /mac os x|macintosh/.test(ua)) {
      // iPadOS 13 and later report themselves as desktop Safari on macOS.
      return navigator.maxTouchPoints > 1 ? 'ios' : 'macos';
    }
    if (declared.includes('windows') || ua.includes('windows')) return 'windows';
    if (declared.includes('linux') || /linux|x11/.test(ua)) return 'linux';
    return null;
  }

  const detected = detect();
  const button = document.getElementById('primary-download');
  if (detected && button instanceof HTMLAnchorElement) {
    const target = TARGETS[detected];
    button.href = target.href;
    const label = button.querySelector('[data-primary-label]');
    if (label) label.textContent = target.label;
  }

  function megabytes(bytes: number): string {
    return `${Math.round(bytes / 1_000_000)} MB`;
  }

  interface Summary {
    ok?: boolean;
    version?: string;
    publishedAt?: string;
    releaseUrl?: string;
    assets?: Record<string, { size: number }>;
  }

  // Progressive enhancement only. If this fails the page is already complete:
  // the version line stays hidden and every button still works.
  try {
    const summary: Summary = await (await fetch('/api/player-release')).json();
    if (summary.ok && summary.version) {
      const line = document.getElementById('release-line');
      if (line) {
        const when = summary.publishedAt
          ? new Date(summary.publishedAt).toLocaleDateString(undefined, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          : null;
        line.textContent = when
          ? `Latest release v${summary.version}, published ${when}. `
          : `Latest release v${summary.version}. `;

        if (summary.releaseUrl) {
          const link = document.createElement('a');
          link.href = summary.releaseUrl;
          link.className = 'link link-hover text-primary';
          link.textContent = 'Release notes';
          line.appendChild(link);
        }
        line.classList.remove('hidden');
      }

      for (const [slug, asset] of Object.entries(summary.assets ?? {})) {
        const el = document.querySelector(`[data-size="${slug}"]`);
        if (el) {
          el.textContent = ` · ${megabytes(asset.size)}`;
          el.classList.remove('hidden');
        }
      }
    }
  } catch {
    // Leave the page exactly as rendered.
  }
</script>
