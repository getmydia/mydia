    options: [
      { label: 'Get the Flatpak repo', href: '/download/flatpak', primary: true },
      { label: 'Download .tar.gz', href: '/download/linux' },
    ],
    commands: `flatpak remote-add --if-not-exists --from mydia https://flatpak.mydia.dev/mydia.flatpakrepo
flatpak install mydia dev.mydia.player`,
    note: 'The tarball is x64 and bundles no dependencies, so it needs libmpv, libsecret and GTK 3 already installed. The Flatpak carries its own.',
