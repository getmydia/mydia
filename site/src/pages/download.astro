    options: [{ label: 'Join the TestFlight beta', href: '/download/ios', primary: true }],
    note: 'Needs the free TestFlight app from the App Store. New builds reach testers automatically as they ship.',
  },
  {
    id: 'macos',
    name: 'macOS',
    tagline: 'Signed and notarized',
    icon: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z',
    options: [{ label: 'Download .dmg', href: '/download/macos', primary: true }],
    note: 'Notarized by Apple, and it keeps itself up to date once installed.',
    sizeFor: 'macos',
  },
  {
    id: 'windows',
    name: 'Windows',
    tagline: 'x64 installer',
    icon: 'M3 5.548l7.06-0.966v6.817H3V5.548zm0 12.905l7.06 0.966v-6.819H3v5.853zm7.862 1.075L21 21V12.601H10.862v6.927zM10.862 4.472v6.929H21V3L10.862 4.472z',
    options: [{ label: 'Download installer', href: '/download/windows', primary: true }],
    note: 'Installs for your user only, so it needs no admin rights. The build is not code signed, so Windows shows a SmartScreen warning the first time. Choose More info, then Run anyway.',
    sizeFor: 'windows',
  },
  {
    id: 'linux',
    name: 'Linux',
    tagline: 'Flatpak recommended',
