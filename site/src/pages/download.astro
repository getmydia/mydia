---
import Base from '../layouts/Base.astro';
import { PLATFORM_ICONS } from '../data/platform-icons';
import type { Track } from '../lib/release-feed';

interface Option {
  label: string;
  href: string;
  primary?: boolean;
}

/** What a card shows on one release track. */
interface Channel {
  options?: Option[];
  commands?: string;
  note: string;
  docs?: { label: string; href: string };
  /** releases.json key whose version, size and date fill this panel. */
  feed?: string;
  /** Names what the feed line describes when the panel offers more than one way in. */
  feedLabel?: string;
}

interface Platform {
  id: keyof typeof PLATFORM_ICONS;
  name: string;
  tagline: string;
  /** Slug /api/player-release reports a stable file size under. */
  sizeFor?: string;
  channels: Partial<Record<Track, Channel>>;
  /** Shown on a track the platform has no build for. */
  unavailable?: Partial<Record<Track, string>>;
}

const docsBase = 'https://docs.mydia.dev/latest/using/how-to';
const linuxDocs = `${docsBase}/install-player-linux/`;
const trackSetting = (track: string) =>
  `To keep receiving ${track} builds after installing, open Settings › Manage › Release track and choose ${track[0].toUpperCase()}${track.slice(1)}.`;
const devWarning =
  'Dev builds come straight from development. They are untested and can break without notice.';

const platforms: Platform[] = [
  {
    id: 'android',
    name: 'Android',
    tagline: 'Phones, tablets and Android TV',
    sizeFor: 'android',
    channels: {
      stable: {
        options: [{ label: 'Download APK', href: '/download/android', primary: true }],
        note: 'Android prompts you to allow installs from unknown sources the first time you open the APK. Later updates can be installed from inside the app.',
      },
      beta: {
        options: [{ label: 'Download beta APK', href: '/download/android?track=beta', primary: true }],
        note: `Installs over the stable app and keeps your data. ${trackSetting('beta')}`,
        feed: 'android:beta',
      },
      dev: {
        options: [{ label: 'Download dev APK', href: '/download/android?track=dev', primary: true }],
        note: `${devWarning} ${trackSetting('dev')}`,
        feed: 'android:dev',
      },
    },
  },
  {
    id: 'ios',
    name: 'iOS',
    tagline: 'iPhone and iPad',
    channels: {
      stable: {
        options: [{ label: 'Install via TestFlight', href: '/download/ios', primary: true }],
        note: 'Requires the TestFlight app from the App Store. Updates are delivered through TestFlight.',
      },
      beta: {
        options: [{ label: 'Join the TestFlight beta', href: '/download/ios?track=beta', primary: true }],
        note: 'Betas and release candidates have their own TestFlight group. Joining it keeps you in the stable group too; leave either one from inside the TestFlight app.',
      },
    },
    unavailable: {
      dev: 'There are no dev builds for iOS. Switch to Beta to join the pre-release TestFlight group.',
    },
  },
  {
    id: 'macos',
    name: 'macOS',
    tagline: 'Signed and notarized',
    sizeFor: 'macos',
    channels: {
      stable: {
        options: [{ label: 'Download .dmg', href: '/download/macos', primary: true }],
        note: 'Notarized by Apple, with built-in automatic updates.',
      },
      beta: {
        options: [{ label: 'Download beta .dmg', href: '/download/macos?track=beta', primary: true }],
        note: `Replaces the stable app and keeps your data. ${trackSetting('beta')}`,
        feed: 'macos:beta',
      },
      dev: {
        options: [{ label: 'Download dev .dmg', href: '/download/macos?track=dev', primary: true }],
        note: `${devWarning} ${trackSetting('dev')}`,
        feed: 'macos:dev',
      },
    },
  },
  {
    id: 'windows',
    name: 'Windows',
    tagline: 'x64 installer',
    sizeFor: 'windows',
    channels: {
      stable: {
        options: [{ label: 'Download installer', href: '/download/windows', primary: true }],
        commands: 'irm https://mydia.dev/install.ps1 | iex',
        note: 'Run the PowerShell command to install without a SmartScreen warning. Because the installer is not code-signed, downloading it in a browser triggers a SmartScreen prompt on first launch (click More info, then Run anyway). Installs per-user without administrator rights.',
      },
      beta: {
        options: [{ label: 'Download beta installer', href: '/download/windows?track=beta', primary: true }],
        note: `The installer is not code-signed, so SmartScreen asks on first launch (click More info, then Run anyway). ${trackSetting('beta')}`,
        feed: 'windows:beta',
      },
    },
    unavailable: {
      dev: 'There are no dev builds for Windows yet. Switch to Beta for the newest tested pre-release.',
    },
  },
  {
    id: 'linux',
    name: 'Linux',
    tagline: 'Flatpak recommended',
    sizeFor: 'linux',
    channels: {
      stable: {
        options: [
          { label: 'Get the Flatpak repo', href: '/download/flatpak', primary: true },
          { label: 'Download .tar.gz', href: '/download/linux' },
        ],
        commands: `flatpak remote-add --if-not-exists --from mydia https://flatpak.mydia.dev/mydia.flatpakrepo
flatpak install mydia dev.mydia.player`,
        note: 'The Flatpak includes all required libraries. The x64 tarball requires libmpv, libsecret and GTK 3 on the host system.',
        docs: { label: 'Tarball instructions', href: linuxDocs },
      },
      beta: {
        options: [
          { label: 'Get the beta Flatpak repo', href: '/download/flatpak?track=beta', primary: true },
          { label: 'Download beta .tar.gz', href: '/download/linux?track=beta' },
        ],
        commands: `flatpak remote-add --if-not-exists --from mydia-beta https://flatpak.mydia.dev/mydia-beta.flatpakrepo
flatpak install mydia-beta dev.mydia.player//beta`,
        note: 'The beta Flatpak lives on its own remote and branch. If stable is installed, remove it afterwards with flatpak uninstall dev.mydia.player//stable.',
        docs: { label: 'Switching branches', href: `${linuxDocs}#beta` },
        feed: 'linux:beta',
        feedLabel: 'Tarball',
      },
      dev: {
        options: [{ label: 'Get the dev Flatpak repo', href: '/download/flatpak?track=dev', primary: true }],
        commands: `flatpak remote-add --if-not-exists --from mydia-dev https://flatpak.mydia.dev/mydia-dev.flatpakrepo
flatpak install mydia-dev dev.mydia.player//dev`,
        note: `${devWarning} Dev is Flatpak only. If stable is installed, remove it afterwards with flatpak uninstall dev.mydia.player//stable.`,
        docs: { label: 'Switching branches', href: `${linuxDocs}#dev` },
      },
    },
  },
  {
    id: 'web',
    name: 'Web',
    tagline: 'Included with Mydia Server',
    channels: {
      stable: {
        note: 'Mydia Server hosts the web build of Mydia Player at /player. Open that URL in a browser and sign in with your server account.',
        docs: { label: 'How-to guides', href: `${docsBase}/` },
      },
      beta: {
        commands: 'image: ghcr.io/getmydia/mydia:beta',
        note: 'The web player is whatever version your server runs. Run the server’s :beta image (:beta-pg for PostgreSQL) to get the beta player.',
        docs: { label: 'Testing pre-release builds', href: `${docsBase}/update-mydia/#testing-pre-release-builds` },
      },
      dev: {
        commands: 'image: ghcr.io/getmydia/mydia:master',
        note: 'The :master image (:master-pg for PostgreSQL) rebuilds on every merge and carries the newest web player. It is amd64 only and not meant for production.',
        docs: { label: 'Testing pre-release builds', href: `${docsBase}/update-mydia/#testing-pre-release-builds` },
      },
    },
  },
];

const tracks: { id: Track; label: string; blurb: string }[] = [
  { id: 'stable', label: 'Stable', blurb: 'Tested releases. The right choice for most people.' },
  { id: 'beta', label: 'Beta', blurb: 'Release candidates, a few weeks ahead of stable. Expect the occasional rough edge.' },
  { id: 'dev', label: 'Dev', blurb: 'Built from the main branch for trying fixes before release. Untested.' },
];

// Every card links to its own section of the beta builds docs page. The
// section ids there are pinned to the card ids above, so a new card gets a
// working link for free.
const betaDocs = `${docsBase}/beta-builds/`;
---

<Base
  title="Download Mydia Player"
  description="Download Mydia Player for Android, iOS, macOS, Windows and Linux, including beta and dev builds."
>
  <section id="downloads" class="py-12 sm:py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10 sm:mb-12">
        <span class="badge badge-primary badge-outline mb-4">Mydia Player</span>
        <h1 class="text-3xl sm:text-5xl font-bold mb-4">Download Mydia Player</h1>
        <p class="text-base-content/60 max-w-xl mx-auto mb-8">
          Play from Plex, Jellyfin and Mydia Server on Android, iOS, macOS, Windows, Linux and the web.
        </p>

        <div class="join mb-3" role="radiogroup" aria-label="Release track">
          {tracks.map(track => (
            <input
              id={`track-${track.id}`}
              class="join-item btn btn-sm sm:btn-md px-5"
              type="radio"
              name="track"
              value={track.id}
              aria-label={track.label}
              checked={track.id === 'stable'}
            />
          ))}
        </div>
        {tracks.map(track => (
          <p data-track={track.id} class="track-panel justify-center text-sm text-base-content/50 mb-6 max-w-md mx-auto">
            {track.blurb}
          </p>
        ))}

        <a id="primary-download" href="#platforms" class="btn btn-primary btn-lg gap-2 max-w-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z" />
            <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z" />
          </svg>
          <span data-primary-label class="truncate">Download Mydia Player</span>
        </a>

        <p id="release-line" class="text-sm text-base-content/50 mt-4 hidden"></p>
      </div>

      <div id="platforms" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 scroll-mt-20">
        {platforms.map(platform => (
          <div id={platform.id} class="card min-w-0 bg-base-200/60 border border-base-300 scroll-mt-20">
            <div class="card-body gap-4 p-5 sm:p-8">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 text-primary"
                    viewBox="0 0 24 24"
                    fill={platform.id === 'web' ? 'none' : 'currentColor'}
                    stroke={platform.id === 'web' ? 'currentColor' : 'none'}
                    stroke-width={platform.id === 'web' ? '2' : '0'}
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d={PLATFORM_ICONS[platform.id]} />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h2 class="card-title text-lg">{platform.name}</h2>
                  <p class="text-sm text-base-content/50">{platform.tagline}</p>
                </div>
              </div>

              {tracks.map(({ id: track }) => {
                const channel = platform.channels[track];
                if (!channel) {
                  return (
                    <div data-track={track} class="track-panel flex-col items-start gap-4">
                      <p class="text-sm text-base-content/50 leading-relaxed rounded-lg border border-dashed border-base-300 px-4 py-3">
                        {platform.unavailable?.[track]}
                      </p>
                    </div>
                  );
                }
                return (
                  <div data-track={track} class="track-panel flex-col gap-4 flex-1">
                    {channel.feed && (
                      <p data-feed={channel.feed} data-feed-label={channel.feedLabel} class="text-xs text-base-content/50 hidden"></p>
                    )}
                    {track === 'stable' && platform.sizeFor && (
                      <p data-size={platform.sizeFor} class="text-xs text-base-content/50 hidden"></p>
                    )}
                    {channel.options && (
                      <div class="flex flex-wrap gap-2">
                        {channel.options.map(option => (
                          <a
                            href={option.href}
                            class:list={['btn', 'btn-sm', 'max-w-full', option.primary ? 'btn-primary' : 'btn-outline']}
                          >
                            {option.label}
                          </a>
                        ))}
                      </div>
                    )}
                    {channel.commands && (
                      <pre class="px-3 py-2 rounded bg-base-300/60 text-base-content/80 text-xs overflow-x-auto"><code>{channel.commands}</code></pre>
                    )}
                    <p class="text-sm text-base-content/50 leading-relaxed">{channel.note}</p>
                    {channel.docs && (
                      <a href={channel.docs.href} class="link link-hover text-primary text-sm w-fit">
                        {channel.docs.label}
                      </a>
                    )}
                  </div>
                );
              })}

              <div class="mt-auto pt-1 text-sm">
                <a
                  href={`${betaDocs}#${platform.id}`}
                  class="link link-hover text-base-content/50"
                  data-beta-link={platform.id}
                >
                  About pre-release builds for {platform.name}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p data-track="stable" class="track-panel flex-wrap justify-center gap-x-1 text-center text-sm text-base-content/40 mt-10">
        Download links point to the latest stable release.
        <a href="https://github.com/getmydia/mydia/releases" class="link link-hover text-primary">
          Browse all releases
        </a>
      </p>
      <p data-track="beta" class="track-panel flex-wrap justify-center gap-x-1 text-center text-sm text-base-content/40 mt-10">
        Found a problem in a beta?
        <a href="https://github.com/getmydia/mydia/issues" class="link link-hover text-primary">
          Open an issue
        </a>
        and include the version shown in Settings.
      </p>
      <p data-track="dev" class="track-panel flex-wrap justify-center gap-x-1 text-center text-sm text-base-content/40 mt-10">
        Dev builds are not covered by release notes.
        <a href="https://github.com/getmydia/mydia/commits/master" class="link link-hover text-primary">
          Read the commit log
        </a>
      </p>
    </div>
  </section>
</Base>

<script>
  import { FEED_URL, parseFeed, resolveTrackBuild, type Track } from '../lib/release-feed';

  interface Target {
    href: string;
    label: string;
  }

  // Linux points at its card rather than a file: the recommended path is
  // Flatpak, and that needs two commands rather than a download.
  const TARGETS: Record<string, Partial<Record<Track, Target>>> = {
    android: {
      stable: { href: '/download/android', label: 'Download for Android' },
      beta: { href: '/download/android?track=beta', label: 'Download the Android beta' },
      dev: { href: '/download/android?track=dev', label: 'Download the Android dev build' },
    },
    ios: {
      stable: { href: '/download/ios', label: 'Install via TestFlight' },
      beta: { href: '/download/ios?track=beta', label: 'Join the TestFlight beta' },
    },
    macos: {
      stable: { href: '/download/macos', label: 'Download for macOS' },
      beta: { href: '/download/macos?track=beta', label: 'Download the macOS beta' },
      dev: { href: '/download/macos?track=dev', label: 'Download the macOS dev build' },
    },
    windows: {
      stable: { href: '/download/windows', label: 'Download for Windows' },
      beta: { href: '/download/windows?track=beta', label: 'Download the Windows beta' },
    },
    linux: {
      stable: { href: '#linux', label: 'Get it for Linux' },
      beta: { href: '#linux', label: 'Get the Linux beta' },
      dev: { href: '#linux', label: 'Get the Linux dev build' },
    },
  };

  function detect(): string | null {
    const ua = navigator.userAgent.toLowerCase();
    const declared = String(
      (navigator as Navigator & { userAgentData?: { platform?: string } })
        .userAgentData?.platform ?? '',
    ).toLowerCase();

    // Android before Linux: every Android user agent also contains "linux".
    if (ua.includes('android')) return 'android';
    if (/iphone|ipad|ipod/.test(ua)) return 'ios';
    if (declared.includes('macos') || /mac os x|macintosh/.test(ua)) {
      // iPadOS 13 and later report themselves as desktop Safari on macOS.
      return navigator.maxTouchPoints > 1 ? 'ios' : 'macos';
    }
    if (declared.includes('windows') || ua.includes('windows')) return 'windows';
    if (declared.includes('linux') || /linux|x11/.test(ua)) return 'linux';
    return null;
  }

  const detected = detect();
  const button = document.getElementById('primary-download');
  const buttonLabel = button?.querySelector('[data-primary-label]');

  function updatePrimary(track: Track) {
    if (!(button instanceof HTMLAnchorElement) || !buttonLabel) return;
    const target = detected ? TARGETS[detected]?.[track] : undefined;
    if (target) {
      button.href = target.href;
      buttonLabel.textContent = target.label;
    } else {
      // No build of this track for the visitor's platform (or no platform):
      // send them to the cards, which say what exists.
      button.href = detected ? `#${detected}` : '#platforms';
      buttonLabel.textContent = track === 'stable' ? 'Download Mydia Player' : 'See all platforms';
    }
  }

  // The track switch works without this script (CSS :has); the script only
  // keeps the URL, the main button and a ?track= link in step with it.
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="track"]');
  function selectedTrack(): Track {
    for (const radio of radios) if (radio.checked) return radio.value as Track;
    return 'stable';
  }

  const requested = new URLSearchParams(location.search).get('track');
  for (const radio of radios) {
    if (radio.value === requested) radio.checked = true;
    radio.addEventListener('change', () => {
      const track = selectedTrack();
      updatePrimary(track);
      const url = new URL(location.href);
      if (track === 'stable') url.searchParams.delete('track');
      else url.searchParams.set('track', track);
      history.replaceState(null, '', url);
    });
  }
  updatePrimary(selectedTrack());

  function megabytes(bytes: number): string {
    return `${Math.round(bytes / 1_000_000)} MB`;
  }

  function day(iso?: string): string | null {
    return iso
      ? new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
      : null;
  }

  interface Summary {
    ok?: boolean;
    version?: string;
    publishedAt?: string;
    releaseUrl?: string;
    assets?: Record<string, { size: number }>;
  }


  // Progressive enhancement only. If either request fails the page is already
  // complete: the version lines stay hidden and every button still works.
  async function showStableRelease() {
    const summary: Summary = await (await fetch('/api/player-release')).json();
    if (!summary.ok || !summary.version) return;

    const line = document.getElementById('release-line');
    if (line) {
      const when = day(summary.publishedAt);
      line.textContent = when
        ? `Latest stable release v${summary.version}, published ${when}. `
        : `Latest stable release v${summary.version}. `;
      if (summary.releaseUrl) {
        const link = document.createElement('a');
        link.href = summary.releaseUrl;
        link.className = 'link link-hover text-primary';
        link.textContent = 'Release notes';
        line.appendChild(link);
      }
      line.classList.remove('hidden');
    }

    for (const [slug, asset] of Object.entries(summary.assets ?? {})) {
      const el = document.querySelector(`[data-size="${slug}"]`);
      if (el) {
        el.textContent = `v${summary.version} · ${megabytes(asset.size)}`;
        el.classList.remove('hidden');
      }
    }
  }

  // The same resolver the ?track= redirects use, so the version shown is the
  // version the button downloads.
  async function showPreReleases() {
    const feed = parseFeed(await (await fetch(FEED_URL)).text());
    if (!feed) return;

    for (const el of document.querySelectorAll<HTMLElement>('[data-feed]')) {
      const [platform, track] = (el.dataset.feed ?? '').split(':') as [string, Track];
      const best = resolveTrackBuild(feed, platform, track);
      if (!best) continue;

      const { entry } = best;
      const parts = [`v${entry.version}`];
      if (entry.size) parts.push(megabytes(entry.size));
      const when = day(entry.published_at);
      if (when) parts.push(when);
      // Set where the build is one of several ways in (the Linux tarball beside
      // the Flatpak remote), so the line does not describe the wrong button.
      const subject = el.dataset.feedLabel;
      const details = parts.join(' · ');
      el.textContent =
        best.track === track
          ? subject ? `${subject}: ${details}` : details
          : `No ${track} ${subject ? subject.toLowerCase() : 'build'} newer than ${best.track} right now, so ${subject ? 'it' : 'this'} gets ${details}`;
      el.classList.remove('hidden');
    }
  }

  await Promise.allSettled([showStableRelease(), showPreReleases()]);
</script>
