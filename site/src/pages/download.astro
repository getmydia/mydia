---
import Base from '../layouts/Base.astro';

interface Option {
  label: string;
  href: string;
  primary?: boolean;
}

interface Platform {
  id: string;
  name: string;
  tagline: string;
  icon: string;
  options: Option[];
  note: string;
  commands?: string;
  docs?: { label: string; href: string };
  sizeFor?: string;
}

const platforms: Platform[] = [
  {
    id: 'android',
    name: 'Android',
    tagline: 'Phones and tablets',
