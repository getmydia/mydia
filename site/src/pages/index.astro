---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import LatestPosts from '../components/LatestPosts.astro';
import { Image } from 'astro:assets';
import pane1 from '../assets/glass/pane-1.jpg';
import pane2 from '../assets/glass/pane-2.jpg';
import pane3 from '../assets/glass/pane-3.jpg';
import playerHome from '../assets/screenshots/player-home.png';
import playerDesktop from '../assets/screenshots/player-desktop.png';
import serverHome from '../assets/screenshots/homepage.png';

// Three still panes of the hero's glass (assets/export-glass-panes.js).
const fan = [
  { pane: pane1, class: '-rotate-12 -translate-x-[7.5rem] translate-y-6' },
  { pane: pane2, class: 'rotate-0 -translate-y-1' },
  { pane: pane3, class: 'rotate-12 translate-x-[7.5rem] translate-y-6' },
];
// daisyUI's hover-3d tilts its first child from eight hover zones that follow it.
const hoverZones = Array.from({ length: 8 });

const together = [
  { title: 'Remote streaming', body: 'Connect Mydia Player to Mydia Server from outside your home network over an encrypted peer-to-peer link without port forwarding.' },
  { title: 'Transcoded downloads', body: 'Mydia Server can transcode movies and episodes to smaller files before Mydia Player downloads them for offline playback.' },
  { title: 'Shared accounts', body: 'Sign in to Mydia Player with your Mydia Server account and keep watch progress synced across devices.' },
];
---

<Base
  title="Mydia: media player and self-hosted library server"
  description="Mydia Player connects to Plex, Jellyfin and Mydia Server on phones, tablets, TVs and desktops. Mydia Server organizes your movies and TV shows and automates downloads."
>
  <Hero
    title="Open-source media player"
    accent="and library server"
    subtitle="Play from Plex, Jellyfin and Mydia Server on your devices, or run Mydia Server to organize and download movies and TV shows."
    wall={{ height: '40rem' }}
  />

  <section class="px-4 -mt-16 sm:-mt-20 pb-24 relative overflow-x-clip">
    <div class="max-w-6xl mx-auto relative isolate">
      <div class="shot-glow"></div>
      <div class="rounded-2xl overflow-hidden border border-base-content/15 bg-base-300 shadow-2xl shadow-black/60">
        <div class="flex items-center gap-1.5 px-4 py-2.5 bg-base-200 border-b border-base-content/10">
          <span class="w-3 h-3 rounded-full bg-error/70"></span>
          <span class="w-3 h-3 rounded-full bg-warning/70"></span>
          <span class="w-3 h-3 rounded-full bg-success/70"></span>
        </div>
        <Image
          src={playerDesktop}
          alt="Mydia Player on a desktop, showing the library home screen"
          width={1600}
          class="w-full h-auto"
        />
      </div>
    </div>
  </section>

  <section class="pb-24 px-4">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-8">
      <ProductCard
        id="player"
        name="Mydia Player"
        bullets={[
          'Connects to Plex, Jellyfin and Mydia Server',
          'Offline downloads on phones, tablets and laptops',
          'Android, iOS, macOS, Windows, Linux and web',
        ]}
        primary={{ label: 'Download', href: '/download' }}
        secondary={{ label: 'Learn more', href: '/player' }}
      >
        <div slot="media" class="absolute inset-0">
          {fan.map((p) => (
            <div class={`hover-3d absolute left-1/2 top-8 -ml-[4.5rem] w-36 ${p.class}`}>
              <Image
                src={p.pane}
                alt=""
                width={320}
                loading="lazy"
                class="w-full h-auto rounded-lg ring-1 ring-white/20 shadow-2xl shadow-black/60"
              />
              {hoverZones.map(() => <div></div>)}
            </div>
          ))}
          <div class="absolute left-1/2 -translate-x-1/2 top-24 w-48 rounded-[1.75rem] border-4 border-base-content/25 bg-base-300 p-1 shadow-2xl shadow-black/70">
            <div class="rounded-[1.4rem] overflow-hidden">
              <Image src={playerHome} alt="Mydia Player home screen on a phone" width={480} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
        </div>
      </ProductCard>
      <ProductCard
        name="Mydia Server"
        bullets={[
          'Scans your library and fetches TMDB and TVDB metadata',
          'Monitors and downloads missing movies and episodes',
          'Peer-to-peer remote access without port forwarding',
        ]}
        primary={{ label: 'Get started', href: '/server#install' }}
        secondary={{ label: 'Learn more', href: '/server' }}
      >
        <div slot="media" class="absolute inset-0">
          <Image
            src={serverHome}
            alt="Mydia Server dashboard"
            width={1400}
            loading="lazy"
            class="absolute top-10 left-8 w-[165%] max-w-none rounded-tl-xl border border-base-content/15 shadow-2xl shadow-black/60"
          />
        </div>
      </ProductCard>
    </div>
  </section>

  <section id="together" class="py-16 px-4 bg-base-200/50 scroll-mt-16">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-10">Using both together</h2>
      <div class="grid sm:grid-cols-3 gap-6 mb-8">
        {together.map(item => (
          <div>
            <h3 class="font-semibold mb-1">{item.title}</h3>
            <p class="text-sm text-base-content/60">{item.body}</p>
          </div>
        ))}
      </div>
      <a href="/server" class="link link-primary text-sm">More about Mydia Server</a>
    </div>
  </section>

  <LatestPosts />
</Base>
