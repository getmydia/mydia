---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sources from '../components/Sources.astro';
import Features from '../components/Features.astro';
import ThemeShowcase from '../components/ThemeShowcase.astro';
import Platforms from '../components/Platforms.astro';
import CrossSell from '../components/CrossSell.astro';
import { Image } from 'astro:assets';
import { playerThemes } from '../data/themes';
import playerHome from '../assets/screenshots/player-home.png';
import playerShows from '../assets/screenshots/player-shows.png';
import playerDesktop from '../assets/screenshots/player-desktop.png';

// Movies first, for a cinema feel behind the player hero.
const wallPosters = [
  'lanternfall-station', 'copper-weather', 'paper-lighthouse', 'hollow-meridian',
  'a-kettle-for-two-moons', 'midnight-at-pellwick-pier', 'orbit-of-small-things',
  'thessaly-rides-alone', 'tidewrack', 'the-last-tram-to-ovelle', 'wintergreen-protocol',
  'saltmarsh-radio', 'quillfeather-road', 'ashgrove-after-dark', 'dunmore-drift',
  'marrow-and-thistle',
];

const features = [
  { icon: 'devices', title: 'Every platform', description: 'Phone, tablet, TV, desktop and web, with the same library on each.' },
  { icon: 'download', title: 'Offline downloads', description: 'Save movies and episodes to your device and watch without a connection.' },
  { icon: 'cast', title: 'Cast to Chromecast and DLNA', description: 'Send what you are watching to a TV or speaker on your network.' },
  { icon: 'users', title: 'Plex Home profiles', description: 'Switch between the users on your Plex Home, PIN checks included.' },
  { icon: 'play', title: 'Native playback', description: 'Hardware-accelerated video, so high bitrate files play smoothly.' },
  { icon: 'refresh', title: 'Continue watching across servers', description: 'Pick up where you left off, with every server you use in one list.' },
];
---

<Base
  title="Mydia Player: one app for Plex, Jellyfin and Mydia Server"
  description="Mydia Player brings Plex, Jellyfin and Mydia Server together in one app on phone, tablet, TV, desktop and web."
>
  <Hero
    badge="Mydia Player"
    title="One player for all your media."
    subtitle="Plex, Jellyfin, your Mydia Server, and soon your own folders, in one app on every screen."
    primary={{ label: 'Download', href: '/download' }}
    secondary={{ label: 'See platforms', href: '/download#platforms' }}
    wall={{ rows: 3, height: '34rem', posters: wallPosters }}
  />

  <Sources />

  <Features
    title="Everything you expect from a player"
    subtitle="Built for the way you watch, whichever server it comes from."
    items={features}
  />

  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">On the couch and on the go</h2>
      <div class="flex justify-center gap-6 mb-16">
        <div class="relative">
          <div class="w-[280px] rounded-[2rem] border-4 border-base-content/20 bg-base-300 p-1.5 shadow-2xl">
            <div class="w-full rounded-[1.5rem] overflow-hidden">
              <Image src={playerHome} alt="Mydia Player home screen" width={480} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="absolute -inset-4 bg-primary/5 rounded-[3rem] -z-10 blur-2xl"></div>
        </div>
        <div class="relative hidden sm:block mt-12">
          <div class="w-[280px] rounded-[2rem] border-4 border-base-content/20 bg-base-300 p-1.5 shadow-2xl">
            <div class="w-full rounded-[1.5rem] overflow-hidden">
              <Image src={playerShows} alt="Mydia Player shows library" width={480} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="absolute -inset-4 bg-primary/5 rounded-[3rem] -z-10 blur-2xl"></div>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-base-content/15 shadow-2xl shadow-black/60">
        <Image src={playerDesktop} alt="Mydia Player on a desktop, showing the library home screen" width={1600} class="w-full h-auto" loading="lazy" />
      </div>
      <p class="text-sm text-base-content/50 text-center mt-3">On desktop, and in any browser.</p>
    </div>
  </section>

  <ThemeShowcase
    id="themes"
    heading="Pick your look"
    subheading="Three looks to start from. Change it any time in settings."
    themes={playerThemes}
    aspect="desktop"
  />

  <Platforms />

  <CrossSell
    text="Run your own library? Pair it with Mydia Server for remote streaming without port forwarding."
    href="/server"
    label="Meet Mydia Server"
  />
</Base>
