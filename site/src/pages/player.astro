---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sources from '../components/Sources.astro';
import Features from '../components/Features.astro';
import ThemeShowcase from '../components/ThemeShowcase.astro';
import Platforms from '../components/Platforms.astro';
import CrossSell from '../components/CrossSell.astro';
import { Image } from 'astro:assets';
import { playerThemes } from '../data/themes';
import { postersFrom } from '../data/posters';
import playerHome from '../assets/screenshots/player-home.png';
import playerShows from '../assets/screenshots/player-shows.png';
import playerDesktop from '../assets/screenshots/player-desktop.png';

// A third of the way in, so the wall opens on different posters than the
// homepage and server walls.
const wallPosters = postersFrom(1 / 3);

const features = [
  { icon: 'devices', title: 'Cross-platform', description: 'Native apps for Android, Android TV, iOS, iPadOS, macOS, Windows and Linux, plus a web player.' },
  { icon: 'download', title: 'Offline downloads', description: 'Download movies and episodes to watch offline on phones, tablets, TVs and laptops.' },
  { icon: 'cast', title: 'Cast to Chromecast and DLNA', description: 'Send video and audio playback to a Chromecast or DLNA receiver on your local network.' },
  { icon: 'users', title: 'Plex Home profiles', description: 'Switch between Plex Home users, including PIN-protected profiles.' },
  { icon: 'play', title: 'Native playback', description: 'Hardware-accelerated decoding for high-bitrate video and common audio and subtitle formats.' },
  { icon: 'refresh', title: 'Continue watching across servers', description: 'Combines in-progress movies and episodes from all connected servers into one row.' },
];
---

<Base
  title="Mydia Player: client for Plex, Jellyfin and Mydia Server"
  description="Mydia Player connects to Plex, Jellyfin and Mydia Server on phones, tablets, TVs, desktops and the web."
>
  <Hero
    badge="Mydia Player"
    title="A player for your existing servers."
    subtitle="Play from Plex, Jellyfin, Mydia Server, and soon local folders, on Android, iOS, desktop and the web."
    primary={{ label: 'Download', href: '/download' }}
    secondary={{ label: 'See platforms', href: '/download#platforms' }}
    wall={{ rows: 3, height: '34rem', posters: wallPosters }}
  />

  <Sources />

  <Features
    title="Features"
    subtitle="Playback, offline downloads and multi-server support."
    items={features}
  />

  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">Mobile and desktop</h2>
      <div class="flex justify-center gap-6 mb-16">
        <div class="relative">
          <div class="w-[280px] rounded-[2rem] border-4 border-base-content/20 bg-base-300 p-1.5 shadow-2xl">
            <div class="w-full rounded-[1.5rem] overflow-hidden">
              <Image src={playerHome} alt="Mydia Player home screen" width={480} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="absolute -inset-4 bg-primary/5 rounded-[3rem] -z-10 blur-2xl"></div>
        </div>
        <div class="relative hidden sm:block mt-12">
          <div class="w-[280px] rounded-[2rem] border-4 border-base-content/20 bg-base-300 p-1.5 shadow-2xl">
            <div class="w-full rounded-[1.5rem] overflow-hidden">
              <Image src={playerShows} alt="Mydia Player shows library" width={480} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="absolute -inset-4 bg-primary/5 rounded-[3rem] -z-10 blur-2xl"></div>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-base-content/15 shadow-2xl shadow-black/60">
        <Image src={playerDesktop} alt="Mydia Player on a desktop, showing the library home screen" width={1600} class="w-full h-auto" loading="lazy" />
      </div>
      <p class="text-sm text-base-content/50 text-center mt-3">Desktop app and web player.</p>
    </div>
  </section>

  <ThemeShowcase
    id="themes"
    heading="Themes"
    subheading="Includes Projection Booth, OLED Black and Slate presets."
    themes={playerThemes}
    aspect="desktop"
  />

  <Platforms />

  <CrossSell
    text="Self-hosting a library? Mydia Server adds automated downloads and peer-to-peer remote streaming."
    href="/server"
    label="Learn about Mydia Server"
  />
</Base>
