---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import ThemeShowcase from '../components/ThemeShowcase.astro';
import Install from '../components/Install.astro';
import CrossSell from '../components/CrossSell.astro';
import { serverThemes, serverThemesHeading } from '../data/themes';

const features = [
  { icon: 'film', title: 'Library and metadata', description: 'Scans your movie and TV directories and fetches posters, descriptions and episode details from TMDB and TVDB.' },
  { icon: 'sparkles', title: 'Automated downloads', description: 'Monitors missing movies and episodes, downloads matching releases, and upgrades files according to your quality profile.' },
  { icon: 'download', title: 'Download clients and indexers', description: 'Connects to qBittorrent, Transmission, SABnzbd, NZBGet, Prowlarr, Jackett and debrid providers.' },
  { icon: 'users', title: 'Multi-user and requests', description: 'Supports admin and guest accounts, a media request approval workflow, and single sign-on.' },
  { icon: 'globe', title: 'Peer-to-peer remote access', description: 'Streams to Mydia Player outside your home network without port forwarding or a VPN.' },
  { icon: 'sliders', title: 'File or UI configuration', description: 'Configure download clients, indexers and libraries in the web UI, a YAML file or environment variables.' },
];
---

<Base
  title="Mydia Server: self-hosted library and download manager"
  description="Mydia Server organizes your movies and TV shows, automates downloads, and streams to Mydia Player over peer-to-peer connections."
>
  <Hero
    badge="Mydia Server"
    title="Self-hosted library and download manager."
    subtitle="Organizes your movies and TV shows, downloads missing releases, and streams directly to Mydia Player."
    primary={{ label: 'Get started', href: '#install' }}
    secondary={{ label: 'Docs', href: 'https://docs.mydia.dev/latest/', external: true }}
    wall={{ height: '34rem' }}
  />

  <Features
    title="What Mydia Server does"
    subtitle="Library management, release monitoring and remote streaming in a single container."
    items={features}
  />

  <Screenshots />

  <ThemeShowcase
    id="themes"
    heading={serverThemesHeading}
    themes={serverThemes}
    aspect="desktop"
  />

  <Install />

  <CrossSell
    text="Use Mydia Player to watch your library on phone, tablet, TV and desktop."
    href="/player"
    label="Learn about Mydia Player"
  />
</Base>
