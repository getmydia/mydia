# VCS
.git
.gitignore

# Build/test outputs
_build
cover
tmp

# Elixir deps/cache from host (always rebuilt in image)
deps
.elixir_ls
.hex
.mix
.nix-mix

# Databases and local runtime state
*.db
*.db-shm
*.db-wal

# Flutter/Dart generated artifacts
player/.dart_tool
player/.pub-cache
player/build
player/android/build
player/.flutter-plugins
player/.flutter-plugins-dependencies
player/.packages

# Rust build artifacts
player/rust/**/target
native/**/target
plugins/**/target

# Built WASM plugin guests — rebuilt from source by the :plugins compiler inside
# the image. Excluding them keeps a stale/local host artifact out of the build
# context so the image always reflects committed source.
priv/plugins/*.wasm

# Locally built Dialyzer PLTs (tens of MB) never belong in the build context.
priv/plts

# Metadata relay local build artifacts
metadata-relay/_build
metadata-relay/deps
metadata-relay/.nix-hex
metadata-relay/.nix-mix

# Misc local artifacts
screenshots
*.log

# The Cardigann wasm guest is never part of the image: opted-in installs
# download it at runtime. Keep local copies out of the build context.
priv/cardigann/*.wasm
priv/cardigann/*.wasm.sha256
priv/cardigann/*.cwasm
priv/cardigann/*.wasm.cwasm
priv/data/cardigann
native/cardigann_guest/out
native/cardigann_guest/obj
native/cardigann_guest/bin
native/cardigann_guest/.prowlarr
native/cardigann_guest/tests/**/bin
native/cardigann_guest/tests/**/obj
native/cardigann_guest/deny/target
