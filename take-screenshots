#!/usr/bin/env bash

# Screenshot helper script for Mydia
# Captures the README and website screenshots using Playwright.
#
# The dev stack is native devenv, not Docker, so this drives the app over HTTP
# rather than shelling into a container. Point BASE_URL at the worktree's
# Phoenix (devenv derives a port per worktree; `./dev ps` and `ss -ltn` show it).
#
# Run it against the demo library, never a real one. On a fresh DB run
# `./dev mix mydia.demo_seed` first: it reads TMDB ids from the untracked
# `.demo-titles.local` (see `mix help mydia.demo_seed`). Use a neutral host so
# the player does not title the server "localhost"; the demo capture is:
#   MAP_HOST_TO_LOOPBACK=1 BASE_URL=http://mydia-demo:4320 ./take-screenshots
# MAP_HOST_TO_LOOPBACK=1 maps a non-IP host to 127.0.0.1 (opt-in).
# Every file is written to screenshots/ and to site/src/assets/screenshots/.

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

BASE_URL="${BASE_URL:-http://localhost:4000}"

echo -e "${GREEN}📸 Mydia Screenshot Tool${NC}\n"
echo -e "Target: ${BASE_URL}\n"

CONNECT_TO=()
if [ "${MAP_HOST_TO_LOOPBACK:-}" = "1" ]; then
    CONNECT_TO=(--connect-to "::127.0.0.1:")
fi

if ! curl -fsS -o /dev/null --max-time 5 ${CONNECT_TO[@]+"${CONNECT_TO[@]}"} "${BASE_URL}/auth/login"; then
    echo -e "${YELLOW}App is not answering at ${BASE_URL}.${NC}"
    echo -e "Start it with ${GREEN}./dev up -d${NC}, then re-run with"
    echo -e "${GREEN}BASE_URL=http://localhost:<port> ./take-screenshots${NC}"
    exit 1
fi

# Playwright's bundled Chromium does not start on NixOS. Fall back to the
# system browser when one is on PATH; elsewhere Playwright's own download wins.
if [ -z "${CHROME_PATH:-}" ] && command -v chromium > /dev/null 2>&1; then
    CHROME_PATH="$(command -v chromium)"
    # Resolve the symlink where the platform can. `readlink -f` is GNU-only,
    # and under `set -e` the BSD/macOS failure would kill the script before
    # Playwright ever starts. Playwright accepts either form.
    if resolved="$(readlink -f "$CHROME_PATH" 2> /dev/null)"; then
        CHROME_PATH="$resolved"
    fi
    export CHROME_PATH
    echo -e "${YELLOW}Using system Chromium: ${CHROME_PATH}${NC}\n"
fi

if [ -z "${CHROME_PATH:-}" ]; then
    echo -e "${GREEN}Installing Playwright Chromium...${NC}\n"
    (cd assets && npx playwright install chromium) || {
        echo -e "${RED}Playwright could not install a browser. Set CHROME_PATH instead.${NC}"
        exit 1
    }
fi

echo -e "${GREEN}Capturing screenshots...${NC}\n"
(cd assets && BASE_URL="$BASE_URL" npm run screenshots)

echo ""
echo -e "${GREEN}✅ Done! Screenshots saved to screenshots/ and site/src/assets/screenshots/${NC}"
echo -e "Website copies are in ${GREEN}site/src/assets/screenshots/${NC}."
