<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Mydia Player ships as a Developer ID app outside the App Store and is
	    deliberately NOT sandboxed: it needs access to user-chosen media and
	    download directories, and enabling the sandbox would relocate app data
	    into ~/Library/Containers.

	    Do not re-add com.apple.security.app-sandbox without also granting a
	    real keychain access group. flutter_secure_storage's data-protection
	    keychain requires one; without it every keychain write fails with
	    errSecMissingEntitlement (-34018) and pairing silently stops persisting.
	    See lib/core/storage/secure_storage_options.dart.
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	    iCloud backup (CloudKitPlugin.swift) and its silent change pushes.
	    The Developer ID provisioning profile must carry iCloud (CloudKit,
	    this container) and Push Notifications; see docs/packaging.md.
	-->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<!-- Developer ID builds have no App Store step to pick the environment. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.mydia.player</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
