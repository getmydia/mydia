// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Mydia Player

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = dev.mydia.player

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2025 Mydia Player. All rights reserved.

// iCloud backup, off unless the git-ignored CloudKit.xcconfig next to this
// file sets MYDIA_CLOUDKIT = YES; see docs/packaging.md. Off, the app is
// signed with DebugProfile/Release.entitlements (no iCloud, no push) and
// hides iCloud; on, with their *CloudKit variants.
MYDIA_CLOUDKIT = NO
#include? "CloudKit.xcconfig"
MYDIA_CLOUDKIT_SUFFIX_YES = CloudKit
MYDIA_CLOUDKIT_SUFFIX_NO =
