require_relative "release_metadata"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :testflight do
    setup_ci if ENV['CI']

    # Install the App Store Connect API key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Build the iOS app
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "Mydia Player.ipa"
    )

    # Upload to TestFlight and distribute to the external groups the workflow
    # named. External distribution requires the build to finish processing, so
    # we can't skip waiting here. The first build of each new version goes
    # through Apple's Beta App Review; that is per version, not per group, so
    # routing a stable release to a second group does not trigger another one.
    #
    # notify_external_testers is what releases an approved build to external
    # testers, and the email comes with it. Set to false, every build waits at
    # "Approved" for a manual "Notify Testers" click in App Store Connect, and
    # once the last released build expires the public links refuse new testers
    # (#746). scripts/check-ios-fastlane-metadata.sh asserts this stays wired
    # to distribute_ext.
    distribute_ext = testflight_distribute_external?

    upload_to_testflight(
      distribute_external: distribute_ext,
      groups: distribute_ext ? testflight_groups : nil,
      changelog: testflight_changelog,
      notify_external_testers: distribute_ext
    )
  end

  desc "Write the highest build number ever uploaded to HIGHEST_BUILD_NUMBER_PATH"
  lane :highest_build_number do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Every build of every marketing version, in every processing state:
    # App Store Connect's "must be higher" check counts all of them, and a
    # failed or still-processing upload still holds its number.
    # latest_testflight_build_number is not used because it reports the most
    # recent upload, which is not necessarily the highest.
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("No App Store Connect app for #{bundle_id}") unless app

    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 200)
    highest = max_build_number(builds.map(&:version))
    UI.user_error!("App Store Connect lists no builds for #{bundle_id}") unless highest

    UI.message("Highest uploaded build number: #{highest} (of #{builds.length} builds)")
    File.write(ENV.fetch("HIGHEST_BUILD_NUMBER_PATH"), highest)
  end

  desc "Build and upload to App Store (requires manual review)"
  lane :release do
    setup_ci if ENV['CI']

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "Mydia Player.ipa"
    )

    # Upload to App Store Connect for review
    upload_to_app_store(
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Build IPA only (no upload)"
  lane :build_only do
    setup_ci if ENV['CI']

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "Mydia Player.ipa"
    )
  end
end
