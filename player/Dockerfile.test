# syntax=docker/dockerfile:1.4
# ============================================
# E2E Test Runner - Flutter Integration Tests
# ============================================
# This Dockerfile runs Flutter integration tests on native Linux
# so tests exercise the same iroh P2P code path used by real devices.
#
# NOTE: This Dockerfile expects the build context to be the project root
# (not the player directory) so it can access player/pubspec.yaml and
# player/pubspec.lock below. player/lib/graphql/schema.graphql resolves at
# runtime through its real symlink once compose bind-mounts the repo root.
#
# Build with: DOCKER_BUILDKIT=1 docker build -f player/Dockerfile.test .
#
# Environment variables required:
# - MYDIA_URL: URL of the Mydia server (for API calls)
# - RELAY_URL: URL of the metadata-relay service

# The SDK comes from player/.fvmrc, the pin every other build reads, so this
# image always matches the SDK pubspec.lock was resolved on and run-tests.sh
# can pass --enforce-lockfile. It used to build on cirruslabs' floating
# stable image, which stopped following releases and left E2E on an SDK
# nothing else used.
#
# Never write a version number in these comments: ci-nix.yml's "Check /
# Flutter Pin" job fails on any line that names Flutter next to one.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Set pub cache location for caching
ENV PUB_CACHE=/root/.pub-cache
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH="/root/.cargo/bin:${PATH}"

# Linux desktop build dependencies, plus what the SDK itself shells out to
# (git, curl, unzip, xz-utils, zip) and what xvfb-run needs (xauth). The Mesa
# DRI, EGL and GLES packages give Impeller a software GL under Xvfb.
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        jq \
        unzip \
        xz-utils \
        zip \
        xauth \
        xvfb \
        clang \
        cmake \
        ninja-build \
        pkg-config \
        libgtk-3-dev \
        libblkid-dev \
        liblzma-dev \
        libstdc++-12-dev \
        libsecret-1-dev \
        libjsoncpp-dev \
        libmpv-dev \
        libx11-dev \
        libx11-xcb-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxi-dev \
        libgl1-mesa-dev \
        libgl1-mesa-dri \
        libegl1 \
        libgles2 \
        libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain is required for building the mydia_player_p2p plugin. This
# installs rustup itself with a throwaway stable default; the toolchain
# actually used at test time is pinned below.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain stable

# Bake the pinned toolchain from rust-toolchain.toml (channel 1.96.0, plus the
# wasm32-wasip2 target) into the image instead of leaving it to be resolved at
# runtime. Once compose bind-mounts the repo root over /workspace,
# rust-toolchain.toml sits above every cargo invocation under it, so without
# this rustup would install 1.96.0 (and a wasm target the player never uses)
# from scratch into a layer that gets discarded, on every single run.
WORKDIR /workspace
COPY rust-toolchain.toml ./
RUN rustup toolchain install

# Same install as the root Dockerfile's flutter-builder stage: a tagged git
# checkout, whose first run fetches the matching Dart SDK. Keyed on .fvmrc
# alone, so the SDK is re-fetched only when the pin moves. precache --linux
# warms the desktop engine artifacts here instead of on every test run.
COPY player/.fvmrc /tmp/.fvmrc
RUN FLUTTER_VERSION="$(jq -r .flutter /tmp/.fvmrc)" && \
    git clone --depth 1 --branch "$FLUTTER_VERSION" \
      https://github.com/flutter/flutter.git /opt/flutter && \
    git config --global --add safe.directory /opt/flutter && \
    /opt/flutter/bin/flutter config --no-analytics && \
    /opt/flutter/bin/flutter precache --linux

ENV PATH="/opt/flutter/bin:${PATH}"

RUN flutter config --enable-linux-desktop

# Warm the pub cache using dependency manifests alone, so the expensive layer
# is keyed on pubspec.lock and not on player source. Source is bind-mounted at
# runtime by compose, which is why nothing else is copied here.
WORKDIR /warm
COPY player/pubspec.yaml player/pubspec.lock ./
# This is expected to fail: mydia_player_p2p is a path dependency
# (rust_builder/), and only the pubspec files are present here, not the
# package itself, so pub cannot resolve it. `|| true` masks only that
# anticipated failure. The network fetch of every hosted (pub.dev)
# dependency still happens and populates /root/.pub-cache before the
# resolver gives up, which is the entire point of this layer.
RUN flutter pub get || true

# jq is used by scripts/e2e/run-tests.sh to parse GraphQL responses.
WORKDIR /workspace/player
