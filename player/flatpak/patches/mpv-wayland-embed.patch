+/* Embedding: when mpv renders into a host's surface it shares the host's
+ * display connection, so every dispatch must stay on mpv's own queue or it
+ * would run the host toolkit's event handlers on mpv's thread. */
+static int wl_roundtrip(struct vo_wayland_state *wl)
+{
+    return wl->embedded ? wl_display_roundtrip_queue(wl->display, wl->embed_queue)
+                        : wl_display_roundtrip(wl->display);
+}
+
+static int wl_dispatch_pending(struct vo_wayland_state *wl)
+{
+    return wl->embedded ? wl_display_dispatch_queue_pending(wl->display, wl->embed_queue)
+                        : wl_display_dispatch_pending(wl->display);
+}
+
+static int wl_dispatch(struct vo_wayland_state *wl)
+{
+    return wl->embedded ? wl_display_dispatch_queue(wl->display, wl->embed_queue)
+                        : wl_display_dispatch(wl->display);
+}
+
+static int wl_prepare_read(struct vo_wayland_state *wl)
+{
+    return wl->embedded ? wl_display_prepare_read_queue(wl->display, wl->embed_queue)
+                        : wl_display_prepare_read(wl->display);
+}
