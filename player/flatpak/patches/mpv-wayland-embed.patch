+/* What --wid points at when mpv renders into a host application's surface.
+ * The host owns the display connection and the surface (normally a
+ * subsurface of its own window); mpv uses them on a private event queue and
+ * creates no window, input or decorations of its own. */
+#define MPV_WAYLAND_EMBED_MAGIC 0x6d707665u /* "mpve" */
+struct mpv_wayland_embed {
+    uint32_t magic;
+    struct wl_display *display;
+    struct wl_surface *surface;
+};
