# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Local Hex/Mix cache directories
/.hex/
/.mix/

# Nix development environment cache directories
/.nix-hex/
/.nix-mix/
**/.nix-mix/
**/.nix-hex/

# Nix build result symlink
/result

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
mydia-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Flutter player web build output (built via CI/CD)
/priv/static/player/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Ignore Phoenix digest artifacts (fingerprinted and gzipped files)
/priv/static/**/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*
/priv/static/**/*.gz

# macOS
.DS_Store

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/
/test/mock_services/*/node_modules/

# Playwright E2E test results
/assets/e2e-results/
/assets/test-results/

# Database files
*.db
*.db-*
/priv/repo/structure.sql

# Docker Compose override files (personal dev environment customization)
compose.override.yml

# Environment files with secrets
.env
.env.prod

# User hooks (but keep examples and README)
/hooks/**
!/hooks/README.md
!/hooks/after_media_added/
!/hooks/after_media_added/01_example_anime_settings.lua

# Backlog.md task management (managed via MCP)
/backlog/

# Generated media (covers, sprites, VTT files)
/priv/generated/

# MkDocs build output
/_site/

# Metadata relay logs
/metadata-relay/logs/

# Python virtual environment
.venv/
docs/.venv/

# Rust build artifacts
**/target/

# Compiled Rust NIFs (built by Rustler during compilation)
/priv/native/

# Compiled WASM plugin guests (built by the :plugins mix compiler during
# compilation). The manifests (priv/plugins/*.json) stay tracked; only the
# build-produced .wasm is ignored — source under plugins/*/ is the truth.
/priv/plugins/*.wasm

# Cookie jars (from HTTP clients)
cookie.jar

# Playwright MCP
.playwright-mcp/

# Terraform
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc


.claude/worktrees/
.opencode/
.worktrees
/.devenv/

# devenv / direnv (per-worktree dev environment)
/.direnv/
# Per-worktree port/config override (see devenv.local.nix.example)
devenv.local.nix
devenv.local.yaml
# Generated by devenv's git-hooks integration — devenv.nix is the source of truth
/.pre-commit-config.yaml

# Superpowers planning artifacts (specs/plans) — local only, never tracked
docs/superpowers/
