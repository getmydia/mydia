diff --git a/internal/vpn/splittunnel.go b/internal/vpn/splittunnel.go
new file mode 100644
index 0000000..e815846
--- /dev/null
+++ b/internal/vpn/splittunnel.go
@@ -0,0 +1,49 @@
+package vpn
+
+import (
+	"fmt"
+
+	"github.com/qdm12/gluetun/internal/netlink"
+	"github.com/qdm12/gluetun/internal/splittunnel"
+)
+
+// addOpenVPNSplitRouting adds the split tunnel ip rule and unreachable
+// fallback for OpenVPN. The tunnel routes join them on each tunnel up, see
+// moveOpenVPNRoutes. Wireguard does the same inside its own setup.
+func (l *Loop) addOpenVPNSplitRouting() (cleanup func(), err error) {
+	families := []int{netlink.FamilyV4}
+	if l.ipv6Supported {
+		families = append(families, netlink.FamilyV6)
+	}
+
+	var cleanups []func() error
+	cleanup = func() {
+		for _, removeFamily := range cleanups {
+			if err := removeFamily(); err != nil {
+				l.logger.Error("removing split tunnel routing: " + err.Error())
+			}
+		}
+	}
+
+	for _, family := range families {
+		familyCleanup, err := splittunnel.AddPolicyRouting(l.netLinker, splittunnel.Table, family)
+		if err != nil {
+			cleanup()
+			return nil, fmt.Errorf("adding split tunnel routing: %w", err)
+		}
+		cleanups = append(cleanups, familyCleanup)
+	}
+	return cleanup, nil
+}
+
+// moveOpenVPNRoutes moves the routes OpenVPN added for redirect-gateway out
+// of the main table into the split tunnel table, so only marked traffic uses
+// the tunnel. Until it runs, the whole container routes through the tunnel,
+// which leaks nothing. If it fails, marked traffic meets the unreachable
+// route and the health check restarts the VPN.
+func (l *Loop) moveOpenVPNRoutes(vpnInterface string) {
+	err := splittunnel.MoveTunnelRoutes(l.netLinker, vpnInterface, splittunnel.Table)
+	if err != nil {
+		l.logger.Error("moving OpenVPN routes to the split tunnel table: " + err.Error())
+	}
+}
