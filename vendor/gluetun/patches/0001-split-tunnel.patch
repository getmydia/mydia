diff --git a/internal/firewall/splittunnel.go b/internal/firewall/splittunnel.go
new file mode 100644
index 0000000..c7dfe7d
--- /dev/null
+++ b/internal/firewall/splittunnel.go
@@ -0,0 +1,235 @@
+package firewall
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"os/exec"
+	"strings"
+
+	"github.com/qdm12/gluetun/internal/models"
+	"github.com/qdm12/gluetun/internal/netlink"
+	"github.com/qdm12/gluetun/internal/splittunnel"
+)
+
+// SetSplitTunnel switches the firewall to split tunnel mode for the given
+// group ID. It must be called before SetEnabled. In this mode the chain
+// policies stay ACCEPT and only marked traffic is filtered, see the
+// splittunnel package.
+func (c *Config) SetSplitTunnel(gid uint32) {
+	c.stateMutex.Lock()
+	defer c.stateMutex.Unlock()
+	c.splitTunnel = &splittunnel.Settings{
+		GID:     gid,
+		Mark:    splittunnel.Mark,
+		DNSPort: splittunnel.DNSPort,
+	}
+}
+
+// splitTunnelSettings returns the split tunnel settings for the current VPN
+// connection. It must be called with the state mutex held.
+func (c *Config) splitTunnelSettings() splittunnel.Settings {
+	settings := *c.splitTunnel
+	settings.Interface = c.vpnIntf
+	settings.Endpoint = netip.AddrPortFrom(c.vpnConnection.IP, c.vpnConnection.Port)
+	settings.Protocol = c.vpnConnection.Protocol
+	return settings
+}
+
+func (c *Config) enableSplitTunnel(ctx context.Context) (err error) {
+	settings := c.splitTunnelSettings()
+
+	if c.ip6Tables == "" {
+		for _, defaultRoute := range c.defaultRoutes {
+			if defaultRoute.Family == netlink.FamilyV6 {
+				c.logger.Error("ip6tables is not available: split tunnel IPv6 traffic " +
+					"is neither marked nor kill-switched and leaves through " +
+					defaultRoute.NetInterface + " outside the VPN")
+				break
+			}
+		}
+	}
+
+	// Gluetun can be restarted inside a network namespace that still holds
+	// the rules of its previous run, while the engine keeps running. Each
+	// rule is added before its duplicate from the previous run is removed,
+	// so marking and the kill switch never lapse.
+	const replace = true
+	err = c.runSplitTunnelInstructions(ctx, settings.BaseInstructions(false, false),
+		settings.BaseInstructions(true, false), replace)
+	if err != nil {
+		return fmt.Errorf("adding split tunnel rules: %w", err)
+	}
+
+	err = c.runSplitTunnelInstructions(ctx, settings.TunnelInstructions(false, false),
+		settings.TunnelInstructions(true, false), replace)
+	if err != nil {
+		return fmt.Errorf("adding split tunnel VPN rules: %w", err)
+	}
+
+	for port, netInterfaces := range c.allowedInputPorts {
+		for netInterface := range netInterfaces {
+			const remove = false
+			err = c.splitTunnelInboundPort(ctx, netInterface, port, remove)
+			if err != nil {
+				return fmt.Errorf("accepting input port %d on interface %s: %w",
+					port, netInterface, err)
+			}
+		}
+	}
+
+	const remove = false
+	err = c.redirectPorts(ctx, remove)
+	if err != nil {
+		return fmt.Errorf("redirecting ports: %w", err)
+	}
+
+	err = c.runUserPostRules(ctx, c.customRulesPath, remove)
+	if err != nil {
+		return fmt.Errorf("running user defined post firewall rules: %w", err)
+	}
+
+	return nil
+}
+
+// disableSplitTunnel removes the mangle and nat rules, which the filter
+// table flush in disable does not reach.
+func (c *Config) disableSplitTunnel(ctx context.Context) {
+	settings := c.splitTunnelSettings()
+	c.removeSplitTunnelInstructions(ctx, settings.TunnelInstructions)
+	c.removeSplitTunnelInstructions(ctx, settings.BaseInstructions)
+}
+
+// setSplitTunnelVPNConnection moves the tunnel rules to a new VPN connection.
+// It must be called with the state mutex held.
+func (c *Config) setSplitTunnelVPNConnection(ctx context.Context,
+	connection models.Connection, vpnIntf string,
+) (err error) {
+	previous := c.splitTunnelSettings()
+	c.vpnConnection = connection
+	c.vpnIntf = vpnIntf
+	if !c.enabled {
+		c.logger.Info("firewall disabled, only updating internal VPN connection")
+		return nil
+	}
+
+	c.logger.Info("allowing VPN connection for split tunnel traffic...")
+	next := c.splitTunnelSettings()
+	// The first connection of this process diffs against no rules, but the
+	// namespace may still hold the tunnel rules of a previous run: replace
+	// them like the base rules instead of appending a second copy.
+	replace := previous.Interface == ""
+	return c.runSplitTunnelInstructions(ctx,
+		splittunnel.TunnelChanges(previous, next, false),
+		splittunnel.TunnelChanges(previous, next, true), replace)
+}
+
+func (c *Config) splitTunnelInboundPort(ctx context.Context, intf string,
+	port uint16, remove bool,
+) error {
+	settings := splittunnel.Settings{Interface: intf}
+	if remove {
+		c.removeSplitTunnelInstructions(ctx, func(_, _ bool) []string {
+			return settings.InboundPortInstructions(port, true)
+		})
+		return nil
+	}
+	instructions := settings.InboundPortInstructions(port, false)
+	const replace = false
+	return c.runSplitTunnelInstructions(ctx, instructions, instructions, replace)
+}
+
+// runSplitTunnelInstructions runs the IPv4 instructions with iptables and
+// the IPv6 ones with ip6tables, when it is available. A missing IPv6 nat
+// table only loses MASQUERADE, so marked IPv6 traffic keeps the wrong source
+// address and fails rather than leaks: it is logged instead of failing.
+//
+// With replace, rules that already exist (checked with -C) are added again
+// and only then is one copy removed, so an existing rule is never missing.
+// Nothing is removed on failure: rules already in place stay, failing closed.
+func (c *Config) runSplitTunnelInstructions(ctx context.Context,
+	ipv4, ipv6 []string, replace bool,
+) error {
+	err := c.runSplitTunnelFamily(ctx, c.ipTables, ipv4, replace)
+	if err != nil || c.ip6Tables == "" {
+		return err
+	}
+	return c.runSplitTunnelFamily(ctx, c.ip6Tables, ipv6, replace)
+}
+
+func (c *Config) runSplitTunnelFamily(ctx context.Context,
+	iptablesBinary string, instructions []string, replace bool,
+) error {
+	var duplicates []string
+	if replace {
+		for _, instruction := range instructions {
+			check := splittunnel.WithOperation(instruction, "-C")
+			if c.runSplitTunnelInstruction(ctx, iptablesBinary, check) == nil {
+				duplicates = append(duplicates, splittunnel.WithOperation(instruction, "-D"))
+			}
+		}
+	}
+
+	for _, instruction := range instructions {
+		err := c.runSplitTunnelInstruction(ctx, iptablesBinary, instruction)
+		switch {
+		case err == nil:
+		case iptablesBinary == c.ip6Tables && strings.HasPrefix(instruction, "-t nat ") &&
+			strings.Contains(err.Error(), "Table does not exist"):
+			c.logger.Warn("IPv6 split tunnel NAT disabled because your kernel " +
+				"does not support IPv6 NAT: " + err.Error())
+		default:
+			return err
+		}
+	}
+
+	// -D removes the first match: the previous run's copy of an appended
+	// rule, or the new copy of an inserted one. Either way one copy stays.
+	for _, duplicate := range duplicates {
+		if err := c.runSplitTunnelInstruction(ctx, iptablesBinary, duplicate); err != nil {
+			c.logger.Debug("removing duplicate split tunnel rule: " + err.Error())
+		}
+	}
+	return nil
+}
+
+// removeSplitTunnelInstructions removes rules that may not exist, so
+// failures are only logged at the debug level.
+func (c *Config) removeSplitTunnelInstructions(ctx context.Context,
+	instructions func(ipv6, remove bool) []string,
+) {
+	const remove = true
+	for _, instruction := range instructions(false, remove) {
+		if err := c.runSplitTunnelInstruction(ctx, c.ipTables, instruction); err != nil {
+			c.logger.Debug("removing split tunnel rule: " + err.Error())
+		}
+	}
+	if c.ip6Tables == "" {
+		return
+	}
+	for _, instruction := range instructions(true, remove) {
+		if err := c.runSplitTunnelInstruction(ctx, c.ip6Tables, instruction); err != nil {
+			c.logger.Debug("removing split tunnel rule: " + err.Error())
+		}
+	}
+}
+
+// runSplitTunnelInstruction runs the instruction as is. Unlike
+// runIptablesInstruction, it deletes by rule specification: the line number
+// lookup parses chain listings and does not know the owner, mark, MARK,
+// DNAT and MASQUERADE options these rules use.
+func (c *Config) runSplitTunnelInstruction(ctx context.Context,
+	iptablesBinary, instruction string,
+) error {
+	c.iptablesMutex.Lock()
+	defer c.iptablesMutex.Unlock()
+
+	flags := strings.Fields(instruction)
+	cmd := exec.CommandContext(ctx, iptablesBinary, flags...) // #nosec G204
+	c.logger.Debug(cmd.String())
+	if output, err := c.runner.Run(cmd); err != nil {
+		return fmt.Errorf("command failed: \"%s %s\": %s: %w",
+			iptablesBinary, instruction, output, err)
+	}
+	return nil
+}
diff --git a/internal/firewall/splittunnel_test.go b/internal/firewall/splittunnel_test.go
new file mode 100644
index 0000000..ef86f4b
--- /dev/null
+++ b/internal/firewall/splittunnel_test.go
@@ -0,0 +1,219 @@
+package firewall
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/qdm12/gluetun/internal/models"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var errTestCommand = errors.New("test command failure")
+
+// recordingRunner records commands. Check commands (-C) fail unless
+// rulesExist, as iptables does for a missing rule, and commands containing
+// failOn fail.
+type recordingRunner struct {
+	commands   []string
+	rulesExist bool
+	failOn     string
+}
+
+func (r *recordingRunner) Run(cmd *exec.Cmd) (string, error) {
+	command := strings.Join(cmd.Args, " ")
+	r.commands = append(r.commands, command)
+	switch {
+	case slices.Contains(cmd.Args, "-C") && !r.rulesExist:
+		return "iptables: Bad rule (does a matching rule exist in that chain?).", errTestCommand
+	case r.failOn != "" && strings.Contains(command, r.failOn):
+		return "", errTestCommand
+	}
+	return "", nil
+}
+
+type discardLogger struct{}
+
+func (discardLogger) Debug(string) {}
+func (discardLogger) Info(string)  {}
+func (discardLogger) Warn(string)  {}
+func (discardLogger) Error(string) {}
+
+func newSplitTunnelConfig(runner CmdRunner) *Config {
+	config := &Config{
+		runner:            runner,
+		logger:            discardLogger{},
+		ipTables:          "iptables",
+		ip6Tables:         "ip6tables",
+		customRulesPath:   "/nonexistent/post-rules.txt",
+		allowedInputPorts: make(map[uint16]map[string]struct{}),
+	}
+	config.SetSplitTunnel(1500)
+	return config
+}
+
+func killSwitchRules() []string {
+	return []string{
+		"iptables -t mangle -A OUTPUT -m connmark --mark 0x5154 -j MARK --set-mark 0x5154",
+		"iptables -t mangle -A OUTPUT -m owner --gid-owner 1500 -j MARK --set-mark 0x5154",
+		"iptables -A OUTPUT -m mark --mark 0x5154 -j DROP",
+		"ip6tables -t mangle -A OUTPUT -m owner --gid-owner 1500 -j MARK --set-mark 0x5154",
+		"ip6tables -A OUTPUT -m mark --mark 0x5154 -j DROP",
+	}
+}
+
+func deleteOf(command string) string {
+	return strings.Replace(command, " -A ", " -D ", 1)
+}
+
+func Test_splitTunnel_enableFresh(t *testing.T) {
+	t.Parallel()
+	runner := &recordingRunner{}
+	require.NoError(t, newSplitTunnelConfig(runner).SetEnabled(context.Background(), true))
+	for _, command := range runner.commands {
+		assert.NotContains(t, command, " -D ", "nothing to replace on a fresh namespace")
+	}
+}
+
+// Gluetun restarts in a loop while the engine may keep running: the rules of
+// the previous run must stay until their replacements exist.
+func Test_splitTunnel_enableOverPreviousRun(t *testing.T) {
+	t.Parallel()
+	runner := &recordingRunner{rulesExist: true}
+	require.NoError(t, newSplitTunnelConfig(runner).SetEnabled(context.Background(), true))
+	for _, rule := range killSwitchRules() {
+		added := slices.Index(runner.commands, rule)
+		deleted := slices.Index(runner.commands, deleteOf(rule))
+		require.GreaterOrEqual(t, added, 0, "missing %q", rule)
+		require.GreaterOrEqual(t, deleted, 0, "duplicate of %q not removed", rule)
+		assert.Less(t, added, deleted, "%q removed before its replacement exists", rule)
+		assert.Equal(t, 1, strings.Count(strings.Join(runner.commands, "\n"), deleteOf(rule)+"\n"),
+			"exactly one duplicate of %q removed", rule)
+	}
+}
+
+// The first VPN connection after a gluetun restart finds the tunnel rules of
+// the previous run: they are replaced, not appended a second time.
+func Test_splitTunnel_firstConnectionOverPreviousRun(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	runner := &recordingRunner{rulesExist: true}
+	config := newSplitTunnelConfig(runner)
+	require.NoError(t, config.SetEnabled(ctx, true))
+
+	runner.commands = nil
+	connection := models.Connection{
+		IP:       netip.MustParseAddr("192.0.2.10"),
+		Port:     51820,
+		Protocol: "udp",
+	}
+	require.NoError(t, config.SetVPNConnection(ctx, connection, "wg0"))
+
+	tunnelRules := []string{
+		"iptables -t mangle -I OUTPUT -d 192.0.2.10 -p udp --dport 51820 -j RETURN",
+		"iptables -t mangle -A PREROUTING -i wg0 -j MARK --set-mark 0x5154",
+		"iptables -t mangle -A PREROUTING -i wg0 -j CONNMARK --set-mark 0x5154",
+		"iptables -I OUTPUT -m mark --mark 0x5154 -o wg0 -j ACCEPT",
+		"iptables -A INPUT -i wg0 -j DROP",
+		"iptables -t nat -A POSTROUTING -m mark --mark 0x5154 -o wg0 -j MASQUERADE",
+	}
+	all := strings.Join(runner.commands, "\n") + "\n"
+	for _, rule := range tunnelRules {
+		deleted := strings.Replace(strings.Replace(rule, " -A ", " -D ", 1), " -I ", " -D ", 1)
+		added := slices.Index(runner.commands, rule)
+		removed := slices.Index(runner.commands, deleted)
+		require.GreaterOrEqual(t, added, 0, "missing %q", rule)
+		require.GreaterOrEqual(t, removed, 0, "duplicate of %q not removed", rule)
+		assert.Less(t, added, removed, "%q removed before its replacement exists", rule)
+		assert.Equal(t, 1, strings.Count(all, deleted+"\n"), "exactly one duplicate of %q removed", rule)
+	}
+
+	// Later connections in the same run diff against known rules.
+	runner.commands = nil
+	connection.IP = netip.MustParseAddr("192.0.2.20")
+	require.NoError(t, config.SetVPNConnection(ctx, connection, "wg0"))
+	assert.Equal(t, []string{
+		"iptables -t mangle -I OUTPUT -d 192.0.2.20 -p udp --dport 51820 -j RETURN",
+		"iptables -t mangle -D OUTPUT -d 192.0.2.10 -p udp --dport 51820 -j RETURN",
+	}, runner.commands)
+}
+
+// A partial enable failure must fail closed: the rules already in place stay.
+func Test_splitTunnel_enableFailureKeepsKillSwitch(t *testing.T) {
+	t.Parallel()
+	runner := &recordingRunner{failOn: "MASQUERADE"}
+	config := newSplitTunnelConfig(runner)
+	config.vpnIntf = "wg0"
+	require.Error(t, config.SetEnabled(context.Background(), true))
+	for _, rule := range killSwitchRules() {
+		assert.NotContains(t, runner.commands, deleteOf(rule))
+	}
+}
+
+func Test_splitTunnel(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	runner := &recordingRunner{}
+	config := newSplitTunnelConfig(runner)
+
+	require.NoError(t, config.SetEnabled(ctx, true))
+	for _, command := range runner.commands {
+		assert.NotContains(t, command, "--policy", "split tunnel mode must keep the chain policies")
+	}
+	assert.Contains(t, runner.commands,
+		"iptables -t mangle -A OUTPUT -m owner --gid-owner 1500 -j MARK --set-mark 0x5154")
+	assert.Contains(t, runner.commands,
+		"ip6tables -A OUTPUT -m mark --mark 0x5154 -j DROP")
+	assert.NotContains(t, strings.Join(runner.commands, "\n"), "tun0",
+		"no tunnel rules before the first VPN connection")
+
+	runner.commands = nil
+	connection := models.Connection{
+		IP:       netip.MustParseAddr("192.0.2.10"),
+		Port:     51820,
+		Protocol: "udp",
+	}
+	require.NoError(t, config.SetVPNConnection(ctx, connection, "wg0"))
+	assert.Contains(t, runner.commands,
+		"iptables -t mangle -I OUTPUT -d 192.0.2.10 -p udp --dport 51820 -j RETURN")
+	assert.Contains(t, runner.commands, "iptables -I OUTPUT -m mark --mark 0x5154 -o wg0 -j ACCEPT")
+	assert.Contains(t, runner.commands, "ip6tables -A INPUT -i wg0 -j DROP")
+
+	runner.commands = nil
+	require.NoError(t, config.SetAllowedPort(ctx, 40123, "wg0"))
+	assert.Equal(t, []string{
+		"iptables -I INPUT -i wg0 -p tcp --dport 40123 -j ACCEPT",
+		"iptables -I INPUT -i wg0 -p udp --dport 40123 -j ACCEPT",
+		"ip6tables -I INPUT -i wg0 -p tcp --dport 40123 -j ACCEPT",
+		"ip6tables -I INPUT -i wg0 -p udp --dport 40123 -j ACCEPT",
+	}, runner.commands)
+
+	runner.commands = nil
+	require.NoError(t, config.RemoveAllowedPort(ctx, 40123))
+	assert.Equal(t, []string{
+		"iptables -D INPUT -i wg0 -p tcp --dport 40123 -j ACCEPT",
+		"iptables -D INPUT -i wg0 -p udp --dport 40123 -j ACCEPT",
+		"ip6tables -D INPUT -i wg0 -p tcp --dport 40123 -j ACCEPT",
+		"ip6tables -D INPUT -i wg0 -p udp --dport 40123 -j ACCEPT",
+	}, runner.commands)
+
+	runner.commands = nil
+	connection.IP = netip.MustParseAddr("192.0.2.20")
+	require.NoError(t, config.SetVPNConnection(ctx, connection, "wg0"))
+	assert.Equal(t, []string{
+		"iptables -t mangle -I OUTPUT -d 192.0.2.20 -p udp --dport 51820 -j RETURN",
+		"iptables -t mangle -D OUTPUT -d 192.0.2.10 -p udp --dport 51820 -j RETURN",
+	}, runner.commands, "a new server only swaps the endpoint exemption")
+
+	runner.commands = nil
+	require.NoError(t, config.SetEnabled(ctx, false))
+	assert.Contains(t, runner.commands,
+		"iptables -t mangle -D OUTPUT -m owner --gid-owner 1500 -j MARK --set-mark 0x5154")
+	assert.Contains(t, runner.commands,
+		"iptables -t nat -D POSTROUTING -m mark --mark 0x5154 -o wg0 -j MASQUERADE")
+}
