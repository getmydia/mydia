+// ValidateSplitTunnel validates SplitTunnelGID. It is exported because the
+// firewall is set up before the full settings validation runs.
+func (f Firewall) ValidateSplitTunnel() error {
+	// Group 0 would mark every root process sharing the network namespace,
+	// Docker's embedded DNS forwarder among them.
+	if f.SplitTunnelGID != nil && *f.SplitTunnelGID == 0 {
+		return fmt.Errorf("%w: %d", ErrFirewallSplitTunnelRootGroup, *f.SplitTunnelGID)
+	}
 	return nil
