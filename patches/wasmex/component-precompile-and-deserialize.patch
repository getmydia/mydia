+fn parse_component(bytes: &[u8]) -> NifResult<ParsedComponent> {
+    let decoded_wasm = wit_parser::decoding::decode(bytes)
+        .map_err(|e| Error::Term(Box::new(format!("Unable to decode WASM: {e}"))))?;
+    match decoded_wasm {
+        DecodedWasm::WitPackage(_, _) => Err(rustler::Error::RaiseAtom("Only components are supported")),
+        DecodedWasm::Component(resolve, world_id) => Ok(ParsedComponent { world_id, resolve }),
+    }
+}
+
+/// Mydia patch: loads a component serialized by `engine_precompile_component`
+/// by mmapping the file. `component_binary` is the original component, read
+/// only for its WIT shape; it is not compiled.
+#[rustler::nif(name = "component_deserialize_file", schedule = "DirtyCpu")]
+pub fn deserialize_component_file(
+    store_or_caller_resource: ResourceArc<ComponentStoreResource>,
+    path: String,
+    component_binary: Binary,
+) -> NifResult<ResourceArc<ComponentResource>> {
+    let executor = store_or_caller_resource.executor()?;
+    let parsed_component = parse_component(component_binary.as_slice())?;
+    // SAFETY: the caller promises the file was produced by precompile with a compatible engine config.
+    let component = unsafe { Component::deserialize_file(executor.engine(), &path) }
+        .map_err(|err| rustler::Error::Term(Box::new(err.to_string())))?;
+
+    Ok(ResourceArc::new(ComponentResource {
+        inner: Mutex::new(component),
+        parsed: Arc::new(parsed_component),
+    }))
+}
