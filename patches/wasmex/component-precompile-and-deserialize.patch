+/// Mydia patch: asks glibc to return freed heap pages to the OS. Compiling a
+/// large component leaves the process holding about a GB of freed arena memory.
+#[rustler::nif(name = "malloc_trim")]
+pub fn malloc_trim() -> bool {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    {
+        unsafe { libc::malloc_trim(0) != 0 }
+    }
+    #[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+    {
+        false
+    }
+}
+
+/// Mydia patch: AOT-compiles a component and writes the serialized artifact to `out_path`.
+#[rustler::nif(name = "engine_precompile_component_to_file", schedule = "DirtyCpu")]
+pub fn precompile_component_to_file(
+    engine_resource: ResourceArc<EngineResource>,
+    binary: Binary,
+    out_path: String,
+) -> Result<rustler::Atom, rustler::Error> {
+    let engine: Engine = engine_resource
+        .inner
+        .lock()
+        .map_err(|e| rustler::Error::Term(Box::new(format!("Could not unlock engine resource: {e}"))))?
+        .clone();
+    let serialized = engine
+        .precompile_component(binary.as_slice())
+        .map_err(|err| rustler::Error::Term(Box::new(format!("Could not precompile component: {err}"))))?;
+    std::fs::write(&out_path, &serialized)
+        .map_err(|err| rustler::Error::Term(Box::new(format!("Could not write {out_path}: {err}"))))?;
+    Ok(rustler::types::atom::ok())
+}
