# Mix dependencies for the test env, from deps.nix.
#
#   mixDepsSrc        the deps/ tree: every deps.nix package's Hex source at
#                     deps/<name>, deps/heroicons/optimized, and the
#                     mix.exs @dep_patches applied with `patch -p1`.
#   mixDepsCompiled   deps/ plus _build/test/lib/<dep> from
#                     `MIX_ENV=test mix deps.compile`, offline. Exposed as
#                     ciInternal.mixDepsCompiled-{sqlite,postgres}, because
#                     config/config.exs and config/test.exs read
#                     DATABASE_TYPE at compile time.
#
# Both are built at /build/source (the unpacked mixProject file set), and
# Mix records absolute paths in the deps' build manifests, so consumers copy
# the output into the same layout and compile with --no-deps-check.
#
# deps.nix is generated by mix2nix from mix.lock. A lock change without a
# regenerated deps.nix fails evaluation of `checks` and of these derivations
# with the message scripts/check-generated-freshness.sh points at.
{ ... }:

{
  perSystem = { pkgs, lib, ci, ... }:
    let
      inherit (ci) sources beamPackages rustToolchain;
      root = ../..;

      beamDeps = import ../beam-deps.nix { inherit pkgs beamPackages rustToolchain; };
      inherit (beamDeps) mixNixDeps heroicons lexborPrepare wasmexPrepare;

      # Freshness: every Hex package in mix.lock needs a deps.nix entry of the
      # same version. Same pattern as scripts/check-generated-freshness.sh
      # (one lock entry per line); git deps (heroicons) are not Hex entries
      # and mix2nix skips them.
      lockHex = lib.listToAttrs (lib.concatMap
        (line:
          let
            m = builtins.match
              ''[[:space:]]*"([a-zA-Z0-9_]+)": \{:hex, :[a-zA-Z0-9_]+, "([^"]+)",.*"hexpm", "([^"]+)"}.*''
              line;
          in
          lib.optional (m != null) { name = builtins.elemAt m 0; value = builtins.elemAt m 1; })
        (lib.splitString "\n" (builtins.readFile (root + "/mix.lock"))));

      staleDeps = lib.filter
        (name: !(mixNixDeps ? ${name}) || mixNixDeps.${name}.version != lockHex.${name})
        (builtins.attrNames lockHex);

      assertFresh = lib.throwIf (staleDeps != [ ])
        "deps.nix is stale: run mix2nix > deps.nix (missing: ${lib.concatStringsSep ", " staleDeps})";

      # mix.exs @dep_patches: [{app, version, patch}], the same list
      # `mix deps.patch` applies. A version that no longer matches deps.nix
      # stops here, as patch_dep/1 stops on a fetched version mismatch.
      depPatches =
        let
          mixExs = builtins.replaceStrings [ "\n" ] [ " " ] (builtins.readFile (root + "/mix.exs"));
          block = builtins.match ".*@dep_patches \\[([^]]*)].*" mixExs;
          entries = lib.filter lib.isList
            (builtins.split ''\{:([a-z0-9_]+), "([^"]+)", "([^"]+)"}'' (builtins.head block));
        in
        assert lib.assertMsg (block != null) "nix/ci/mix-deps.nix: no @dep_patches list in mix.exs";
        map
          (e:
            let
              app = builtins.elemAt e 0;
              version = builtins.elemAt e 1;
              have = mixNixDeps.${app}.version or "absent";
            in
            lib.throwIf (have != version)
              "mix.exs @dep_patches targets ${app} ${version}, but deps.nix has ${have}. Rebase the patch and update @dep_patches, or retire it."
              { inherit app; patch = builtins.elemAt e 2; })
          entries;

      patchesSrc = sources.toSource sources.patches;

      # Hex packages only: deps.nix may carry entries mix.lock dropped, and
      # those are harmless in deps/, but the lock is the list Mix resolves.
      hexNames = builtins.attrNames lockHex;

      mixDepsSrc = assertFresh (pkgs.runCommand "mix-deps-src"
        { nativeBuildInputs = [ pkgs.patch ]; }
        ''
          mkdir -p $out
          ${lib.concatMapStrings (name: ''
            cp -r ${mixNixDeps.${name}.src} $out/${name}
          '') hexNames}
          chmod -R u+w $out

          mkdir -p $out/heroicons
          cp -r ${heroicons}/optimized $out/heroicons/

          ${lib.concatMapStrings (p: ''
            echo "patching ${p.app} with ${p.patch}"
            patch -p1 --force -d $out/${p.app} -i ${patchesSrc}/${p.patch}
          '') depPatches}
        '');

      mixDepsCompiled = { databaseType ? null }:
        assertFresh (pkgs.stdenv.mkDerivation {
          pname = "mix-deps-compiled-${if databaseType == null then "sqlite" else databaseType}";
          version = "0";
          src = sources.toSource sources.mixProject;

          nativeBuildInputs = [
            beamPackages.erlang
            beamPackages.elixir
            rustToolchain
            pkgs.cmake
            pkgs.gnumake
          ];
          buildInputs = [ pkgs.sqlite ];

          dontUseCmakeConfigure = true;
          dontConfigure = true;
          # NIFs keep their symbols, as in the package.
          dontStrip = true;

          env = {
            MIX_ENV = "test";
            HEX_OFFLINE = "1";
            MIX_REBAR3 = "${beamPackages.rebar3}/bin/rebar3";
            # Mix needs Hex loaded to resolve the :hex deps; never fetches with
            # HEX_OFFLINE.
            ERL_LIBS = "${beamPackages.hex}/lib/erlang/lib";
            ERL_COMPILER_OPTIONS = "[deterministic]";
            LANG = "C.UTF-8";
            LC_CTYPE = "C.UTF-8";
          } // lib.optionalAttrs (databaseType != null) {
            DATABASE_TYPE = databaseType;
          };

          buildPhase = ''
            runHook preBuild

            export HOME=$TMPDIR/home
            export MIX_HOME=$HOME/.mix HEX_HOME=$HOME/.hex
            mkdir -p $HOME/.cache/elixir_make

            cp -r ${mixDepsSrc} deps
            chmod -R u+w deps

            # lazy_html would `git clone` lexbor; exqlite, argon2 and bcrypt
            # fall back to compiling from source when the precompiled
            # download fails (elixir_make), lazy_html too.
            pushd deps/lazy_html >/dev/null
            ${lexborPrepare}
            popd >/dev/null

            # Wasmex: vendored crates, the patched crate's lock, and
            # WASMEX_BUILD so RustlerPrecompiled compiles instead of
            # downloading.
            pushd deps/wasmex >/dev/null
            ${wasmexPrepare}
            popd >/dev/null

            mix deps.compile

            runHook postBuild
          '';

          installPhase = ''
            runHook preInstall

            # Build intermediates: Wasmex's cargo target dir (1.3G; the NIF is
            # already in deps/wasmex/priv/native) and lazy_html's lexbor
            # tree. `mydia` holds only the compile lock deps.compile left.
            rm -rf deps/wasmex/native/wasmex/target deps/lazy_html/_build \
              _build/test/lib/mydia

            mkdir -p $out/_build/test
            cp -r deps $out/deps
            cp -r _build/test/lib $out/_build/test/lib

            runHook postInstall
          '';
        });
    in
    {
      # Evaluating `checks` (nix flake check, ci-plan's nix-eval-jobs) trips
      # the freshness assertion even before any check needs these deps.
      checks = assertFresh { };

      ciInternal = {
        mixDepsCompiled-sqlite = mixDepsCompiled { };
        mixDepsCompiled-postgres = mixDepsCompiled { databaseType = "postgres"; };
        inherit mixDepsSrc;
      };
    };
}
