apiVersion: v1
kind: Secret
metadata:
  name: metadata-relay-secrets
  namespace: metadata-relay
  labels:
    app.kubernetes.io/name: metadata-relay
    app.kubernetes.io/component: relay-service
type: Opaque
stringData:
  # REQUIRED: Relay token secret for authentication
  # Generate with: openssl rand -hex 32
  RELAY_TOKEN_SECRET: "your-secure-relay-token-secret-here"

  # REQUIRED: API keys for metadata providers
  TMDB_API_KEY: "your-tmdb-api-key"
  TVDB_API_KEY: "your-tvdb-api-key"

  # REQUIRED: Master pepper for rendezvous namespace derivation
  # Generate with: openssl rand -hex 32
  RENDEZVOUS_MASTER_PEPPER: "your-secure-random-pepper-here"

  # REQUIRED when feedback email notifications are enabled.
  # Using Resend SMTP (host/user/port are set in the configmap): this is the
  # Resend API key (re_...). For any other SMTP provider, use its password.
  SMTP_PASSWORD: "your-smtp-password-or-resend-api-key"

  # OPTIONAL: the relay runs fine without this, but every subtitle endpoint
  # returns 503 until it is set. Mydia enables its "Mydia Relay" subtitle
  # provider by default, so without this installs that have not configured
  # their own provider get no subtitle results. Required for subtitle
  # functionality specifically, not for the service to boot.
  SUBDL_API_KEY: "your-subdl-api-key"

---
# Instructions:
# 1. Copy this file to secret.yaml
# 2. Replace all placeholder values with actual secrets
# 3. Apply: kubectl apply -f secret.yaml
# 4. DO NOT commit secret.yaml to version control
# 5. Add secret.yaml to .gitignore
