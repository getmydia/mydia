<!DOCTYPE html>
<html lang="en" {theme_html_attrs(assigns[:theme_selection])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Mydia" suffix=" · Mydia">
      {assigns[:page_title]}
    </.live_title>
    <%!-- PWA Support --%>
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/icons/icon-192.png"} />
    <link rel="mask-icon" href={~p"/images/logo-maskable.svg"} color="#3b82f6" />
    <.theme_color_meta selection={assigns[:theme_selection]} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Mydia" />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/icons/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // Picks the theme before first paint. Fixed modes are already applied
      // by the server; this handles system mode and pages with no user.
      // resolve() mirrors resolveThemeId in assets/js/theme.mjs.
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        if (root.getAttribute('data-theme-source') === 'default') {
          try {
            const m = JSON.parse(localStorage.getItem('mydia-theme') || 'null');
            const id = /^[a-z0-9-]+$/;
            const hex = /^#[0-9a-fA-F]{6}$/;
            if (m && ['system', 'light', 'dark'].includes(m.mode) &&
                id.test(m.light) && id.test(m.dark) &&
                hex.test(m.lightBase) && hex.test(m.darkBase)) {
              root.setAttribute('data-theme-mode', m.mode);
              root.setAttribute('data-light-theme', m.light);
              root.setAttribute('data-dark-theme', m.dark);
              root.setAttribute('data-light-base', m.lightBase);
              root.setAttribute('data-dark-base', m.darkBase);
              // Mirrors written before the roundness setting have no radius.
              if (/^[a-z]+$/.test(m.radius) && m.radius !== 'theme') {
                root.setAttribute('data-radius', m.radius);
              }
            }
          } catch (e) {}
        }

        function resolve() {
          const mode = root.getAttribute('data-theme-mode');
          const dark = mode === 'dark' || (mode !== 'light' && media.matches);
          const slot = dark ? 'dark' : 'light';
          root.setAttribute('data-theme', root.getAttribute('data-' + slot + '-theme'));
          root.setAttribute('data-color-scheme', slot);
          root.style.backgroundColor = root.getAttribute('data-' + slot + '-base');
        }

        if (root.getAttribute('data-theme-source') === 'user') {
          try {
            localStorage.setItem('mydia-theme', JSON.stringify({
              mode: root.getAttribute('data-theme-mode'),
              light: root.getAttribute('data-light-theme'),
              dark: root.getAttribute('data-dark-theme'),
              lightBase: root.getAttribute('data-light-base'),
              darkBase: root.getAttribute('data-dark-base'),
              radius: root.getAttribute('data-radius') || 'theme'
            }));
          } catch (e) {}
        }

        resolve();
        media.addEventListener('change', resolve);
      })();
    </script>
  </head>
  <body class="bg-base-200 text-base-content">
    <%!-- Install sheet. Outside the LiveView container so live navigation never
         remounts it. On iOS Safari it shows once, then remembers the dismissal;
         the account menu's "Install app" reopens it. `manual-chrome` keeps it
         from opening on its own in Chromium, where every desktop visitor would
         otherwise get a modal on first load; there the menu item is the entry
         point. --%>
    <pwa-install id="pwa-install" use-local-storage manual-chrome></pwa-install>
    {@inner_content}
  </body>
</html>
