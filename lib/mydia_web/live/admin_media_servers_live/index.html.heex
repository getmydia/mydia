<Layouts.app {assigns}>
  <.admin_page page={:media_servers} count={length(@media_servers) + length(@plugin_instances)}>
    <:actions>
      <MydiaWeb.AdminMediaServersLive.Components.header_actions media_server_plugins={
        @media_server_plugins
      } />
    </:actions>
    <div :if={@plex_deprecations != []} class="px-4 pt-4 sm:px-6 sm:pt-6">
      <MydiaWeb.PluginInstanceComponents.plex_deprecation_banner declarations={@plex_deprecations} />
    </div>
    <div
      :if={@plugin_instances != []}
      id="plugin-instances"
      class="grid gap-4 md:grid-cols-2 px-4 pt-4 sm:px-6 sm:pt-6"
    >
      <MydiaWeb.PluginInstanceComponents.instance_card
        :for={{plugin, instance} <- @plugin_instances}
        plugin={plugin}
        instance={instance}
        health={
          Map.get(@plugin_instance_health, instance.id, %{
            status: :unknown,
            message: nil,
            action: nil,
            checked_at: nil
          })
        }
        last_run={Map.get(@plugin_instance_runs, instance.id)}
        links={Map.get(@plugin_instance_links, instance.id, [])}
      />
    </div>
    <MydiaWeb.AdminMediaServersLive.Components.media_servers_tab
      media_servers={@media_servers}
      media_server_health={@media_server_health}
      last_runs={@last_runs}
      link_counts={@link_counts}
      has_plugin_instances={@plugin_instances != []}
    />

    <.live_component
      :if={@plugin_setup}
      module={MydiaWeb.PluginSetupLive.Modal}
      id="plugin-setup-modal"
      slug={@plugin_setup.slug}
      instance_id={@plugin_setup.instance_id}
      entry_step={@plugin_setup.entry_step}
    />

    <%!-- Media Server Modal --%>
    <%= if assigns[:show_media_server_modal] do %>
      <MydiaWeb.AdminMediaServersLive.Components.media_server_modal
        media_server_form={@media_server_form}
        media_server_mode={@media_server_mode}
        testing_media_server_connection={assigns[:testing_media_server_connection] || false}
        plex_oauth_state={assigns[:plex_oauth_state] || :idle}
        plex_oauth_servers={assigns[:plex_oauth_servers] || []}
        plex_manual_entry={assigns[:plex_manual_entry] || false}
        plex_reachability={assigns[:plex_reachability] || :checking}
        plex_discovery={assigns[:plex_discovery_summary]}
      />
    <% end %>

    <%!-- Account Mapping Modal --%>
    <%= if assigns[:account_mapping_config] do %>
      <MydiaWeb.AdminMediaServersLive.Components.account_mapping_modal
        config={@account_mapping_config}
        state={@account_mapping_state}
        accounts={assigns[:account_mapping_accounts] || []}
        users={assigns[:account_mapping_users] || []}
        mapping={assigns[:account_mapping] || %{}}
        saving={assigns[:account_mapping_saving] || false}
      />
    <% end %>
  </.admin_page>
</Layouts.app>
