<Layouts.app {assigns}>
  <div class="max-w-5xl mx-auto p-4 flex flex-col gap-6">
    <h1 class="text-3xl font-bold">Import Media</h1>

    <RunControl.run_control
      library_paths={@library_paths}
      active_run={@active_run}
      outcome_run={@outcome_run}
    />

    <Inbox.inbox
      rows={@streams.inbox_rows}
      total={@inbox_total}
      filter={@inbox_filter}
      offset={@inbox_offset}
      limit={@inbox_limit}
      editing_file_id={@editing_file_id}
      editing_file_path={@editing_file_path}
      edit_form={@edit_form}
      search_results={@search_results}
      batch_selected_ids={@batch_selected_ids}
      batch_search_query={@batch_search_query}
      batch_search_results={@batch_search_results}
      batch_selected_match={@batch_selected_match}
      batch_season_value={@batch_season_value}
    />
  </div>
</Layouts.app>
