<Layouts.app {assigns}>
  <.admin_page page={:trash} count={@summary.count}>
    <:actions>
      <MydiaWeb.AdminTrashLive.Components.header_actions summary={@summary} />
    </:actions>
    <MydiaWeb.AdminTrashLive.Components.trash_tab
      summary={@summary}
      retention_days={@retention_days}
      scanning={@scanning}
      sweeping={@sweeping}
      audit={@audit}
      counts={@counts}
      reason={@reason}
      selection={@selection}
      total_matching={@total_matching}
      page_size={@page_size}
      files={@files}
      page={@page}
    />

    <%= if @show_empty_modal do %>
      <MydiaWeb.AdminTrashLive.Components.empty_confirm_modal
        count={@summary.count}
        bytes={@summary.bytes}
      />
    <% end %>
  </.admin_page>
</Layouts.app>
