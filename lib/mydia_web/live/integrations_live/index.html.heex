<Layouts.app {assigns}>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold">Integrations</h1>
        <p class="text-base-content/70 mt-1">
          Connect external services to sync your watch history.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-lg mb-4">
          <.icon name="hero-puzzle-piece" class="w-5 h-5" /> Integrations
        </h2>

        <div class="space-y-4">
          <div
            :if={@plugin_connections == [] and @account_links == []}
            id="integrations-empty"
            class="text-sm text-base-content/60"
          >
            <%= if Mydia.Accounts.Authorization.is_admin?(@current_user) do %>
              <p>No integrations yet. Install a plugin that connects to a service.</p>
              <.link
                id="integrations-browse-plugins"
                navigate={~p"/admin/plugins"}
                class="btn btn-sm btn-outline mt-2"
              >
                <.icon name="hero-puzzle-piece" class="w-4 h-4" /> Browse plugins
              </.link>
            <% else %>
              <p>No integrations are available yet. Ask your administrator to install one.</p>
            <% end %>
          </div>

          <%!-- Generic plugin connections (U8) — host-run device flow --%>
          <div
            :for={{pc, idx} <- Enum.with_index(@plugin_connections)}
            class="pt-2"
            id={"plugin-conn-#{pc.slug}"}
          >
            <div :if={idx > 0} class="divider my-1"></div>
            <h3 class="font-medium mb-1">{pc.name}</h3>
            <p class="text-sm text-base-content/60 mb-3">
              This connection is managed by the third-party plugin {pc.name}; it will be able to
              read your watch history and mark items watched in mydia on your behalf.
            </p>

            <%= cond do %>
              <% @plugin_connect && @plugin_connect.slug == pc.slug && Map.get(@plugin_connect, :error) -> %>
                <div class="alert alert-error" id={"plugin-conn-error-#{pc.slug}"}>
                  <.icon name="hero-exclamation-circle" class="w-5 h-5" />
                  <span>{@plugin_connect.error}</span>
                </div>
              <% @plugin_connect && @plugin_connect.slug == pc.slug && Map.get(@plugin_connect, :user_code) -> %>
                <div
                  class="bg-base-200 rounded-lg p-4 text-center space-y-3"
                  id={"plugin-conn-pending-#{pc.slug}"}
                >
                  <p class="text-sm text-base-content/70">
                    Go to the following URL and enter the code below:
                  </p>
                  <a
                    :if={@plugin_connect.verification_url}
                    href={@plugin_connect.verification_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link link-primary text-sm"
                  >
                    {@plugin_connect.verification_url}
                  </a>
                  <div class="py-2">
                    <%!-- phx-no-format keeps the code on one line so select-all copies no surrounding whitespace --%>
                    <code
                      phx-no-format
                      class="text-3xl font-mono font-bold tracking-widest select-all"
                    >{@plugin_connect.user_code}</code>
                  </div>
                  <div class="flex items-center justify-center gap-2 text-sm text-base-content/60">
                    <span class="loading loading-spinner loading-xs"></span>
                    Waiting for authorization...
                  </div>
                  <button
                    type="button"
                    class="btn btn-ghost btn-sm"
                    phx-click="plugin_cancel"
                  >
                    Cancel
                  </button>
                </div>
              <% pc.connection && pc.connection.status == :active -> %>
                <div
                  class="flex items-center justify-between"
                  id={"plugin-conn-connected-#{pc.slug}"}
                >
                  <span class="badge badge-success gap-1">
                    <.icon name="hero-check-circle" class="w-3 h-3" /> Connected
                  </span>
                  <button
                    type="button"
                    class="btn btn-outline btn-error btn-sm"
                    phx-click="plugin_disconnect"
                    phx-value-slug={pc.slug}
                    data-confirm={"Disconnect #{pc.name}?"}
                  >
                    Disconnect
                  </button>
                </div>
              <% pc.connection && pc.connection.status == :error -> %>
                <div
                  class="flex items-center justify-between"
                  id={"plugin-conn-errored-#{pc.slug}"}
                >
                  <span class="badge badge-error gap-1">
                    <.icon name="hero-exclamation-triangle" class="w-3 h-3" /> Needs reconnect
                  </span>
                  <button
                    type="button"
                    class="btn btn-primary btn-sm"
                    phx-click="plugin_connect"
                    phx-value-slug={pc.slug}
                  >
                    Reconnect
                  </button>
                </div>
              <% true -> %>
                <button
                  type="button"
                  id={"plugin-conn-connect-#{pc.slug}"}
                  class="btn btn-primary btn-sm"
                  phx-click="plugin_connect"
                  phx-value-slug={pc.slug}
                >
                  <.icon name="hero-link" class="w-4 h-4" /> Connect {pc.name}
                </button>
            <% end %>
          </div>

          <div :if={@account_links != []} class="divider my-2"></div>
          <MydiaWeb.PluginInstanceComponents.account_links_list
            links={@account_links}
            plugin_names={@plugin_names}
          />
        </div>
      </div>
    </div>
    <div
      :if={@plugin_grants != []}
      id="plugin-permissions"
      class="card bg-base-100 shadow-sm mt-6"
    >
      <div class="card-body">
        <h2 class="card-title text-lg">
          <.icon name="hero-shield-check" class="w-5 h-5" /> Plugin permissions
        </h2>
        <p class="text-sm text-base-content/60">
          Changes these plugins may make for you without asking.
        </p>
        <ul class="divide-y divide-base-300">
          <li
            :for={grant <- @plugin_grants}
            id={"plugin-grant-#{grant.id}"}
            class="flex flex-wrap items-center gap-3 py-2 text-sm"
          >
            <span class="font-medium">{grant.plugin_slug}</span>
            <span class="flex-1">{PageWrites.surface_label(grant.surface)}</span>
            <span class="badge badge-ghost badge-sm">
              Always
            </span>
            <button
              id={"revoke-grant-#{grant.id}"}
              class="btn btn-ghost btn-xs"
              phx-click="revoke_grant"
              phx-value-id={grant.id}
            >
              Revoke
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layouts.app>
