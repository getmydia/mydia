<Layouts.app {assigns}>
  <div class="max-w-4xl mx-auto">
    <%!-- Header --%>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold">{gettext("Profile & Preferences")}</h1>
        <p class="text-base-content/70 mt-1">
          {gettext("Manage your account and customize your experience")}
        </p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <%!-- Account Info Card --%>
      <div class="lg:col-span-1">
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">{gettext("Account Info")}</h2>

            <%!-- Avatar --%>
            <div class="flex justify-center mb-4">
              <div class="avatar placeholder">
                <div class="bg-primary text-primary-content rounded-full w-24 h-24">
                  <%= if @current_user.avatar_url do %>
                    <img
                      src={@current_user.avatar_url}
                      alt={gettext("Avatar")}
                      class="rounded-full"
                    />
                  <% else %>
                    <span class="text-3xl">
                      {String.first(
                        @current_user.display_name || @current_user.username ||
                          @current_user.email || "U"
                      )
                      |> String.upcase()}
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="space-y-3">
              <div>
                <span class="text-xs text-base-content/50 uppercase tracking-wide">
                  {gettext("Username")}
                </span>
                <p class="font-medium">{@current_user.username || "-"}</p>
              </div>
              <div>
                <span class="text-xs text-base-content/50 uppercase tracking-wide">
                  {gettext("Email")}
                </span>
                <p class="font-medium">{@current_user.email || "-"}</p>
              </div>
              <div>
                <span class="text-xs text-base-content/50 uppercase tracking-wide">
                  {gettext("Role")}
                </span>
                <p class="font-medium capitalize">{@current_user.role}</p>
              </div>
              <div>
                <span class="text-xs text-base-content/50 uppercase tracking-wide">
                  {gettext("Authentication")}
                </span>
                <p id="auth-method" data-method={@auth_method} class="font-medium">
                  {auth_type(@auth_method)}
                </p>
              </div>
              <div>
                <span class="text-xs text-base-content/50 uppercase tracking-wide">
                  {gettext("Last Login")}
                </span>
                <p class="font-medium">
                  {format_datetime(@current_user.last_login_at, @time_display)}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- Right Column --%>
      <div class="lg:col-span-2 space-y-6">
        <%!-- Edit Profile Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-user" class="w-5 h-5" /> {gettext("Edit Profile")}
            </h2>

            <.form
              for={@profile_form}
              id="profile-form"
              phx-change="validate_profile"
              phx-submit="save_profile"
              class="space-y-4"
            >
              <.input
                field={@profile_form[:display_name]}
                type="text"
                label={gettext("Display Name")}
                placeholder={gettext("Your display name")}
              />
              <%!-- Avatar Upload Section --%>
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-medium">{gettext("Avatar Image")}</span>
                </label>

                <div class="space-y-3">
                  <%!-- Staged Upload Preview --%>
                  <div
                    :for={entry <- @uploads.avatar.entries}
                    class="flex items-center gap-4 p-3 bg-base-200 rounded-lg"
                  >
                    <div class="avatar">
                      <div class="w-16 h-16 rounded-full overflow-hidden bg-base-300">
                        <.live_img_preview entry={entry} class="w-full h-full object-cover" />
                      </div>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium truncate">{entry.client_name}</p>
                      <p class="text-xs text-base-content/60">
                        {gettext("%{size} bytes", size: entry.client_size)}
                      </p>
                      <div
                        :for={err <- upload_errors(@uploads.avatar, entry)}
                        class="text-xs text-error mt-1"
                      >
                        {upload_error_to_string(err)}
                      </div>
                    </div>
                    <button
                      type="button"
                      class="btn btn-ghost btn-xs btn-circle"
                      phx-click="cancel_avatar_upload"
                      phx-value-ref={entry.ref}
                      title={gettext("Cancel upload")}
                    >
                      <.icon name="hero-x-mark" class="w-4 h-4" />
                    </button>
                  </div>

                  <%!-- File Input --%>
                  <div class="flex items-center gap-2">
                    <.live_file_input
                      upload={@uploads.avatar}
                      class="file-input file-input-bordered file-input-primary w-full"
                    />
                    <%= if @current_user.avatar_url do %>
                      <button
                        type="button"
                        id="remove-avatar-btn"
                        class="btn btn-outline btn-error shrink-0"
                        phx-click="remove_avatar"
                      >
                        <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Remove Avatar")}
                      </button>
                    <% end %>
                  </div>

                  <div :for={err <- upload_errors(@uploads.avatar)} class="text-xs text-error">
                    {upload_error_to_string(err)}
                  </div>
                </div>
              </div>

              <div class="divider text-xs text-base-content/50">
                {gettext("OR PROVIDE AN IMAGE URL")}
              </div>

              <.input
                field={@profile_form[:avatar_url]}
                type="text"
                value={external_avatar_url(@profile_form[:avatar_url].value)}
                label={gettext("Avatar URL")}
                placeholder={gettext("https://example.com/avatar.jpg")}
              />

              <div class="flex justify-end pt-2">
                <button type="submit" class="btn btn-primary">
                  <.icon name="hero-check" class="w-4 h-4" /> {gettext("Save Changes")}
                </button>
              </div>
            </.form>
          </div>
        </div>

        <%!-- Appearance Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-paint-brush" class="w-5 h-5" /> {gettext("Appearance")}
            </h2>

            <div class="form-control w-full">
              <label class="label" for="theme-picker">
                <span class="label-text font-medium">{gettext("Theme")}</span>
              </label>
              <p class="text-sm text-base-content/60 mb-3">
                {gettext(
                  "Choose how Mydia looks. System follows your device, using your light theme by day and your dark theme by night."
                )}
              </p>
              <.segmented_control
                id="theme-picker"
                value={@theme_selection.mode}
                event="set_theme_mode"
                param="mode"
                label={gettext("Theme")}
                size="md"
              >
                <:option
                  :for={{label, value, icon} <- @themes}
                  value={value}
                  label={label}
                  icon={icon}
                />
              </.segmented_control>
              <.theme_gallery
                id="light-theme-gallery"
                slot="light"
                title={gettext("Light theme")}
                themes={@light_themes}
                selected={@theme_selection.light.id}
                in_use={@theme_selection.mode == "light"}
              />
              <.theme_gallery
                id="dark-theme-gallery"
                slot="dark"
                title={gettext("Dark theme")}
                themes={@dark_themes}
                selected={@theme_selection.dark.id}
                in_use={@theme_selection.mode == "dark"}
              />
            </div>

            <div class="form-control w-full mt-6">
              <span class="label-text font-medium">{gettext("Corners")}</span>
              <p class="text-sm text-base-content/60 mb-3">
                {gettext(
                  "How round cards, buttons and inputs are. Theme keeps each theme's own corners."
                )}
              </p>
              <.radius_picker id="theme-radius-picker" selected={@theme_selection.radius} />
            </div>

            <div class="form-control w-full mt-6" id="interface-language-settings">
              <span id="interface-language-title" class="label-text font-medium">
                {gettext("Language")}
              </span>
              <p class="text-sm text-base-content/60 mb-3">
                {gettext(
                  "Automatic follows your browser. Percentages show how much of Mydia is translated; the rest stays in English."
                )}
              </p>
              <.form for={%{}} id="interface-language-form" phx-change="set_interface_language">
                <.input
                  type="select"
                  id="interface-language-select"
                  name="interface_language"
                  label={gettext("Interface language")}
                  value={UserPreference.interface_language(@preference)}
                  options={@language_options}
                />
              </.form>
            </div>

            <div class="form-control w-full mt-6" id="time-display-settings">
              <span class="label-text font-medium">{gettext("Date & time")}</span>
              <p class="text-sm text-base-content/60 mb-3">
                {gettext(
                  "Times across Mydia are shown in this zone. The server default comes from the %{tz} setting.",
                  tz: "TZ"
                )}
              </p>
              <.form for={%{}} id="time-display-form" phx-change="set_time_zone">
                <.input
                  type="select"
                  id="time-zone-select"
                  name="time_zone"
                  label={gettext("Time zone")}
                  value={UserPreference.time_zone(@preference) || ""}
                  prompt={gettext("Server default (%{zone})", zone: @server_time_zone)}
                  options={@time_zone_options}
                />
              </.form>
              <div class="mt-4">
                <.segmented_control
                  id="clock-format-picker"
                  value={UserPreference.clock_format(@preference)}
                  event="set_clock_format"
                  param="clock"
                  label={gettext("Clock")}
                  size="md"
                >
                  <:option
                    value="auto"
                    label={gettext("Auto (%{format})", format: clock_label(@time_display))}
                  />
                  <:option value="12" label={gettext("12-hour")} />
                  <:option value="24" label={gettext("24-hour")} />
                </.segmented_control>
              </div>
              <p id="time-display-preview" class="text-sm text-base-content/60 mt-3">
                {gettext("Now:")}
                <.local_time at={DateTime.utc_now()} format={:datetime} display={@time_display} />
              </p>
            </div>

            <%= if @player_enabled do %>
              <div class="divider my-2"></div>

              <div class="form-control w-full">
                <span class="label-text font-medium">{gettext("Player")}</span>
                <p class="text-sm text-base-content/60 mb-3">
                  {gettext(
                    "Takes the player shortcuts out of the sidebar, the mobile dock and the dashboard. Play buttons on movies and episodes keep working, and the player itself stays available if you open it directly."
                  )}
                </p>
                <.input
                  type="checkbox"
                  id="hide-player-toggle"
                  name="hide_player"
                  label={gettext("Hide the player")}
                  class="toggle toggle-primary"
                  checked={@hide_player}
                  phx-click="toggle_hide_player"
                />
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Add Defaults Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-plus-circle" class="w-5 h-5" /> {gettext("Add Defaults")}
            </h2>
            <p class="text-sm text-base-content/60 mb-3">
              {gettext(
                "Override what happens when you add a movie or TV show. Leave a field on \"Use server default\" to follow the instance-wide setting."
              )}
            </p>

            <form
              id="profile-add-defaults-form"
              phx-change="update_add_defaults"
              class="space-y-4"
            >
              <.inherit_select
                name="add_movie_library_path_id"
                label={gettext("Movie library")}
                value={@add_prefs["add_movie_library_path_id"]}
                options={@movie_library_options}
              />
              <.inherit_select
                name="add_series_library_path_id"
                label={gettext("TV library")}
                value={@add_prefs["add_series_library_path_id"]}
                options={@series_library_options}
              />
              <.inherit_select
                name="add_quality_profile_id"
                label={gettext("Quality profile")}
                value={@add_prefs["add_quality_profile_id"]}
                options={@quality_profile_options}
              />
              <.inherit_select
                name="add_season_monitoring"
                label={gettext("Season monitoring")}
                value={@add_prefs["add_season_monitoring"]}
                options={[
                  {"all", gettext("All seasons")},
                  {"first", gettext("First season")},
                  {"future", gettext("Future only")},
                  {"none", gettext("None")}
                ]}
              />
              <.inherit_select
                name="add_monitored"
                label={gettext("Monitored on add")}
                value={@add_prefs["add_monitored"]}
                options={[{true, gettext("Yes")}, {false, gettext("No")}]}
              />
              <.inherit_select
                name="add_search_on_add"
                label={gettext("Search for a release on add")}
                value={@add_prefs["add_search_on_add"]}
                options={[{true, gettext("Yes")}, {false, gettext("No")}]}
              />
            </form>
          </div>
        </div>

        <%!-- Security Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-shield-check" class="w-5 h-5" /> {gettext("Security")}
            </h2>

            <%= if @has_password do %>
              <p class="text-base-content/70 mb-4">
                {gettext("Change your password to keep your account secure.")}
              </p>
              <button
                type="button"
                id="change-password-btn"
                class="btn btn-outline"
                phx-click="show_password_modal"
              >
                <.icon name="hero-key" class="w-4 h-4" /> {gettext("Change Password")}
              </button>

              <.live_component
                :if={@current_user.password_hash}
                module={MydiaWeb.ProfileLive.TwoFactorComponent}
                id="two-factor"
                user_id={@current_user.id}
                time_display={@time_display}
              />
              <.live_component
                :if={@current_user.password_hash && @local_auth_enabled}
                module={MydiaWeb.ProfileLive.PasskeysComponent}
                id="passkeys-card"
                user_id={@current_user.id}
                time_display={@time_display}
                page_url={@page_url}
              />
            <% else %>
              <div class="alert">
                <.icon name="hero-information-circle" class="w-5 h-5" />
                <span>
                  {gettext(
                    "Your account is managed through your SSO provider. Password changes are not available."
                  )}
                </span>
              </div>
            <% end %>

            <div
              :if={@oidc_configured}
              id="sso-link-section"
              class="mt-6 pt-6 border-t border-base-300"
            >
              <h3 class="font-semibold mb-1">{gettext("Single sign-on")}</h3>
              <%= if @oidc_linked do %>
                <p class="text-base-content/70 mb-3">
                  {gettext("Your account is linked to your SSO provider.")}
                </p>
                <.link
                  :if={is_nil(@oidc_unlink_blocker)}
                  id="unlink-sso-btn"
                  href={~p"/auth/oidc/link"}
                  method="delete"
                  data-confirm={gettext("Unlink SSO from your account?")}
                  class="btn btn-outline btn-sm"
                >
                  <.icon name="hero-link-slash" class="w-4 h-4" /> {gettext("Unlink SSO")}
                </.link>
                <p
                  :if={@oidc_unlink_blocker}
                  id="sso-unlink-blocked"
                  data-reason={@oidc_unlink_blocker}
                  class="text-sm text-base-content/60"
                >
                  <%= if @oidc_unlink_blocker == :local_auth_disabled do %>
                    {gettext(
                      "Local sign-in is disabled on this server, so SSO cannot be unlinked."
                    )}
                  <% else %>
                    {gettext(
                      "Your sign-in is managed by your SSO provider, so it cannot be unlinked."
                    )}
                  <% end %>
                </p>
              <% else %>
                <p class="text-base-content/70 mb-3">
                  {gettext("Sign in with your SSO provider as well as your password.")}
                </p>
                <.link
                  id="link-sso-btn"
                  href={~p"/auth/oidc/link"}
                  method="post"
                  class="btn btn-outline btn-sm"
                >
                  <.icon name="hero-link" class="w-4 h-4" /> {gettext("Link SSO account")}
                </.link>
              <% end %>
            </div>
          </div>
        </div>

        <%!-- Integrations Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-puzzle-piece" class="w-5 h-5" /> {gettext("Integrations")}
            </h2>

            <p class="text-base-content/70 mb-4">
              {gettext("Connect third-party plugins to sync your watch history.")}
            </p>
            <.link navigate={~p"/integrations"} id="integrations-link" class="btn btn-outline">
              <.icon name="hero-arrow-top-right-on-square" class="w-4 h-4" /> {gettext(
                "Manage Integrations"
              )}
            </.link>
          </div>
        </div>

        <%!-- Devices Card --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-lg mb-4">
              <.icon name="hero-device-phone-mobile" class="w-5 h-5" /> {gettext("Devices")}
            </h2>

            <p class="text-base-content/70 mb-4">
              {gettext("Connect a player to your account, or download one for your device.")}
            </p>
            <.link navigate={~p"/devices"} id="devices-link" class="btn btn-outline">
              <.icon name="hero-arrow-top-right-on-square" class="w-4 h-4" /> {gettext(
                "Manage Devices"
              )}
            </.link>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Password Change Modal --%>
  <%= if @show_password_modal do %>
    <div class="modal modal-open" id="password-modal">
      <div class="modal-box">
        <button
          type="button"
          class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
          phx-click="hide_password_modal"
        >
          <.icon name="hero-x-mark" class="w-4 h-4" />
        </button>

        <h3 class="font-bold text-lg mb-4">{gettext("Change Password")}</h3>

        <%= if @password_error do %>
          <div class="alert alert-error mb-4">
            <.icon name="hero-exclamation-circle" class="w-5 h-5" />
            <span>{@password_error}</span>
          </div>
        <% end %>

        <.form
          for={@password_form}
          id="password-form"
          phx-change="validate_password"
          phx-submit="change_password"
          class="space-y-4"
        >
          <.input
            field={@password_form[:current_password]}
            type="password"
            label={gettext("Current Password")}
            required
          />
          <.input
            field={@password_form[:new_password]}
            type="password"
            label={gettext("New Password")}
            required
          />
          <.input
            field={@password_form[:confirm_password]}
            type="password"
            label={gettext("Confirm New Password")}
            required
          />

          <div class="modal-action">
            <button type="button" class="btn btn-ghost" phx-click="hide_password_modal">
              {gettext("Cancel")}
            </button>
            <button type="submit" class="btn btn-primary">
              <.icon name="hero-check" class="w-4 h-4" /> {gettext("Update Password")}
            </button>
          </div>
        </.form>
      </div>
      <div class="modal-backdrop bg-black/50" phx-click="hide_password_modal"></div>
    </div>
  <% end %>
</Layouts.app>
