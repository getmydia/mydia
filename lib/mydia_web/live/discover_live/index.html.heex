<Layouts.app {assigns}>
  <div id="discover-page" class="space-y-5 md:space-y-6">
    <%!-- Header --%>
    <div>
      <h1 class="text-3xl font-bold">Discover</h1>
      <p class="text-base-content/70 mt-1">
        Find new {if @media_type == :movie, do: "movies", else: "TV shows"} to add to your library
      </p>
    </div>

    <%!-- Controls card --%>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body p-3 md:p-4 space-y-3">
        <%!-- Search --%>
        <form id="discover-search-form" phx-submit="search" class="flex items-center gap-2">
          <label class="input input-bordered input-sm flex items-center gap-2 flex-1 max-w-md">
            <.icon name="hero-magnifying-glass" class="w-4 h-4 opacity-60" aria-hidden="true" />
            <input
              id="discover-search-input"
              type="text"
              name="q"
              value={@search_query}
              placeholder={
                if @media_type == :movie,
                  do: "Search for a movie to add",
                  else: "Search for a show to add"
              }
              aria-label={
                if @media_type == :movie,
                  do: "Search for a movie to add",
                  else: "Search for a show to add"
              }
              class="grow"
              autocomplete="off"
            />
          </label>
          <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </form>

        <%!-- Media type toggle + category tabs --%>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:justify-between gap-3">
          <div id="discover-view-controls" class="flex flex-wrap items-center gap-3">
            <.segmented_control
              id="discover-media-type"
              value={@media_type}
              event="switch_media_type"
              param="type"
              label="Media type"
            >
              <:option value="movie" label="Movies" icon="hero-film" />
              <:option value="tv_show" label="TV Shows" icon="hero-tv" />
            </.segmented_control>

            <.grid_density_toggle id="discover-density-toggle" density={@grid_density} />

            <label class="flex items-center gap-2 cursor-pointer">
              <input
                id="discover-hide-owned"
                type="checkbox"
                phx-click="toggle_hide_owned"
                checked={@hide_owned}
                class="toggle toggle-sm toggle-primary"
              />
              <span class={["text-sm", !@hide_owned && "text-base-content/50"]}>
                Hide in library
              </span>
            </label>
          </div>

          <%= if @search_mode do %>
            <div id="discover-search-chip" class="badge badge-lg gap-2">
              Results for "{@search_query}"
              <button
                id="discover-search-clear"
                type="button"
                phx-click="clear_search"
                class="btn btn-ghost btn-xs btn-circle"
                aria-label="Clear search"
              >
                <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
              </button>
            </div>
          <% else %>
            <div class="flex flex-wrap items-center gap-2">
              <div role="tablist" class="tabs tabs-box w-fit">
                <%= for {cat_key, cat_label} <- @categories do %>
                  <button
                    role="tab"
                    phx-click="switch_category"
                    phx-value-category={cat_key}
                    class={["tab tab-sm", @category == cat_key && "tab-active"]}
                  >
                    {cat_label}
                  </button>
                <% end %>
                <button
                  :if={@home_country}
                  id="discover-home-tab"
                  role="tab"
                  phx-click="switch_category"
                  phx-value-category="home"
                  class={["tab tab-sm gap-1", @category == :home && "tab-active"]}
                >
                  <span aria-hidden="true">{Countries.flag(@home_country)}</span>
                  {Countries.name(@home_country)}
                </button>
                <button
                  role="tab"
                  phx-click="switch_category"
                  phx-value-category="discover"
                  class={["tab tab-sm gap-1", @category == :discover && "tab-active"]}
                >
                  <.icon name="hero-adjustments-horizontal" class="w-3.5 h-3.5" /> Custom
                </button>
              </div>

              <button
                id="discover-country-settings-button"
                type="button"
                phx-click="open_country_settings"
                class="btn btn-ghost btn-sm gap-1 text-base-content/70 hover:text-base-content transition-colors"
              >
                <.icon
                  name={if(@home_country, do: "hero-map-pin", else: "hero-plus")}
                  class="w-4 h-4"
                /> Your country
              </button>
            </div>
          <% end %>
        </div>

        <%= if @category == :home and @source do %>
          <div class="flex items-center gap-2">
            <.link
              id="discover-see-all-back"
              patch={~p"/discover?#{%{"type" => @media_type, "category" => "home"}}"}
              class="btn btn-sm btn-ghost"
            ><.icon name="hero-arrow-left" class="w-4 h-4" /> Back</.link><h2
              id="discover-see-all-title"
              class="text-lg font-semibold"
            >
              {RegionalSources.label(@source, @home_country)}
            </h2>
          </div>
        <% end %>

        <%!-- Filter controls — only visible in custom/discover mode --%>
        <%= if @category == :discover or (@category == :home and @source != nil) do %>
          <form
            id="discover-filter-form"
            phx-change="apply_filters"
            class="flex flex-wrap items-center gap-2"
          >
            <div class="join">
              <select name="genre" class="select select-bordered select-sm join-item">
                <option value="">All Genres</option>
                <%= for genre <- @genres do %>
                  <option
                    value={genre.id}
                    selected={to_string(genre.id) in @selected_genres}
                  >
                    {genre.name}
                  </option>
                <% end %>
              </select>

              <select name="language" class="select select-bordered select-sm join-item">
                <option value="">All Languages</option>
                <%= for {code, name} <- @languages do %>
                  <option value={code} selected={@selected_language == code}>
                    {name}
                  </option>
                <% end %>
              </select>
              <select
                id="discover-year-from"
                name="year_from"
                class="select select-bordered select-sm join-item"
                aria-label="From year"
              >
                <option value="">From: any</option>
                <%= for year <- Date.utc_today().year..1900//-1 do %>
                  <option value={year} selected={@year_from == year}>From {year}</option>
                <% end %>
              </select>
              <select
                id="discover-year-to"
                name="year_to"
                class="select select-bordered select-sm join-item"
                aria-label="To year"
              >
                <option value="">To: any</option>
                <%= for year <- Date.utc_today().year..1900//-1 do %>
                  <option value={year} selected={@year_to == year}>To {year}</option>
                <% end %>
              </select>

              <select name="rating" class="select select-bordered select-sm join-item">
                <option value="">Any Rating</option>
                <%= for rating <- [9, 8, 7, 6, 5] do %>
                  <option
                    value={rating}
                    selected={@min_rating != nil && round(@min_rating) == rating}
                  >
                    {rating}+ Stars
                  </option>
                <% end %>
              </select>
            </div>

            <%!-- Sort --%>
            <div class="divider divider-horizontal mx-0 hidden sm:flex"></div>
            <div class="flex items-center gap-1.5">
              <.icon
                name="hero-arrows-up-down"
                class="w-4 h-4 text-base-content/50 shrink-0"
              />
              <select name="sort" class="select select-bordered select-sm">
                <%= for {value, label} <- @sort_options do %>
                  <option value={value} selected={@sort_by == value}>
                    {label}
                  </option>
                <% end %>
              </select>
            </div>
          </form>
        <% end %>
      </div>
    </div>

    <%!-- Results --%>
    <%= cond do %>
      <% @category == :home and is_nil(@source) and not @search_mode -> %>
        <.regional_rows
          sources={@regional_sources}
          rows={@regional_rows}
          country={@home_country}
          media_type={@media_type}
          has_services={@streaming_services != []}
          hide_owned={@hide_owned}
          current_user={@current_user}
          adding_ids={@adding_item_ids}
          requesting_item_id={@requesting_item_id}
        />
      <% @loading -> %>
        <.poster_card_grid_skeleton
          id="discover-grid-skeleton"
          columns={grid_columns_class(@grid_density)}
          gap="gap-4 md:gap-5"
        />
      <% @load_error != nil and @items == [] -> %>
        <div class="flex flex-col items-center justify-center py-16 gap-4">
          <div class="bg-error/10 rounded-full p-6">
            <.icon name="hero-exclamation-triangle" class="w-10 h-10 text-error" />
          </div>
          <div class="text-center">
            <p class="text-lg font-medium text-base-content/80">Unable to load results</p>
            <p class="text-sm text-base-content/50 mt-1">
              The metadata service is temporarily unavailable. Try a curated list instead.
            </p>
          </div>
        </div>
      <% @visible_items == [] and Mydia.Accounts.Scope.restricted?(@current_scope) and not @has_more -> %>
        <div
          id="discover-restricted-empty"
          class="flex flex-col items-center justify-center py-16 gap-4"
        >
          <div class="bg-base-200 rounded-full p-6">
            <.icon name="hero-lock-closed" class="w-10 h-10 text-base-content/40" />
          </div>
          <p class="text-lg font-medium text-base-content/80">
            Nothing here is available for your account.
          </p>
        </div>
      <% @visible_items == [] -> %>
        <div class="flex flex-col items-center justify-center py-16 gap-4">
          <div class="bg-base-200 rounded-full p-6">
            <.icon name="hero-magnifying-glass" class="w-10 h-10 text-base-content/40" />
          </div>
          <div class="text-center">
            <p class="text-lg font-medium text-base-content/80">No results found</p>
            <p class="text-sm text-base-content/50 mt-1">
              Try adjusting your filters or search terms
            </p>
            <p :if={@hide_owned} class="text-sm text-base-content/50 mt-1">
              Titles already in your library are hidden.
            </p>
          </div>
        </div>
      <% true -> %>
        <div
          id="discover-grid"
          class={["grid gap-4 md:gap-5", grid_columns_class(@grid_density)]}
        >
          <%= for {item, index} <- Enum.with_index(@visible_items) do %>
            <.trending_card
              item={item}
              media_type={item.media_type || @media_type}
              current_user={@current_user}
              adding_ids={@adding_item_ids}
              requesting_item_id={@requesting_item_id}
              loading={if(index < 6, do: nil, else: "lazy")}
            />
          <% end %>
        </div>

        <%!--
          Asks for the next page about a screen and a half before the end.
          load_more replies before the page is fetched, so data-has-more is
          false while one is in flight; flipping back to true when it lands
          is what makes the hook ask again. A failed page keeps it false
          until Retry.
        --%>
        <div
          id="discover-load-more"
          phx-hook="LoadMoreSentinel"
          data-has-more={to_string(@has_more and not @loading_more and is_nil(@load_error))}
          class="flex justify-center py-8"
        >
          <%= cond do %>
            <% @load_error != nil -> %>
              <div
                id="discover-load-more-error"
                class="flex items-center gap-3 text-sm text-base-content/60"
              >
                Couldn't load more results.
                <button
                  id="discover-load-more-retry"
                  type="button"
                  class="btn btn-ghost btn-sm"
                  phx-click="load_more"
                >
                  <.icon name="hero-arrow-path" class="w-4 h-4" /> Retry
                </button>
              </div>
            <% @has_more -> %>
              <span class="loading loading-spinner loading-md text-primary"></span>
            <% true -> %>
          <% end %>
        </div>
    <% end %>
  </div>

  <.country_settings
    :if={@country_settings}
    settings={@country_settings}
    countries={@countries}
    saved_country={@home_country}
  />

  <%!-- Detail Modal --%>
  <.live_component
    module={MydiaWeb.Live.Components.TrendingDetailModal}
    id="discover-detail-modal"
    item={@selected_item}
    metadata={@selected_metadata}
    loading={@detail_loading}
    current_user={@current_user}
    current_scope={@current_scope}
    open={@selected_item != nil}
    config_open={@add_config != nil}
  >
    <:rail>
      <.media_rail
        :if={@selected_item}
        id="discover-recommendations-rail"
        items={@selected_recommendations}
        media_type={@selected_item.media_type}
        current_user={@current_user}
        adding_ids={@adding_item_ids}
        requesting_item_id={@requesting_item_id}
      />
    </:rail>
  </.live_component>

  <.add_config_modal config={@add_config} quality_profiles={@quality_profiles} />
</Layouts.app>
