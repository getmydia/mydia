<Layouts.app {assigns}>
  <.admin_page page={:smart_space}>
    <div
      id="smart-space-summary"
      class="stats stats-vertical sm:stats-horizontal bg-base-200 mb-6"
    >
      <div class="stat">
        <div class="stat-title">{gettext("Due in the next 30 days")}</div>
        <div class="stat-value text-2xl">{size(@bytes_due)}</div>
      </div>
      <div class="stat">
        <div class="stat-title">{gettext("Last run")}</div>
        <div class="stat-value text-2xl">{format_run(@last_run_at)}</div>
      </div>
    </div>

    <div role="tablist" class="tabs tabs-border mb-4">
      <.link
        id="smart-space-tab-upcoming"
        role="tab"
        patch={~p"/admin/smart-space"}
        class={["tab", @tab == :upcoming && "tab-active"]}
      >
        {gettext("Upcoming")}
        <span class="badge badge-sm ml-2">{@upcoming_count}</span>
      </.link>
      <.link
        id="smart-space-tab-kept"
        role="tab"
        patch={~p"/admin/smart-space?tab=kept"}
        class={["tab", @tab == :kept && "tab-active"]}
      >
        {gettext("Kept")}
        <span class="badge badge-sm ml-2">{@keeps_count}</span>
      </.link>
    </div>

    <div :if={@tab == :upcoming}>
      <div
        :if={@upcoming_count == 0}
        id="smart-space-empty"
        class="alert alert-soft"
      >
        <.icon name="hero-sparkles" class="w-5 h-5" />
        <div>
          <%= if @enabled? do %>
            {gettext("Nothing is due in the next 30 days.")}
          <% else %>
            {gettext("Smart Space is off.")}
            <.link id="smart-space-settings-link" navigate={~p"/admin/settings"} class="link">
              {gettext("Turn it on in Settings")}
            </.link>
          <% end %>
        </div>
      </div>

      <div class="overflow-x-auto" hidden={@upcoming_count == 0}>
        <table class="table">
          <thead>
            <tr>
              <th>{gettext("Show")}</th>
              <th>{gettext("Unit")}</th>
              <th>{gettext("Size")}</th>
              <th>{gettext("Due")}</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="smart-space-upcoming" phx-update="stream">
            <tr :for={{dom_id, row} <- @streams.upcoming} id={dom_id}>
              <td class="font-medium">{row.cleanup.title}</td>
              <td>{row.label}</td>
              <td>{size(row.cleanup.bytes)}</td>
              <td>{row.due}</td>
              <td class="text-right">
                <button
                  id={"keep-#{dom_id}"}
                  type="button"
                  class="btn btn-sm btn-ghost"
                  phx-click="keep"
                  phx-value-media-item-id={row.cleanup.media_item_id}
                  phx-value-season-number={row.cleanup.season_number}
                  phx-value-episode-id={row.episode_id}
                  phx-value-unit={row.cleanup.unit}
                >
                  <.icon name="hero-bookmark" class="w-4 h-4" /> {gettext("Keep")}
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div :if={@tab == :kept}>
      <div :if={@keeps_count == 0} id="smart-space-keeps-empty" class="alert alert-soft">
        {gettext("Nothing is kept. Keep a season from the Upcoming tab to exempt it.")}
      </div>

      <div class="overflow-x-auto" hidden={@keeps_count == 0}>
        <table class="table">
          <thead>
            <tr>
              <th>{gettext("Show")}</th>
              <th>{gettext("Kept")}</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="smart-space-keeps" phx-update="stream">
            <tr :for={{dom_id, keep} <- @streams.keeps} id={dom_id}>
              <td class="font-medium">{keep.media_item.title}</td>
              <td>{keep_label(keep)}</td>
              <td class="text-right">
                <button
                  id={"unkeep-#{keep.id}"}
                  type="button"
                  class="btn btn-sm btn-ghost"
                  phx-click="unkeep"
                  phx-value-id={keep.id}
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" /> {gettext("Remove")}
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </.admin_page>
</Layouts.app>
