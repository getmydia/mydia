<Layouts.app {assigns}>
  <div>
    <%!-- Header --%>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h1 id="my-requests-heading" class="text-3xl font-bold">{gettext("My Requests")}</h1>
        <p class="text-base-content/70 mt-1">
          {gettext("View the status of your media requests")}
        </p>
      </div>
      <div class="flex gap-2">
        <.link navigate={~p"/discover?type=movie"} class="btn btn-primary btn-sm">
          <.icon name="hero-plus" class="w-4 h-4" /> {gettext("Request Movie")}
        </.link>
        <.link navigate={~p"/discover?type=tv_show"} class="btn btn-primary btn-sm">
          <.icon name="hero-plus" class="w-4 h-4" /> {gettext("Request Series")}
        </.link>
      </div>
    </div>

    <%!-- Filter Tabs --%>
    <div role="tablist" class="tabs tabs-border mb-6">
      <button
        role="tab"
        class={"tab " <> if(@filter_status == "all", do: "tab-active", else: "")}
        phx-click="filter"
        phx-value-status="all"
      >
        {gettext("All")}
      </button>
      <button
        role="tab"
        class={"tab " <> if(@filter_status == "pending", do: "tab-active", else: "")}
        phx-click="filter"
        phx-value-status="pending"
      >
        {gettext("Pending")}
      </button>
      <button
        role="tab"
        class={"tab " <> if(@filter_status == "approved", do: "tab-active", else: "")}
        phx-click="filter"
        phx-value-status="approved"
      >
        {gettext("Approved")}
      </button>
      <button
        role="tab"
        class={"tab " <> if(@filter_status == "rejected", do: "tab-active", else: "")}
        phx-click="filter"
        phx-value-status="rejected"
      >
        {gettext("Rejected")}
      </button>
    </div>

    <%!-- Empty State --%>
    <%= if @requests == [] do %>
      <div class="text-center py-12">
        <.icon name="hero-inbox" class="w-16 h-16 mx-auto text-base-content/30 mb-4" />
        <h3 class="text-lg font-semibold mb-2">{gettext("No requests found")}</h3>
        <p class="text-base-content/70 mb-6">
          <%= if @filter_status == "all" do %>
            {gettext(
              "You haven't submitted any requests yet. Start by searching for media to request!"
            )}
          <% else %>
            {case @filter_status do
              "pending" -> gettext("No Pending Review requests found.")
              "approved" -> gettext("No Approved requests found.")
              "rejected" -> gettext("No Rejected requests found.")
              _ -> gettext("No requests found.")
            end}
          <% end %>
        </p>
        <div class="flex gap-2 justify-center">
          <.link navigate={~p"/discover?type=movie"} class="btn btn-primary">
            <.icon name="hero-plus" class="w-5 h-5" /> {gettext("Request Movie")}
          </.link>
          <.link navigate={~p"/discover?type=tv_show"} class="btn btn-primary">
            <.icon name="hero-plus" class="w-5 h-5" /> {gettext("Request Series")}
          </.link>
        </div>
      </div>
    <% else %>
      <%!-- Requests List --%>
      <div class="space-y-4">
        <%= for request <- @requests do %>
          <.request_card request={request}>
            <:details>
              <div class="flex items-center gap-2 text-base-content/70">
                <.icon name="hero-calendar" class="w-4 h-4" />
                <span>
                  {gettext("Requested on %{date}",
                    date: format_date(request.inserted_at, @time_display)
                  )}
                </span>
              </div>
              <div :if={request.status == "approved"} class="flex items-start gap-2 text-success">
                <.icon name="hero-check-circle" class="w-4 h-4 mt-0.5" />
                <div>
                  <div>
                    {gettext("Approved on %{date}",
                      date: format_date(request.approved_at, @time_display)
                    )}
                  </div>
                  <div :if={request.admin_notes} class="text-xs mt-1">
                    {gettext("Admin notes: %{notes}", notes: request.admin_notes)}
                  </div>
                </div>
              </div>
              <div :if={request.status == "rejected"} class="flex items-start gap-2 text-error">
                <.icon name="hero-x-circle" class="w-4 h-4 mt-0.5" />
                <div>
                  <div>
                    {gettext("Rejected on %{date}",
                      date: format_date(request.rejected_at, @time_display)
                    )}
                  </div>
                  <div :if={request.rejection_reason} class="text-xs mt-1">
                    {gettext("Reason: %{reason}", reason: request.rejection_reason)}
                  </div>
                  <div :if={request.admin_notes} class="text-xs mt-1">
                    {gettext("Admin notes: %{notes}", notes: request.admin_notes)}
                  </div>
                </div>
              </div>
            </:details>

            <:actions>
              <.link
                :if={request.status == "approved" and request.media_item}
                navigate={~p"/media/#{request.media_item.id}"}
                class="btn btn-sm btn-success"
              >
                <.icon name="hero-arrow-top-right-on-square" class="w-4 h-4" /> {gettext(
                  "View in Library"
                )}
              </.link>
            </:actions>
          </.request_card>
        <% end %>
      </div>
    <% end %>

    <%!-- Detail popup. config_open is false because this page never opens the
          configure-before-adding dialog. --%>
    <.live_component
      module={MydiaWeb.Live.Components.TrendingDetailModal}
      id="request-detail-modal"
      item={@detail_item}
      metadata={@detail_metadata}
      loading={@detail_loading}
      current_user={@current_user}
      open={@detail_item != nil}
      config_open={false}
    >
      <:actions>
        <button class="btn btn-ghost" phx-click="close_details">{gettext("Close")}</button>
        <.link
          :if={@detail_request && @detail_request.media_item}
          navigate={~p"/media/#{@detail_request.media_item.id}"}
          class="btn btn-primary"
        >
          <.icon name="hero-arrow-top-right-on-square" class="w-4 h-4" /> {gettext(
            "View in Library"
          )}
        </.link>
      </:actions>
    </.live_component>
  </div>
</Layouts.app>
