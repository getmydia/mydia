<Layouts.app {assigns}>
  <div class="flex flex-col h-full">
    <%!-- Header --%>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h1 id="search-heading" class="text-3xl font-bold">{@page_title}</h1>
        <p class="text-base-content/70 mt-1">
          {gettext("Search for movies and TV shows across your configured indexers")}
        </p>
      </div>
    </div>

    <%!-- No indexers warning --%>
    <%= if @available_indexers == [] do %>
      <div role="alert" class="alert alert-info mb-6">
        <.icon name="hero-information-circle" class="w-5 h-5" />
        <span>
          {gettext("No indexers configured.")}
          <a href={~p"/admin/indexers"} class="link font-semibold">
            {gettext("Configure indexers")}
          </a>
          {gettext("to enable searching.")}
        </span>
      </div>
    <% end %>

    <%!-- Search and Indexer Selection --%>
    <%= if @available_indexers != [] do %>
      <div class="flex flex-col lg:flex-row gap-4 mb-6">
        <%!-- Search input --%>
        <form phx-submit="search" id="indexer-search-form" class="flex-1">
          <div class="join w-full">
            <input
              type="text"
              name="search"
              value={@search_query}
              placeholder={gettext("Search for movies, TV shows, or specific releases...")}
              class="input input-bordered join-item flex-1"
            />
            <button
              type="submit"
              class="btn btn-primary join-item"
              disabled={@searching || MapSet.size(@selected_indexer_ids) == 0}
            >
              <%= if @searching do %>
                <span class="loading loading-spinner loading-sm"></span>
              <% else %>
                <.icon name="hero-magnifying-glass" class="w-5 h-5" />
              <% end %>
              <span class="hidden sm:inline">{pgettext("search", "Search")}</span>
            </button>
          </div>
        </form>

        <%!-- Indexer dropdown --%>
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-outline gap-2">
            <.icon name="hero-server-stack" class="w-5 h-5" /> {gettext("Indexers")}
            <span class="badge badge-sm badge-primary">
              {MapSet.size(@selected_indexer_ids)}/{length(@available_indexers)}
            </span>
          </div>
          <div
            tabindex="0"
            class="dropdown-content z-[1] card card-compact w-72 p-2 shadow-lg bg-base-100 border border-base-300"
          >
            <div class="card-body">
              <div class="flex items-center justify-between mb-2">
                <span class="font-semibold text-sm">{gettext("Select Indexers")}</span>
                <div class="flex gap-1">
                  <button
                    type="button"
                    class="btn btn-xs btn-ghost"
                    phx-click="select_all_indexers"
                  >
                    {gettext("All")}
                  </button>
                  <button
                    type="button"
                    class="btn btn-xs btn-ghost"
                    phx-click="deselect_all_indexers"
                  >
                    {gettext("None")}
                  </button>
                </div>
              </div>
              <div class="space-y-1 max-h-64 overflow-y-auto">
                <%= for indexer <- @available_indexers do %>
                  <label class="flex items-center gap-2 p-2 rounded hover:bg-base-200 cursor-pointer">
                    <input
                      type="checkbox"
                      class="checkbox checkbox-primary checkbox-sm"
                      checked={MapSet.member?(@selected_indexer_ids, indexer.id)}
                      phx-click="toggle_indexer"
                      phx-value-id={indexer.id}
                    />
                    <span class="flex-1 text-sm">{indexer.name}</span>
                    <span class={["badge badge-xs", indexer_type_badge_class(indexer.type)]}>
                      {indexer_type_label(indexer.type)}
                    </span>
                  </label>
                <% end %>
              </div>
              <%= if MapSet.size(@selected_indexer_ids) == 0 do %>
                <div role="alert" class="alert alert-warning py-2 mt-2">
                  <.icon name="hero-exclamation-triangle" class="w-4 h-4" />
                  <span class="text-xs">{gettext("Select at least one indexer")}</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Filters and Sort (shown when searching or have query) --%>
    <%= if @search_query != "" || @searching do %>
      <div class="flex flex-col md:flex-row gap-4 mb-6">
        <%!-- Filters --%>
        <.form for={%{}} phx-change="filter" id="search-filter-form" class="join flex-1">
          <select name="library_type" class="select select-bordered join-item">
            <%= for {type, label} <- library_type_options() do %>
              <option value={type} selected={@library_type_filter == type}>{label}</option>
            <% end %>
          </select>
          <select name="quality" class="select select-bordered join-item">
            <option value="" selected={is_nil(@quality_filter)}>{gettext("All Quality")}</option>
            <option value="720p" selected={@quality_filter == "720p"}>720p</option>
            <option value="1080p" selected={@quality_filter == "1080p"}>1080p</option>
            <option value="2160p" selected={@quality_filter in ["2160p", "4k"]}>4K</option>
          </select>
          <input
            type="number"
            name="min_seeders"
            value={@min_seeders}
            min="0"
            placeholder={gettext("Min seeders")}
            class="input input-bordered join-item w-32"
          />
          <input
            type="number"
            name="min_size"
            value={@min_size_gb}
            min="0"
            step="0.1"
            placeholder={gettext("Min GB")}
            class="input input-bordered join-item w-28"
          />
          <input
            type="number"
            name="max_size"
            value={@max_size_gb}
            min="0"
            step="0.1"
            placeholder={gettext("Max GB")}
            class="input input-bordered join-item w-28"
          />
        </.form>

        <%!-- Sort --%>
        <.form for={%{}} phx-change="sort" id="search-sort-form">
          <select name="sort_by" class="select select-bordered">
            <option value="quality" selected={@sort_by == :quality}>
              {gettext("Quality (Best)")}
            </option>
            <option value="seeders" selected={@sort_by == :seeders}>
              {gettext("Seeders (Most)")}
            </option>
            <option value="size" selected={@sort_by == :size}>{gettext("Size (Largest)")}</option>
            <option value="date" selected={@sort_by == :date}>{gettext("Date (Newest)")}</option>
          </select>
        </.form>
      </div>
    <% end %>

    <%!-- Loading State: only before the first indexer reports --%>
    <%= if @searching && @results_empty? do %>
      <div id="search-loading-state" class="card bg-base-100 shadow-lg">
        <div class="card-body flex flex-col items-center justify-center py-16">
          <span class="loading loading-spinner loading-lg text-primary mb-4"></span>
          <h3 class="text-xl font-semibold text-base-content/70 mb-2">
            {gettext("Searching indexers...")}
          </h3>
          <p class="text-base-content/50">{gettext("Results appear as each indexer responds")}</p>
        </div>
      </div>
    <% end %>

    <%!-- Empty State (no search yet) --%>
    <%= if @search_query == "" && !@searching do %>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body flex flex-col items-center justify-center py-16">
          <.icon name="hero-magnifying-glass" class="w-16 h-16 text-base-content/30 mb-4" />
          <h3 class="text-xl font-semibold text-base-content/70 mb-2">
            {gettext("Search for Media")}
          </h3>
          <p class="text-base-content/50 text-center max-w-md">
            {gettext(
              "Enter a movie or TV show name above to find available releases from your configured indexers"
            )}
          </p>
        </div>
      </div>
    <% end %>

    <%!-- Per-indexer search progress --%>
    <.indexer_search_status
      progress={@indexer_progress}
      cardigann={@cardigann_summary}
      retry_event="retry_indexer"
      retest_paused_event="retest_paused"
    />
    <%!-- Empty State (no results) --%>
    <%= if @results_empty? && @search_query != "" && !@searching do %>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body flex flex-col items-center justify-center py-16">
          <.icon name="hero-exclamation-circle" class="w-16 h-16 text-base-content/30 mb-4" />
          <h3 class="text-xl font-semibold text-base-content/70 mb-2">
            {gettext("No Results Found")}
          </h3>
          <p class="text-base-content/50 text-center max-w-md mb-4">
            {gettext("No releases found for \"%{query}\"", query: @search_query)}
          </p>
          <div class="text-sm text-base-content/60">
            <p>{gettext("Try:")}</p>
            <ul class="list-disc list-inside mt-2 space-y-1">
              <li>{gettext("Using different keywords or spelling")}</li>
              <li>{gettext("Removing or adjusting filters")}</li>
              <li>{gettext("Checking that your indexers are enabled")}</li>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Results --%>
    <%= if @search_query != "" && !@results_empty? do %>
      <div class="card bg-base-100 shadow-lg overflow-hidden">
        <%!-- Results count --%>
        <div class="px-4 py-3 bg-base-200 border-b border-base-300 flex items-center justify-between">
          <span id="search-results-count" class="text-sm font-medium">
            {ngettext(
              "%{count} result for \"%{query}\"",
              "%{count} results for \"%{query}\"",
              map_size(@search_results_map),
              query: @search_query
            )}
          </span>
        </div>

        <%!-- Results Table --%>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full table-fixed">
            <thead>
              <tr class="bg-base-200">
                <th class="w-[50%]">{pgettext("release", "Release")}</th>
                <th class="w-[10%]">{gettext("Size")}</th>
                <th class="w-[15%] hidden md:table-cell">{gettext("Health")}</th>
                <th class="w-[15%] hidden lg:table-cell">{gettext("Source")}</th>
                <th class="w-[10%] text-right">{gettext("Actions")}</th>
              </tr>
            </thead>
            <tbody id="search-results" phx-update="stream">
              <tr
                :for={{id, result} <- @streams.search_results}
                id={id}
                class="hover"
              >
                <%!-- Title Column --%>
                <td
                  class="cursor-pointer max-w-0"
                  phx-click="show_detail"
                  phx-value-ref={SearchResultRef.ref(result)}
                >
                  <div class="flex flex-col min-w-0 gap-1">
                    <div
                      class="font-semibold text-sm truncate hover:text-primary"
                      title={result.title}
                    >
                      {result.title}
                    </div>
                    <%!-- Quality badges --%>
                    <div class="flex flex-wrap gap-1">
                      <%= for badge <- get_quality_badges(result) do %>
                        <span class={"badge badge-xs #{badge.color}"}>
                          {badge.text}
                        </span>
                      <% end %>
                    </div>
                    <%!-- Mobile-only compact info --%>
                    <div class="flex gap-2 mt-1 md:hidden flex-wrap">
                      <% {mobile_lib_type, mobile_source} = result_type(@result_types, result) %>
                      <span
                        class={[
                          "badge badge-xs gap-0.5",
                          library_type_badge_class(mobile_lib_type)
                        ]}
                        data-type-source={mobile_source}
                        title={type_source_hint(mobile_source)}
                      >
                        <.icon name={library_type_icon(mobile_lib_type)} class="w-3 h-3" />
                        {library_type_label(mobile_lib_type)}<span :if={mobile_source == :title}>?</span>
                      </span>
                      <%= if result.download_protocol == :nzb do %>
                        <span class="badge badge-info badge-xs">Usenet</span>
                      <% else %>
                        <span class="badge badge-ghost badge-xs">
                          <.icon name="hero-arrow-up" class="w-3 h-3 mr-1" /> {result.seeders}
                          <span class="mx-1 text-base-content/30">/</span>
                          <.icon name="hero-arrow-down" class="w-3 h-3 mr-1" /> {result.leechers}
                        </span>
                      <% end %>
                      <span class="badge badge-outline badge-xs">{result.indexer}</span>
                    </div>
                  </div>
                </td>
                <%!-- Size Column --%>
                <td class="align-top">
                  <div class="text-sm font-mono text-base-content/70">
                    {format_size(result)}
                  </div>
                </td>
                <%!-- Health Column (Seeders/Peers with indicator) - only for torrents --%>
                <td class="hidden md:table-cell">
                  <%= if result.download_protocol == :nzb do %>
                    <span class="badge badge-info badge-sm">Usenet</span>
                  <% else %>
                    <div class="flex items-center gap-3">
                      <%!-- Health indicator --%>
                      <div
                        class={"radial-progress #{health_color(health_score(result))}"}
                        style={"--value:#{trunc(health_score(result) * 100)}; --size:3rem; --thickness: 3px;"}
                        role="progressbar"
                      >
                        <span class="text-xs font-semibold">
                          {trunc(health_score(result) * 100)}%
                        </span>
                      </div>
                      <%!-- Seeders/Peers --%>
                      <div class="flex flex-col gap-0.5">
                        <div class="flex items-center gap-1.5">
                          <.icon name="hero-arrow-up" class="w-3.5 h-3.5 text-success" />
                          <span class="text-sm font-semibold text-success">{result.seeders}</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                          <.icon name="hero-arrow-down" class="w-3.5 h-3.5 text-base-content/50" />
                          <span class="text-sm text-base-content/70">{result.leechers}</span>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </td>
                <%!-- Source Column (Category + Indexer + Date) --%>
                <td class="hidden lg:table-cell">
                  <div class="flex flex-col gap-1">
                    <div class="flex flex-wrap gap-1">
                      <% {lib_type, lib_source} = result_type(@result_types, result) %>
                      <span
                        class={["badge badge-sm", library_type_badge_class(lib_type)]}
                        data-type-source={lib_source}
                        title={type_source_hint(lib_source)}
                      >
                        {library_type_label(lib_type)}<span :if={lib_source == :title}>?</span>
                      </span>
                      <% info_page_url = SearchResult.info_page_url(result) %>
                      <%= if info_page_url do %>
                        <a
                          href={info_page_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="badge badge-outline badge-sm gap-1 hover:border-primary hover:text-primary transition-colors"
                          title={
                            gettext("View this release on %{indexer}", indexer: result.indexer)
                          }
                        >
                          {result.indexer}
                          <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3" />
                        </a>
                      <% else %>
                        <span class="badge badge-outline badge-sm">{result.indexer}</span>
                      <% end %>
                    </div>
                    <%= if result.published_at do %>
                      <span class="text-xs text-base-content/60">
                        {format_date(result.published_at, @time_display)}
                      </span>
                    <% end %>
                  </div>
                </td>
                <%!-- Actions Column --%>
                <td class="text-right">
                  <%= if @current_user && @current_user.role == "guest" do %>
                    <div
                      class="tooltip tooltip-left"
                      data-tip={gettext("Please use the request system")}
                    >
                      <button class="btn btn-sm btn-ghost" disabled>
                        <.icon name="hero-lock-closed" class="w-4 h-4" />
                      </button>
                    </div>
                  <% else %>
                    <% is_downloading = MapSet.member?(@downloading_urls, result.download_url) %>
                    <button
                      class="btn btn-sm btn-primary"
                      phx-click="show_download_modal"
                      phx-value-ref={SearchResultRef.ref(result)}
                      title={gettext("Download to library")}
                      disabled={is_downloading}
                    >
                      <%= if is_downloading do %>
                        <span class="loading loading-spinner loading-sm"></span>
                      <% else %>
                        <.icon name="hero-arrow-down-tray" class="w-4 h-4" />
                      <% end %>
                    </button>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <%!-- Disambiguation Modal Component --%>
    <.live_component
      module={MydiaWeb.Live.Components.DisambiguationModalComponent}
      id="disambiguation-modal"
      show={@show_disambiguation_modal}
      matches={@metadata_matches}
      selecting_match_id={@selecting_match_id}
      on_select="select_metadata_match"
      on_cancel="close_disambiguation_modal"
    />

    <%!-- Manual Search Modal Component --%>
    <.live_component
      module={MydiaWeb.Live.Components.ManualSearchModalComponent}
      id="manual-search-modal"
      show={@show_manual_search_modal}
      failed_title={@failed_release_title}
      search_query={@manual_search_query}
      matches={@metadata_matches}
      selecting_match_id={@selecting_match_id}
      on_search="manual_search_submit"
      on_select="select_manual_match"
      on_cancel="close_manual_search_modal"
    />

    <%!-- Retry Modal --%>
    <%= if @show_retry_modal do %>
      <div class="modal modal-open">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">
            <.icon name="hero-exclamation-triangle" class="w-6 h-6 inline text-warning" />
            {gettext("Metadata Provider Error")}
          </h3>
          <p class="text-sm text-base-content/70 mb-2">
            {@retry_error_message}
          </p>
          <p class="text-sm text-base-content/60 mb-4">
            {gettext("This may be a temporary issue. Would you like to try again?")}
          </p>
          <div class="modal-action">
            <button class="btn btn-ghost" phx-click="close_retry_modal">
              {gettext("Cancel")}
            </button>
            <button class="btn btn-primary" phx-click="retry_add_to_library">
              <.icon name="hero-arrow-path" class="w-4 h-4" /> {gettext("Retry")}
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Detail Modal --%>
    <%= if @show_detail_modal && @selected_result do %>
      <div class="modal modal-open">
        <div class="modal-box max-w-3xl">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
            phx-click="close_detail_modal"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
          <h3 class="font-bold text-xl mb-4 pr-8 break-all">
            {@selected_result.title}
          </h3>
          <%!-- Quality and Size Info --%>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="stat bg-base-200 rounded-lg p-4">
              <div class="stat-title text-xs">{gettext("Quality")}</div>
              <div class="stat-value text-base whitespace-normal">
                <span class="badge badge-primary h-auto min-h-5 whitespace-normal break-words rounded-lg text-left leading-snug py-0.5">
                  {get_quality_badge(@selected_result)}
                </span>
              </div>
            </div>
            <div class="stat bg-base-200 rounded-lg p-4">
              <div class="stat-title text-xs">{gettext("Size")}</div>
              <div class="stat-value text-lg font-mono">
                {format_size(@selected_result)}
              </div>
            </div>
            <div class="stat bg-base-200 rounded-lg p-4">
              <%= if @selected_result.download_protocol == :nzb do %>
                <div class="stat-title text-xs">{gettext("Protocol")}</div>
                <div class="stat-value text-lg">
                  <span class="badge badge-info">Usenet</span>
                </div>
              <% else %>
                <div class="stat-title text-xs">{gettext("Health")}</div>
                <div class="stat-value text-lg">
                  <div
                    class={"radial-progress #{health_color(health_score(@selected_result))}"}
                    style={"--value:#{trunc(health_score(@selected_result) * 100)}; --size:4rem; --thickness: 4px;"}
                    role="progressbar"
                  >
                    <span class="text-sm font-semibold">
                      {trunc(health_score(@selected_result) * 100)}%
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="stat bg-base-200 rounded-lg p-4">
              <div class="stat-title text-xs">{gettext("Source")}</div>
              <div class="stat-value text-base">
                <% info_page_url = SearchResult.info_page_url(@selected_result) %>
                <%= if info_page_url do %>
                  <a
                    href={info_page_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="badge badge-outline gap-1 hover:border-primary hover:text-primary transition-colors"
                    title={
                      gettext("View this release on %{indexer}",
                        indexer: @selected_result.indexer
                      )
                    }
                  >
                    {@selected_result.indexer}
                    <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3" />
                  </a>
                <% else %>
                  <span class="badge badge-outline">{@selected_result.indexer}</span>
                <% end %>
              </div>
            </div>
          </div>
          <%!-- Seeders and Leechers - only for torrents --%>
          <%= if @selected_result.download_protocol != :nzb do %>
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="flex items-center gap-3 bg-base-200 rounded-lg p-4">
                <.icon name="hero-arrow-up" class="w-8 h-8 text-success" />
                <div>
                  <div class="text-xs text-base-content/70">{gettext("Seeders")}</div>
                  <div class="text-2xl font-bold text-success">{@selected_result.seeders}</div>
                </div>
              </div>
              <div class="flex items-center gap-3 bg-base-200 rounded-lg p-4">
                <.icon name="hero-arrow-down" class="w-8 h-8 text-primary" />
                <div>
                  <div class="text-xs text-base-content/70">{gettext("Leechers")}</div>
                  <div class="text-2xl font-bold text-primary">{@selected_result.leechers}</div>
                </div>
              </div>
            </div>
          <% end %>
          <%!-- Additional Info --%>
          <div class="space-y-3 mb-6">
            <%!-- Library type indicator - prominent placement --%>
            <% {detail_lib_type, detail_source} = result_type(@result_types, @selected_result) %>
            <div class="flex items-center gap-2 text-sm">
              <.icon
                name={library_type_icon(detail_lib_type)}
                class="w-5 h-5 text-base-content/50"
              />
              <span class="text-base-content/70">{gettext("Downloads to:")}</span>
              <span
                class={["badge gap-1", library_type_badge_class(detail_lib_type)]}
                title={type_source_hint(detail_source)}
              >
                <.icon name={library_type_icon(detail_lib_type)} class="w-4 h-4" />
                {library_type_label(detail_lib_type)}
              </span>
            </div>
            <%= if @selected_result.published_at do %>
              <div class="flex items-center gap-2 text-sm">
                <.icon name="hero-calendar" class="w-5 h-5 text-base-content/50" />
                <span class="text-base-content/70">{gettext("Published:")}</span>
                <span class="font-semibold">{format_date(
                  @selected_result.published_at,
                  @time_display
                )}</span>
              </div>
            <% end %>
            <div class="flex items-center gap-2 text-sm">
              <.icon name="hero-server" class="w-5 h-5 text-base-content/50" />
              <span class="text-base-content/70">{gettext("Indexer:")}</span>
              <span class="font-semibold">{@selected_result.indexer}</span>
            </div>
            <%= if @selected_result.category do %>
              <div class="flex items-center gap-2 text-sm">
                <.icon name="hero-tag" class="w-5 h-5 text-base-content/50" />
                <span class="text-base-content/70">{gettext("Category:")}</span>
                <span class="font-semibold">{@selected_result.category}</span>
              </div>
            <% end %>
          </div>
          <%!-- Actions --%>
          <div class="modal-action flex gap-2">
            <button class="btn btn-ghost" phx-click="close_detail_modal">
              {gettext("Cancel")}
            </button>
            <%= if @current_user && @current_user.role == "guest" do %>
              <%!-- Guest users see a message about using the request system --%>
              <div role="alert" class="alert alert-info flex-1">
                <.icon name="hero-information-circle" class="w-5 h-5" />
                <span class="text-sm">
                  {gettext("Please use the request system to add media to the library")}
                </span>
              </div>
            <% else %>
              <%!-- Admin users can download - close detail modal and open download modal --%>
              <button
                class="btn btn-primary"
                phx-click="show_download_modal"
                phx-value-ref={SearchResultRef.ref(@selected_result)}
              >
                <.icon name="hero-arrow-down-tray" class="w-5 h-5" /> {gettext("Download")}
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Download Modal: type, library and add settings --%>
    <%= if @download_config do %>
      <div
        id="download-modal"
        class="modal modal-open"
        phx-window-keydown="close_download_modal"
        phx-key="Escape"
      >
        <div class="modal-box max-w-lg">
          <button
            type="button"
            class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
            phx-click="close_download_modal"
            aria-label={gettext("Close")}
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
          <h3 class="font-bold text-xl mb-4 flex items-center gap-2">
            <.icon name="hero-arrow-down-tray" class="w-6 h-6 text-primary" /> {gettext(
              "Download"
            )}
          </h3>

          <div class="bg-base-200 rounded-lg p-4 mb-4 min-w-0">
            <div class="font-semibold text-sm break-all" title={@download_config.result.title}>
              {@download_config.result.title}
            </div>
            <div class="text-sm text-base-content/70 mt-1 flex flex-wrap items-center gap-2">
              <span>{format_size(@download_config.result)}</span>
              <%= if is_integer(@download_config.result.category) do %>
                <span class="badge badge-ghost badge-sm">
                  {CategoryMapping.category_name(@download_config.result.category)}
                </span>
              <% end %>
            </div>
          </div>

          <.form
            for={%{}}
            id="download-config-form"
            phx-change="download_config_change"
            phx-submit="confirm_download"
          >
            <%= if @download_config.available_types == [] do %>
              <div role="alert" class="alert alert-warning mb-4">
                <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
                <span class="text-sm">
                  {gettext("No library paths configured.")}
                  <.link navigate={~p"/admin/library-paths"} class="link">
                    {gettext("Configure library paths")}
                  </.link>
                  {gettext("to enable downloads.")}
                </span>
              </div>
            <% else %>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text font-semibold">{pgettext("media type", "Type")}</span>
                </label>
                <div class="join w-full">
                  <%= for type <- @download_config.available_types do %>
                    <input
                      type="radio"
                      name="media_type"
                      value={type}
                      class="join-item btn btn-outline flex-1"
                      aria-label={download_type_label(type)}
                      checked={@download_config.media_type == type}
                    />
                  <% end %>
                </div>
                <%= if is_nil(@download_config.media_type) do %>
                  <span class="label-text-alt text-base-content/60 mt-1">
                    {gettext("Choose a type to continue.")}
                  </span>
                <% end %>
              </div>

              <%= if @download_config.media_type do %>
                <.add_config_fields
                  config={@download_config}
                  quality_profiles={@quality_profiles}
                  show_search_on_add={false}
                />
              <% end %>
            <% end %>

            <div class="modal-action">
              <button type="button" class="btn btn-ghost" phx-click="close_download_modal">
                {gettext("Cancel")}
              </button>
              <button
                type="submit"
                class="btn btn-primary"
                disabled={is_nil(@download_config.media_type)}
              >
                <.icon name="hero-arrow-down-tray" class="w-5 h-5" /> {gettext("Download")}
              </button>
            </div>
          </.form>
        </div>
        <div class="modal-backdrop" phx-click="close_download_modal"></div>
      </div>
    <% end %>
  </div>
</Layouts.app>
