<Layouts.app {assigns}>
  <.admin_page page={:clients} count={length(@download_clients)}>
    <:actions>
      <MydiaWeb.AdminDownloadClientsLive.Components.header_actions />
    </:actions>
    <MydiaWeb.AdminDownloadClientsLive.BuiltInComponents.built_in_panel
      running?={@built_in?}
      status={@built_in_status}
      vpn?={@built_in_vpn?}
      display={@time_display}
      off_reason={@built_in_off_reason}
      enable_locked?={@built_in_enable_locked?}
    />
    <MydiaWeb.AdminDownloadClientsLive.Components.download_clients_tab
      download_clients={@download_clients}
      client_health={@client_health}
    />

    <%!-- Download Client Modal --%>
    <%= if assigns[:show_download_client_modal] do %>
      <MydiaWeb.AdminDownloadClientsLive.DownloadClientModalComponents.download_client_modal
        download_client_form={@download_client_form}
        download_client_mode={@download_client_mode}
        testing_download_client_connection={assigns[:testing_download_client_connection] || false}
        editing_download_client={assigns[:editing_download_client]}
      />
    <% end %>

    <%= if assigns[:show_built_in_settings] do %>
      <MydiaWeb.AdminDownloadClientsLive.BuiltInFormComponents.built_in_settings_modal
        form={@built_in_form}
        section={@built_in_section}
        sources={@built_in_sources}
        saved_secrets={@built_in_saved_secrets}
        replacing={@built_in_replacing}
        typed_secrets={@built_in_typed_secrets}
        confirm={@built_in_confirm}
        preflight={@built_in_preflight}
        env_vpn_names={@built_in_env_vpn_names}
      />
    <% end %>

    <%= if assigns[:pending_delete_download_client] do %>
      <MydiaWeb.AdminDownloadClientsLive.Components.delete_download_client_modal
        client={@pending_delete_download_client}
        count={assigns[:pending_delete_download_count] || 0}
      />
    <% end %>
  </.admin_page>
</Layouts.app>
