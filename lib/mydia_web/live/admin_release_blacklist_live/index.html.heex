<Layouts.app {assigns}>
  <.admin_page page={:release_blacklist} count={@total_count}>
    <MydiaWeb.AdminReleaseBlacklistLive.Components.blacklist_tab
      rows={@rows}
      total_count={@total_count}
      page={@page}
      page_size={@page_size}
      failure_reasons={@failure_reasons}
      failure_reason_filter={@failure_reason_filter}
    />
  </.admin_page>
</Layouts.app>
