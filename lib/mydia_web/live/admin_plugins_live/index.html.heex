<Layouts.app {assigns}>
  <.admin_page page={:plugins} count={length(@installed)}>
    <:actions>
      <MydiaWeb.AdminPluginsLive.Components.header_actions browsing?={
        @browsing? and @show_plugin_store_modal
      } />
    </:actions>
    <MydiaWeb.AdminPluginsLive.Components.plugins_tab
      installed={@installed}
      updates={@updates}
    />

    <%!-- Store modal: always opens on Browse store; hidden while an approval is open --%>
    <%= if assigns[:show_plugin_store_modal] and is_nil(@approval) do %>
      <MydiaWeb.AdminPluginsLive.ModalComponents.store_modal browse={@browse} />
    <% end %>

    <%!-- Capability approval modal (the emphasized surface) --%>
    <%= if @approval do %>
      <MydiaWeb.AdminPluginsLive.ModalComponents.approval_modal approval={@approval} />
    <% end %>

    <%!-- Per-plugin detail modal: granted caps + host grants --%>
    <%= if @detail do %>
      <MydiaWeb.AdminPluginsLive.ModalComponents.detail_modal detail={@detail} />
    <% end %>

    <%!-- Dedicated logs modal: activity log + network requests + test --%>
    <%= if @logs do %>
      <MydiaWeb.AdminPluginsLive.LogsModalComponents.logs_modal
        logs={@logs}
        log_rows={@streams.plugin_logs}
        net_rows={@streams.plugin_net}
      />
    <% end %>

    <%!-- Operator settings modal (host-granting config) --%>
    <%= if @settings do %>
      <MydiaWeb.AdminPluginsLive.ModalComponents.settings_modal settings={@settings} />
    <% end %>
  </.admin_page>
</Layouts.app>
