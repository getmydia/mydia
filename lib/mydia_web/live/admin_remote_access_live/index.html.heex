<Layouts.app {assigns}>
  <.admin_page page={:remote_access}>
    <MydiaWeb.AdminRemoteAccessLive.Components.remote_access_panel
      ra_config={@ra_config}
      remote_access_setting={@remote_access_setting}
      remote_access_source={@remote_access_source}
      remote_access_locked={@remote_access_locked}
      p2p_status={@p2p_status}
    />
    <%= if assigns[:show_direct_url_modal] do %>
      <MydiaWeb.AdminRemoteAccessLive.Components.direct_url_modal direct_url={@direct_url} />
    <% end %>
  </.admin_page>
</Layouts.app>
