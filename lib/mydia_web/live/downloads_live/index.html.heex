<Layouts.app {assigns}>
  <div class="flex flex-col h-full">
    <%!-- Header --%>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold">{@page_title}</h1>
        <p class="text-base-content/70 mt-1">
          {gettext("Monitor active downloads and troubleshoot issues")}
        </p>
      </div>

      <%!-- Utility actions --%>
      <div class="flex gap-2">
        <ListComponents.client_shortcut client_urls={@client_urls} />
        <button type="button" class="btn btn-sm btn-ghost" phx-click="refresh">
          <.icon name="hero-arrow-path" class="w-4 h-4" />
          <span class="hidden sm:inline ml-1">{gettext("Refresh")}</span>
        </button>
        <%= if (@active_tab == :downloads and not @downloads_empty?) or
                 (@active_tab == :issues and @selectable_issues?) do %>
          <button
            id="downloads-select"
            type="button"
            class="btn btn-sm btn-primary"
            phx-click="toggle_select_all"
          >
            <%= cond do %>
              <% @selection_mode and MapSet.size(@selected_ids) > 0 -> %>
                <.icon name="hero-x-mark" class="w-4 h-4" />
                <span class="hidden sm:inline ml-1">{gettext("Cancel")}</span>
              <% @selection_mode -> %>
                <.icon name="hero-check" class="w-4 h-4" />
                <span class="hidden sm:inline ml-1">{pgettext("selection", "Select All")}</span>
              <% true -> %>
                <.icon name="hero-check-circle" class="w-4 h-4" />
                <span class="hidden sm:inline ml-1">{pgettext("selection", "Select")}</span>
            <% end %>
          </button>
        <% end %>
        <%!-- Rare, destructive actions. daisyUI's popover dropdown: the native
              popover API puts the menu in the top layer (no z-index or
              stacking-context fights) and CSS anchor positioning places it;
              browsers without anchor positioning get daisyUI's centred
              fallback. phx-update="ignore" keeps refresh ticks from replacing
              an open menu. --%>
        <button
          id="downloads-more"
          type="button"
          class="btn btn-sm btn-ghost btn-square"
          popovertarget="downloads-more-menu"
          style="anchor-name:--downloads-more"
          aria-label={gettext("More actions")}
          title={gettext("More actions")}
        >
          <.icon name="hero-ellipsis-horizontal" class="size-4" />
        </button>
        <ul
          id="downloads-more-menu"
          popover
          phx-update="ignore"
          class="dropdown dropdown-end menu w-56 rounded-box bg-base-100 border border-base-300 p-2 shadow-lg"
          style="position-anchor:--downloads-more"
        >
          <li>
            <button
              id="downloads-clear-completed"
              type="button"
              popovertarget="downloads-more-menu"
              popovertargetaction="hide"
              phx-click="open_clear_completed_modal"
            >
              <.icon name="hero-trash" class="size-4" /> {gettext("Clear completed…")}
            </button>
          </li>
        </ul>
      </div>
    </div>

    <ListComponents.stats_bar summary={@summary} display={@time_display} />

    <ListComponents.tab_bar tabs={@tabs} active={@active_tab}>
      <div id="downloads-toolbar" class="flex flex-wrap items-center gap-2 mb-3">
        <.segmented_control
          :if={@active_tab == :downloads}
          id="downloads-view"
          value={@view}
          event="set_view"
          param="view"
          label={gettext("Which downloads to show")}
        >
          <:option
            value={:active}
            label={pgettext("download", "Active")}
            id="downloads-view-active"
          />
          <:option
            value={:imported}
            label={pgettext("download", "Imported")}
            id="downloads-view-imported"
          />
          <:option value={:all} label={gettext("All")} id="downloads-view-all" />
        </.segmented_control>
        <ListComponents.filter_bar
          filters={@filters}
          clients={@client_options}
          show_status?={@active_tab == :downloads and @view == :active}
        >
          <:extra :if={@active_tab == :issues}>
            <IssueComponents.kind_filter counts={@issue_counts} selected={@filters.kind} />
          </:extra>
        </ListComponents.filter_bar>
        <form
          :if={@active_tab == :downloads and not @downloads_empty?}
          phx-change="sort"
          id="downloads-sort-form"
          class="sm:ml-auto"
        >
          <label class="sr-only" for="downloads-sort">
            {gettext("Sort downloads")}
          </label>
          <select
            id="downloads-sort"
            name="sort_by"
            class="select select-sm w-full sm:w-auto"
            title={gettext("Sort downloads")}
          >
            <option
              :for={{value, label} <- Sorting.options(@view)}
              value={value}
              selected={@sort_by == value}
            >
              {label}
            </option>
          </select>
        </form>
      </div>

      <ListComponents.active_filters filters={@filters} />

      <%!-- Batch action bar --%>
      <%= if MapSet.size(@selected_ids) > 0 do %>
        <%!-- Below lg the sticky #mobile-header (z-30) sits at top-0, so sit under it: max(navbar min-h 4rem, 0.5rem pad + 2.5rem btn + 0.5rem + safe-area inset) --%>
        <div
          id="downloads-batch-bar"
          class="alert alert-soft sticky top-[max(4rem,calc(3.5rem+env(safe-area-inset-top,0px)))] lg:top-0 z-10 mb-4 shadow-lg"
        >
          <div class="flex-1">
            <span class="font-semibold">
              {pngettext(
                "selection count",
                "%{count} selected",
                "%{count} selected",
                MapSet.size(@selected_ids)
              )}
            </span>
          </div>
          <div class="join">
            <%= if @active_tab == :issues do %>
              <button
                id="downloads-batch-retry"
                type="button"
                class="btn btn-sm btn-primary join-item"
                phx-click="batch_retry"
              >
                <.icon name="hero-arrow-path" class="w-4 h-4" /> {gettext("Retry")}
              </button>
              <button
                id="downloads-batch-dismiss"
                type="button"
                class="btn btn-sm join-item"
                phx-click="batch_dismiss"
                data-confirm={gettext("Dismiss selected issues?")}
              >
                <.icon name="hero-x-mark" class="w-4 h-4" /> {gettext("Dismiss")}
              </button>
            <% else %>
              <button
                id="downloads-batch-delete"
                type="button"
                class="btn btn-sm btn-error join-item"
                phx-click="batch_delete"
                data-confirm={gettext("Delete selected downloads?")}
              >
                <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Delete")}
              </button>
            <% end %>
            <button type="button" class="btn btn-sm join-item" phx-click="toggle_select_all">
              {pgettext("selection", "Clear")}
            </button>
          </div>
        </div>
      <% end %>

      <%!-- A client too busy to answer in time: rows show its last known status --%>
      <div
        :if={@stale_status}
        id="client-busy-notice"
        role="status"
        class="alert alert-info alert-soft mb-4 text-sm"
      >
        <.icon name="hero-clock" class="size-4 shrink-0" />
        <span>
          {gettext("%{client} is busy, showing status from %{age}.",
            client: @stale_status.client,
            age: status_age(@stale_status.as_of, @time_display)
          )}
        </span>
      </div>

      <%!-- Empty state --%>
      <%= if @downloads_empty? do %>
        <%= cond do %>
          <% ListView.active?(@filters) -> %>
            <ListComponents.empty_state
              icon="hero-funnel"
              title={gettext("No downloads match")}
              description={gettext("Try a different search or clear the filters.")}
            >
              <:action>
                <button
                  type="button"
                  id="downloads-empty-clear-filters"
                  class="btn btn-sm btn-primary"
                  phx-click="clear_filters"
                >
                  {pgettext("filters", "Clear filters")}
                </button>
              </:action>
            </ListComponents.empty_state>
          <% @active_tab == :issues -> %>
            <ListComponents.empty_state
              :if={@removed_client_groups == []}
              icon="hero-check-circle"
              title={gettext("No issues")}
              description={gettext("All downloads completed successfully")}
            />
          <% @active_tab == :external -> %>
            <ListComponents.empty_state
              icon="hero-inbox-stack"
              title={gettext("Nothing unmanaged")}
              description={
                gettext("Torrents in your clients that Mydia does not manage will appear here")
              }
            />
          <% @view == :imported -> %>
            <ListComponents.empty_state
              icon="hero-check-circle"
              title={gettext("No imported downloads")}
              description={gettext("Imported downloads that are still seeding will appear here")}
            />
          <% @view == :all -> %>
            <ListComponents.empty_state
              icon="hero-arrow-down-tray"
              title={gettext("No downloads")}
              description={
                gettext("Nothing is downloading and nothing imported is still in your clients")
              }
            />
          <% true -> %>
            <ListComponents.empty_state
              icon="hero-arrow-down-tray"
              title={gettext("Queue is empty")}
              description={gettext("No downloads currently in progress")}
            />
        <% end %>
      <% end %>

      <%!-- Downloads list --%>
      <%= if @active_tab == :downloads do %>
        <ul
          id="downloads-list"
          phx-update="stream"
          phx-viewport-bottom="load_more"
          class="list"
        >
          <li
            :for={{id, download} <- @streams.downloads}
            id={id}
            class={[
              "list-row items-center gap-3 py-2.5 hover:bg-base-300/40 transition-colors",
              removing?(download) && "opacity-60"
            ]}
          >
            <%!-- Checkbox (only shown in selection mode) --%>
            <div class={[
              "transition-all",
              (@selection_mode && "w-auto opacity-100") || "w-0 opacity-0 overflow-hidden"
            ]}>
              <input
                type="checkbox"
                class="checkbox checkbox-primary checkbox-sm"
                checked={is_selected?(assigns, download.id)}
                phx-click="toggle_select"
                phx-value-id={download.id}
                disabled={not @selection_mode}
              />
            </div>
            <%!-- Content --%>
            <div class="list-col-grow min-w-0">
              <% import_issue = import_issue(download) %>
              <% kind = ListView.row_kind(download) %>
              <%!-- Line 1: status dot + title + episode --%>
              <div class="flex items-center gap-2 min-w-0">
                <% {_badge_class, status_label} = status_badge(download) %>
                <% dot_label =
                  if(import_issue, do: import_issue_label(import_issue), else: status_label) %>
                <span
                  class={[
                    "status status-md shrink-0",
                    row_status_dot_class(download, import_issue)
                  ]}
                  title={dot_label}
                  aria-label={dot_label}
                ></span>
                <% media_item_id = ListView.media_item_id(download) %>
                <.link
                  :if={media_item_id}
                  navigate={~p"/media/#{media_item_id}"}
                  id={"download-title-link-#{download.id}"}
                  class="link link-hover font-medium text-sm truncate min-w-0"
                >
                  {get_display_title(download)}
                </.link>
                <span :if={is_nil(media_item_id)} class="font-medium text-sm truncate min-w-0">
                  {get_display_title(download)}
                </span>
                <%!-- shrink-[4], not shrink-0: a long episode name gives way
                   before the show title, which otherwise truncated to nothing. --%>
                <%= if get_episode_details(download) do %>
                  <.link
                    :if={media_item_id}
                    navigate={~p"/media/#{media_item_id}"}
                    class="link link-hover text-xs text-base-content/50 shrink-[4] min-w-0 truncate"
                  >
                    {get_episode_details(download)}
                  </.link>
                  <span
                    :if={is_nil(media_item_id)}
                    class="text-xs text-base-content/50 shrink-[4] min-w-0 truncate"
                  >
                    {get_episode_details(download)}
                  </span>
                <% end %>
                <%!-- Mydia did not add this one. Neutral styling on purpose:
                    adoption is intended behaviour, not a problem. --%>
                <%= if adopted_from_client?(download) do %>
                  <span
                    class="badge badge-ghost badge-xs shrink-0"
                    data-test="adopted-badge"
                    title={
                      gettext(
                        "Mydia did not add this torrent. It was already in the download client and matched to your library."
                      )
                    }
                  >
                    {gettext("Added outside Mydia")}
                  </span>
                <% end %>
                <span
                  :if={removing?(download)}
                  id={"removing-#{download.id}"}
                  class="badge badge-ghost badge-xs shrink-0 gap-1"
                >
                  <span class="loading loading-spinner loading-xs"></span> {gettext("Removing…")}
                </span>
              </div>
              <%!-- Line 2: release title (muted), only when it differs from the display title --%>
              <%= if get_display_title(download) != download.title do %>
                <div class="tooltip tooltip-bottom max-w-full block" data-tip={download.title}>
                  <button
                    type="button"
                    class="block max-w-full truncate text-left text-xs text-base-content/40 hover:text-base-content/70 cursor-pointer transition-colors"
                    phx-click="open_details"
                    phx-value-id={download.id}
                  >
                    {download.title}
                  </button>
                </div>
              <% end %>
              <%!-- Import problem: surfaced even when the torrent client reports the
                 download as seeding/completed, so a silently-failing import is
                 visible without digging into the Issues tab. --%>
              <%= if import_issue do %>
                <div class="text-xs text-error flex flex-wrap items-center gap-1.5 mt-0.5">
                  <.icon name="hero-exclamation-triangle" class="size-3 shrink-0" />
                  <span
                    class="tooltip tooltip-bottom min-w-0"
                    data-tip={download.import_last_error}
                  >
                    <span class="truncate block">
                      {import_issue_label(import_issue)}: {download.import_last_error}
                    </span>
                  </span>
                  <%= if download.import_retry_count && download.import_retry_count > 0 do %>
                    <span>•</span>
                    <span class="shrink-0">
                      {gettext("Attempt #%{count}", count: download.import_retry_count)}
                    </span>
                  <% end %>
                  <%= if download.import_next_retry_at do %>
                    <span>•</span>
                    <span class="shrink-0">
                      {gettext("Next retry: %{time}",
                        time: format_next_retry(download.import_next_retry_at)
                      )}
                    </span>
                  <% end %>
                </div>
              <% end %>
              <%= if download.removal_error do %>
                <div
                  id={"removal-error-#{download.id}"}
                  class="text-xs text-error flex items-center gap-1.5 mt-0.5"
                >
                  <.icon name="hero-exclamation-triangle" class="size-3 shrink-0" />
                  <span class="truncate">
                    {gettext("Couldn't remove from %{client}: %{error}",
                      client: download.download_client,
                      error: download.removal_error
                    )}
                  </span>
                </div>
              <% end %>
              <%!-- Soft-stall: a recoverable warning. import_issue is nil here
                 (a soft-stall never sets import_failed_at), so this is a
                 sibling of the block above, not an alternative to it. This is
                 the only place the give-up rule is visible while the operator
                 can still change the outcome. --%>
              <%= if soft_stalled?(download) and not removing?(download) do %>
                <div class="text-xs text-warning flex flex-wrap items-center gap-1.5 mt-0.5">
                  <%!-- Icon and text share a non-wrapping line so the icon
                     never sits alone above a wrapped sentence. --%>
                  <div class="flex items-start gap-1.5 basis-full">
                    <.icon name="hero-clock" class="size-3 shrink-0 mt-0.5" />
                    <%= if download.auto_reject_capped? do %>
                      <span id={"stall-capped-#{download.id}"}>
                        {gettext(
                          "No progress for %{duration}. Mydia has stopped replacing stalled releases for this title. Cancelling will block this release.",
                          duration: format_duration(stall_elapsed_seconds(download))
                        )}
                      </span>
                    <% else %>
                      <span>
                        {gettext(
                          "No progress for %{duration}. If nothing changes in the next %{remaining}, Mydia will remove it and search for a different release.",
                          duration: format_duration(stall_elapsed_seconds(download)),
                          remaining:
                            format_duration(stall_remaining_seconds(download, @stall_grace_map))
                        )}
                      </span>
                    <% end %>
                  </div>
                  <button
                    type="button"
                    id={"stall-reject-#{download.id}"}
                    class="btn btn-xs btn-warning btn-outline shrink-0"
                    phx-click="reject_release"
                    phx-value-id={download.id}
                  >
                    {gettext("Remove and find another")}
                  </button>
                  <button
                    type="button"
                    id={"stall-keep-waiting-#{download.id}"}
                    class="btn btn-xs btn-ghost shrink-0"
                    phx-click="keep_waiting"
                    phx-value-id={download.id}
                  >
                    {gettext("Keep waiting")}
                  </button>
                </div>
              <% end %>
              <%!-- Line 3: compact metadata cluster (every metric carries an icon) --%>
              <div class="flex items-center gap-x-3 gap-y-1 flex-wrap mt-1 text-xs text-base-content/60">
                <% quality_str = Quality.format(get_metadata_value(download, "quality")) %>
                <span
                  :if={quality_str && quality_str != ""}
                  class="badge badge-ghost badge-sm whitespace-nowrap"
                >
                  {quality_str}
                </span>
                <% protocol = format_protocol(get_metadata_value(download, "download_protocol")) %>
                <span :if={protocol} class="badge badge-ghost badge-sm">{protocol}</span>

                <%= if kind == :queue do %>
                  <span class="inline-flex items-center gap-1" title={gettext("Download speed")}>
                    <.icon name="hero-arrow-down-tray" class="size-3 opacity-70" />{format_speed(
                      download.download_speed
                    )}
                  </span>
                  <span
                    class="inline-flex items-center gap-1 tabular-nums"
                    title={gettext("Size")}
                  >
                    <.icon name="hero-circle-stack" class="size-3 opacity-70" />{format_file_size(
                      download.size
                    )}
                  </span>
                  <span class="inline-flex items-center gap-1" title={gettext("Time remaining")}>
                    <.icon name="hero-clock" class="size-3 opacity-70" />{format_eta(download.eta)}
                  </span>
                  <span
                    :if={get_metadata_value(download, "seeders")}
                    class="inline-flex items-center gap-1"
                    title={gettext("Seeders")}
                  >
                    <.icon name="hero-users" class="size-3 opacity-70" />{get_metadata_value(
                      download,
                      "seeders"
                    )}
                  </span>
                <% end %>
                <%= if kind == :completed do %>
                  <span class="inline-flex items-center gap-1" title={gettext("Upload speed")}>
                    <.icon name="hero-arrow-up-tray" class="size-3 opacity-70" />{format_speed(
                      download.upload_speed
                    )}
                  </span>
                  <span class="inline-flex items-center gap-1" title={gettext("Share ratio")}>
                    <.icon name="hero-scale" class="size-3 opacity-70" />{format_ratio(
                      download.ratio
                    )}
                  </span>
                  <span
                    class="inline-flex items-center gap-1 tabular-nums"
                    title={gettext("Size")}
                  >
                    <.icon name="hero-circle-stack" class="size-3 opacity-70" />{format_file_size(
                      download.size
                    )}
                  </span>
                  <span
                    :if={download.imported_at}
                    class="inline-flex items-center gap-1 text-success/80"
                    title={pgettext("download", "Imported")}
                  >
                    <.icon name="hero-check-circle" class="size-3" />{format_relative_time(
                      download.imported_at,
                      @time_display
                    )}
                  </span>
                <% end %>
                <MydiaWeb.SeedingComponents.seeding_chip
                  id={"download-seeding-#{download.id}"}
                  download={download}
                />
                <ListComponents.client_chip
                  :if={download.download_client}
                  id={"download-client-#{download.id}"}
                  name={download.download_client}
                  url={@client_urls[download.download_client]}
                />
              </div>
              <%!-- Line 4: thin inline progress (in-flight rows only) --%>
              <%= if kind == :queue do %>
                <div class="flex items-center gap-2 mt-1.5">
                  <%= if progress_indeterminate?(download) do %>
                    <%!-- No measurable %: animated bar + phase label, not a frozen 0% --%>
                    <% {_class, phase_label} = status_badge(download) %>
                    <progress class="progress h-1.5 flex-1"></progress>
                    <span class="text-xs text-base-content/60 shrink-0 whitespace-nowrap w-16 text-right">
                      {phase_label}
                    </span>
                  <% else %>
                    <progress
                      class={[
                        "progress h-1.5 flex-1",
                        if(soft_stalled?(download),
                          do: "progress-warning",
                          else: "progress-primary"
                        )
                      ]}
                      value={format_progress(download.progress)}
                      max="100"
                    ></progress>
                    <span class="text-xs tabular-nums text-base-content/70 shrink-0 whitespace-nowrap w-12 text-right">
                      {format_progress(download.progress)}%
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%!-- Action buttons --%>
            <%!-- Below sm the strip takes its own grid row, so it stops
                 squeezing the content column to half the screen. --%>
            <ListComponents.download_actions
              :if={not removing?(download)}
              download={download}
              tab={ListView.row_kind(download)}
              class="max-sm:row-start-2 max-sm:col-span-full max-sm:justify-end max-sm:-mt-2"
            />
          </li>
        </ul>

        <%!-- Loading indicator for infinite scroll --%>
        <%= if @has_more do %>
          <div class="flex justify-center py-4">
            <span class="loading loading-dots loading-md text-primary"></span>
          </div>
        <% end %>
      <% end %>

      <%!-- Issues tab: one list of every issue, filtered by the kind chips --%>
      <%= if @active_tab == :issues do %>
        <div class="flex flex-col gap-3">
          <IssueComponents.removed_client_alert
            :for={group <- @removed_client_groups}
            group={group}
          />
          <ul id="issues-list" phx-update="stream" class="list">
            <IssueComponents.issue_row
              :for={{dom_id, issue} <- @streams.issues}
              id={dom_id}
              issue={issue}
              selection_mode={@selection_mode}
              selected?={MapSet.member?(@selected_ids, issue.id)}
              client_url={@client_urls[issue.client]}
              search_open?={@search_open_for == issue.id}
              library_search_value={@library_search_value}
              library_search_results={@library_search_results}
            />
          </ul>
        </div>
      <% end %>

      <%!-- External tab: torrents in the clients that Mydia does not manage --%>
      <%= if @active_tab == :external do %>
        <div class="flex flex-col gap-4">
          <div id="external-intro" role="note" class="alert alert-info alert-soft">
            <.icon name="hero-information-circle" class="size-5 shrink-0" />
            <span class="text-sm">
              {gettext(
                "Torrents in your download clients that Mydia does not manage. They are not tracked and nothing is imported from them."
              )}
            </span>
            <button
              id="external-rescan"
              type="button"
              class="btn btn-sm btn-ghost shrink-0"
              phx-click="rescan_external"
            >
              <.icon name="hero-arrow-path" class="size-4" /> {gettext("Rescan")}
            </button>
          </div>

          <%= if @scan.failed_clients != [] do %>
            <div id="external-failed-clients" class="alert alert-warning">
              <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
              <span>
                {gettext("Could not read %{clients}. This list may be incomplete.",
                  clients: Enum.join(@scan.failed_clients, ", ")
                )}
              </span>
            </div>
          <% end %>

          <ul
            id="external-torrents"
            phx-update="stream"
            class="list"
          >
            <li :for={{id, torrent} <- @streams.external_torrents} id={id} class="list-row py-3">
              <div class="list-col-grow">
                <div class="font-medium text-sm truncate">{torrent.title}</div>
                <div class="text-xs opacity-60 flex items-center gap-1.5 mt-0.5">
                  <span class="badge badge-xs badge-ghost">
                    {ListView.torrent_status_label(torrent.status)}
                  </span>
                  <span>{torrent.client_name}</span>
                  <%= if torrent.status in [:downloading, :seeding] do %>
                    <span>•</span>
                    <span>{format_progress(torrent.progress)}%</span>
                  <% end %>
                  <%!-- Without this, a plainly matchable release sitting here
                      untouched gives no clue whether Mydia skipped it on
                      purpose or failed at something. --%>
                  <%= if torrent.excluded_by_policy do %>
                    <span>•</span>
                    <span title={
                      gettext(
                        "This client's External torrents setting tells Mydia not to adopt it"
                      )
                    }>
                      {gettext("Not adopted by client setting")}
                    </span>
                  <% end %>
                </div>
                <%= if @search_open_for == torrent.id do %>
                  <MydiaWeb.Live.Components.LibrarySearchForm.library_search_form
                    search_value={@library_search_value}
                    search_results={@library_search_results}
                    on_search="library_search"
                    on_select="adopt_library_match"
                    download_id={torrent.id}
                  />
                <% end %>
              </div>
              <div class="flex gap-1">
                <button
                  type="button"
                  class="btn btn-square btn-ghost btn-sm"
                  phx-click="toggle_search"
                  phx-value-id={torrent.id}
                  title={gettext("Search library to match")}
                >
                  <.icon name="hero-magnifying-glass" class="size-4" />
                </button>
              </div>
            </li>
          </ul>
        </div>
      <% end %>
    </ListComponents.tab_bar>

    <%!-- Clear Completed modal (with opt-in delete-from-disk) --%>
    <.modal
      id="clear-completed-modal"
      show={@show_clear_modal}
      on_cancel="close_clear_completed_modal"
    >
      <:title>{gettext("Clear completed downloads")}</:title>
      <form
        id="clear-completed-form"
        phx-change="toggle_delete_files"
        phx-submit="clear_completed"
      >
        <p class="text-base-content/80">
          {ngettext(
            "This clears %{count} completed download from the queue and removes it from the download client.",
            "This clears %{count} completed downloads from the queue and removes them from the download client.",
            @clearable_count
          )}
        </p>
        <label class="label cursor-pointer justify-start gap-3 mt-4">
          <input
            type="checkbox"
            name="delete_files"
            value="true"
            checked={@delete_files}
            class="checkbox checkbox-error"
          />
          <span class="label-text">
            {gettext("Also permanently delete the downloaded files from disk")}
          </span>
        </label>
        <p :if={@delete_files} class="text-error text-sm mt-2 flex items-center gap-1">
          <.icon name="hero-exclamation-triangle" class="w-4 h-4" />
          {ngettext(
            "This permanently deletes files for %{count} download from disk. This cannot be undone.",
            "This permanently deletes files for %{count} downloads from disk. This cannot be undone.",
            @clearable_count
          )}
        </p>
      </form>
      <:actions>
        <button type="button" class="btn btn-ghost" phx-click="close_clear_completed_modal">
          {gettext("Cancel")}
        </button>
        <button
          type="submit"
          form="clear-completed-form"
          class={["btn", (@delete_files && "btn-error") || "btn-primary"]}
        >
          {if @delete_files,
            do: gettext("Clear and Delete Files"),
            else: gettext("Clear Completed")}
        </button>
      </:actions>
    </.modal>

    <%!-- Match / re-match modal (in-flight correction + post-import re-match) --%>
    <Components.match_modal :if={@match_modal} dialog={@match_modal} />

    <%!-- Match files modal (manual file matching on import failure) --%>
    <Components.match_files_modal
      :if={@match_files_modal}
      modal={@match_files_modal}
      error={@match_files_error}
    />

    <%!-- Detail drawer (?download=<id>) --%>
    <DetailDrawer.detail_drawer
      :if={@drawer_download}
      download={@drawer_download}
      tab={ListView.row_kind(@drawer_download)}
      display={@time_display}
      client_url={@client_urls[@drawer_download.download_client]}
    />
  </div>
</Layouts.app>
