<Layouts.app {assigns}>
  <%!-- Page Container --%>
  <div class="relative mb-4">
    <%!-- Backdrop. Anchored to the viewport, not to this wrapper.

          Sized `absolute inset-0` this layer's containing block was the
          wrapper below, which holds the entire page grid. `object-cover` in a
          box 3000 to 4000px tall upscaled the art about 3x, the gradient was
          stretched over that same height so it never finished, and both layers
          stopped at the wrapper's bottom edge, wherever the content happened to
          end. That edge is the hard cutoff line reported in discussion #642.

          Keep this OUTSIDE the `@container` element below. `container-type:
          inline-size` establishes a containing block for fixed descendants, so
          moving it in there turns `fixed` back into `absolute` with no error
          and no visible clue until the cutoff returns. --%>
    <%= if backdrop_url = get_backdrop_url(@media_item) do %>
      <div
        id="page-backdrop"
        class="fixed inset-0 lg:left-64 overflow-hidden pointer-events-none"
        aria-hidden="true"
      >
        <img src={backdrop_url} alt="" class="w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-b from-transparent from-0% via-base-200/85 via-35% to-base-200 to-60%">
        </div>
      </div>
    <% end %>
    <%!-- @container, not a viewport breakpoint. `xl:` measures the window, but
          this page never gets the window: `Layouts.app/1`'s sidebar is a hard
          w-64 that is always open at lg and up. Measured, `xl:` turned the
          third column on with 225px left for the main content column at a
          1280px window, narrower than either rail, and the title's action
          buttons overflowed it by 78px so two of the four landed underneath
          this very rail.

          `container-type: inline-size` queries this element's CONTENT box,
          which is exactly the grid's available width, so the sidebar is
          accounted for by construction rather than by a magic number, and the
          layout stays correct if the sidebar ever gains a collapsed state.
          @7xl is the stock 80rem container size: 1280px of grid, which is a
          roughly 1616px window with the sidebar open. Measured main content
          column: 597px at the threshold, 897px at 1920.

          The md: and lg: templates below stay viewport queries on purpose.
          Below lg the sidebar is a closed drawer taking no width, so the
          window is the right measurement there; only the third-column
          decision is the one the sidebar's 256px distorts.

          Containment does not trap page content under the sidebar's z-40.
          Measured with container-type: inline-size on this element, both a
          plain z-50 element and a daisyUI dropdown-content z-50 still win
          elementFromPoint over the sidebar, identically to the uncontained
          control.

          At @7xl the grid is bound to the viewport and each column scrolls on
          its own (overflow-y-auto, overscroll-contain), instead of the side
          columns riding the page scroll until they pin. 9rem is the vertical
          chrome around the grid at that width: main's lg:p-8 top and bottom,
          this wrapper's lg:pt-8 and pb-8, and the outer mb-4 (32 * 4 + 16), so
          the page itself has nothing left to scroll. A changelog banner above
          adds its own height, which the page then scrolls by. Below @7xl
          nothing changes: the hero pins from md and History is a full-width
          row. --%>
    <div class="@container relative pt-5 sm:pt-4 md:pt-10 lg:pt-8 pb-8">
      <div
        id="page-grid"
        class={[
          "grid gap-4 md:gap-6 grid-cols-1 md:grid-cols-[16rem_minmax(0,1fr)] lg:grid-cols-[20rem_minmax(0,1fr)]",
          "@7xl:h-[calc(100dvh-9rem)] @7xl:grid-rows-[minmax(0,1fr)]",
          if(@timeline_events == [],
            do: "@7xl:grid-cols-[20rem_minmax(0,1fr)]",
            else: "@7xl:grid-cols-[20rem_minmax(0,1fr)_20rem]"
          )
        ]}
      >
        <%!-- Left Column: Hero Section (Poster & Quick Actions) --%>
        <Components.hero_section
          media_item={@media_item}
          player_enabled={@player_enabled}
          next_episode={@next_episode}
          next_episode_state={@next_episode_state}
          auto_searching={@auto_searching}
          downloads_with_status={@downloads_with_status}
          quality_profiles={@quality_profiles}
          default_quality_profile_name={@default_quality_profile_name}
          is_favorite={@is_favorite}
          item_collections={@item_collections}
          user_collections={@user_collections}
          target_library={@target_library}
          target_reason={@target_reason}
          target_library_candidates={@target_library_candidates}
        />
        <%!-- Right Column: Main Content --%>
        <div id="main-column" class="min-w-0 @7xl:overflow-y-auto @7xl:overscroll-contain">
          <%!-- Title and Basic Info --%>
          <div class="mb-4 md:mb-6">
            <div class="flex items-start justify-between gap-2 md:gap-4 mb-2">
              <div class="min-w-0">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold">{@media_item.title}</h1>
                <div
                  :if={
                    @media_item.type == "tv_show" && @media_item.metadata_source_pinned &&
                      @media_item.metadata_source in [:tmdb, :tvdb]
                  }
                  id="metadata-source-pinned-badge"
                  class="tooltip tooltip-bottom mt-1"
                  data-tip={
                    gettext("Refresh keeps this show on this provider. Use Fix match to move it.")
                  }
                >
                  <span class="badge badge-outline badge-sm gap-1">
                    <.icon name="hero-lock-closed" class="w-3 h-3" />
                    {gettext("%{provider} (pinned)",
                      provider:
                        case @media_item.metadata_source do
                          :tmdb -> "TMDB"
                          :tvdb -> "TVDB"
                        end
                    )}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-0.5 flex-shrink-0">
                <div class="tooltip tooltip-bottom" data-tip={gettext("Refresh metadata")}>
                  <button
                    type="button"
                    phx-click="refresh_metadata"
                    class="btn btn-ghost btn-sm 2xl:btn-md btn-square"
                  >
                    <.icon name="hero-arrow-path" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                  </button>
                </div>
                <div class="tooltip tooltip-bottom" data-tip={gettext("Fix match")}>
                  <button
                    id="fix-match-button"
                    type="button"
                    phx-click="open_fix_match"
                    class="btn btn-ghost btn-sm 2xl:btn-md btn-square"
                    aria-label={gettext("Fix match: this is the wrong title")}
                  >
                    <.icon name="hero-magnifying-glass" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                  </button>
                </div>
                <%= if @media_item.type == "tv_show" && has_media_files?(@media_item) do %>
                  <div class="tooltip tooltip-bottom" data-tip={gettext("Re-scan files")}>
                    <button
                      type="button"
                      phx-click="rescan_series"
                      class="btn btn-ghost btn-sm 2xl:btn-md btn-square"
                    >
                      <.icon name="hero-folder-arrow-down" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                    </button>
                  </div>
                <% end %>
                <%= if @media_item.type == "movie" && has_media_files?(@media_item) do %>
                  <div class="tooltip tooltip-bottom" data-tip={gettext("Re-scan files")}>
                    <button
                      type="button"
                      phx-click="rescan_movie"
                      class="btn btn-ghost btn-sm 2xl:btn-md btn-square"
                    >
                      <.icon name="hero-folder-arrow-down" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                    </button>
                  </div>
                <% end %>
                <%= if has_media_files?(@media_item) do %>
                  <div class="tooltip tooltip-bottom" data-tip={gettext("Rename files")}>
                    <button
                      id="rename-files-button"
                      type="button"
                      phx-click="show_rename_modal"
                      class="btn btn-ghost btn-sm 2xl:btn-md btn-square"
                      aria-label={gettext("Rename files")}
                    >
                      <.icon name="hero-document-text" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                    </button>
                  </div>
                <% end %>
                <div class="tooltip tooltip-bottom" data-tip={gettext("Delete")}>
                  <button
                    id="delete-media-button"
                    type="button"
                    phx-click="show_delete_confirm"
                    class="btn btn-ghost btn-sm 2xl:btn-md btn-square text-base-content/50 hover:text-error"
                  >
                    <.icon name="hero-trash" class="w-4 h-4 2xl:w-5 2xl:h-5" />
                  </button>
                </div>
              </div>
            </div>

            <%= if @media_item.original_title && @media_item.original_title != @media_item.title do %>
              <p class="text-base md:text-lg text-base-content/70 mb-2">
                {@media_item.original_title}
              </p>
            <% end %>

            <div class="flex flex-wrap items-center gap-2 md:gap-3 text-sm md:text-base text-base-content/70">
              <% release = release_date(@media_item.metadata) %>
              <%= if @media_item.year || release do %>
                <span id="media-release-date" class="font-semibold">
                  {format_release_date(release) || @media_item.year}
                </span>
              <% end %>

              <.content_rating_badge
                id="media-content-rating"
                rating={Mydia.Metadata.Access.get_field(@media_item, :content_rating)}
              />

              <%= if rating = get_rating(@media_item) do %>
                <span class="flex items-center gap-1">
                  <.icon name="hero-star-solid" class="w-4 h-4 text-warning" />
                  {rating}/10
                </span>
              <% end %>

              <%= if runtime = get_runtime(@media_item) do %>
                <span>{runtime}</span>
              <% end %>

              <.show_status_badge
                id="media-show-status"
                status={ShowStatus.for_item(@media_item)}
              />

              <button
                type="button"
                phx-click="show_category_modal"
                class="group cursor-pointer"
                title={gettext("Click to change category")}
              >
                <%= if @media_item.category do %>
                  <.category_badge
                    category={@media_item.category}
                    override={@media_item.category_override}
                    class="group-hover:ring-2 group-hover:ring-primary transition-all"
                  />
                <% else %>
                  <span class="badge badge-ghost group-hover:ring-2 group-hover:ring-primary transition-all">
                    {if @media_item.type == "movie",
                      do: gettext("Movie"),
                      else: gettext("TV Show")}
                  </span>
                <% end %>
              </button>
            </div>

            <%!-- Genres --%>
            <%= if genres = get_genres(@media_item) do %>
              <div class="flex flex-wrap gap-2 mt-3">
                <span :for={genre <- genres} class="badge badge-outline">{genre}</span>
              </div>
            <% end %>

            <% links = external_links(@media_item) %>
            <div
              :if={links != []}
              id="media-external-links"
              class="flex flex-wrap items-center gap-2 mt-3"
            >
              <a
                :for={{key, label, url} <- links}
                id={"media-link-#{key}"}
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost btn-xs gap-1"
              >
                {label} <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3" />
              </a>
            </div>
          </div>
          <%!-- Active Download / Grab Status --%>
          <%= if download = get_download_status(@downloads_with_status) do %>
            <%= cond do %>
              <% download.status == "failed" -> %>
                <div class="alert alert-error mb-6" id="failed-grab-alert">
                  <.icon name="hero-exclamation-triangle" class="w-6 h-6" />
                  <div class="flex-1">
                    <h3 class="font-bold">{gettext("Download failed")}</h3>
                    <div class="text-sm">
                      {download.title}
                      <%= if download.error_message do %>
                        — {download.error_message}
                      <% end %>
                    </div>
                  </div>
                  <button
                    class="btn btn-ghost btn-sm"
                    id="dismiss-failed-grab"
                    phx-click="dismiss_failed_grab"
                    phx-value-id={download.id}
                  >
                    {gettext("Dismiss")}
                  </button>
                </div>
              <% download.status == "grabbing" -> %>
                <div class="alert alert-info mb-6" id="grabbing-alert">
                  <span class="loading loading-spinner loading-sm"></span>
                  <div class="flex-1">
                    <h3 class="font-bold">{gettext("Sending to download client")}</h3>
                    <div class="text-sm">{download.title}</div>
                  </div>
                </div>
              <% true -> %>
                <div class="alert alert-info mb-6">
                  <.icon name="hero-arrow-down-tray" class="w-6 h-6" />
                  <div class="flex-1">
                    <h3 class="font-bold">{gettext("Downloading")}</h3>
                    <div class="text-sm">
                      {format_download_status(download.status)}
                      <%= if download.progress do %>
                        - {format_progress(download.progress)}%
                      <% end %>
                    </div>
                  </div>
                </div>
            <% end %>
          <% end %>
          <%!-- Overview Section --%>
          <Components.overview_section media_item={@media_item} />
          <%!-- Recommendations, TV placement. A show renders this collapsed, so
                it costs one row and pushes the episode list down by nothing.
                Movies get it at the bottom of the page instead: see below. --%>
          <RecommendationComponents.recommendations_section
            :if={@media_item.type == "tv_show"}
            media_item={@media_item}
            items={@recommendations}
            expanded={@recommendations_expanded}
            current_user={@current_user}
            adding_ids={@adding_recommendation_tmdb_ids}
            requesting_item_id={@requesting_recommendation_id}
            can_add={@can_create_media}
          />
          <%!-- Episodes Section (TV Shows Only) --%>
          <Components.episodes_section
            media_item={@media_item}
            expanded_seasons={@expanded_seasons}
            expanded_episodes={@expanded_episodes}
            expanded_chunks={@expanded_chunks}
            auto_searching_season={@auto_searching_season}
            rescanning_season={@rescanning_season}
            fetching_season_subtitles={@fetching_season_subtitles}
            auto_searching_episode={@auto_searching_episode}
            player_enabled={@player_enabled}
            current_user_id={@current_user.id}
            transcode_jobs={@transcode_jobs}
            media_file_subtitle_tracks={@media_file_subtitle_tracks}
            segment_statuses={@segment_statuses}
            segment_detection_available={@segment_detection_available}
            season_order_suggestion={@season_order_suggestion}
            season_order_options={@season_order_options}
            can_update_media={@can_update_media}
          />
          <%!-- Media Files Section --%>
          <Components.media_files_section
            media_item={@media_item}
            refreshing_file_metadata={@refreshing_file_metadata}
            transcode_jobs={@transcode_jobs}
            media_file_subtitle_tracks={@media_file_subtitle_tracks}
            current_user_id={@current_user.id}
          />
          <%!-- Everything below here is about other titles, not this one.
                Franchise Section (Movies in the same TMDB collection) --%>
          <FranchiseComponents.franchise_section
            :if={@franchise}
            franchise={@franchise}
            can_add={@can_create_media}
            current_user={@current_user}
            adding_tmdb_ids={@adding_franchise_tmdb_ids}
          />
          <%!-- Recommendations, movie placement. Expanded here, so it sits below
                the file list: 500px of posters between the overview and the file
                the user owns buried the thing they came to the page for. The two
                guards are mutually exclusive and jointly total, so the rail
                always renders in exactly one place. --%>
          <RecommendationComponents.recommendations_section
            :if={@media_item.type != "tv_show"}
            media_item={@media_item}
            items={@recommendations}
            expanded={@recommendations_expanded}
            current_user={@current_user}
            adding_ids={@adding_recommendation_tmdb_ids}
            requesting_item_id={@requesting_recommendation_id}
            can_add={@can_create_media}
          />
        </div>
        <%!-- History. A sibling of the main column rather than part of it: past
              the container-query threshold it is the third grid column, and
              below it md:col-span-2 drops it to a full-width row under both
              other columns. One DOM node serves both layouts, so there is no
              hidden/@7xl:block duplicate.

              Not sticky. It used to be a sticky max-h-[calc(100vh-2rem)]
              overflow-y-auto box next to a sticky poster column and the page
              scroll, and its sticky never pinned: measured top offsets were 64
              at rest, 0 mid-scroll and -48 at the page bottom. At @7xl it now
              scrolls inside its own column like the other two (see the grid
              above), so nothing rides the page scroll and an expanded rail's
              bottom stays reachable. The five-event collapsed cap stays: it
              keeps the rail short enough to read at a glance. Below @7xl it is
              an ordinary full-width row, collapsed or expanded.

              The :if here is load-bearing alongside the grid template's own
              @timeline_events == [] conditional above, and neither one makes
              the other redundant: this aside carries @7xl:col-start-3 and
              @7xl:row-start-1 unconditionally, so even when the grid template
              picks the two-track layout, a rendered-but-empty aside would
              still force Grid to open an implicit third column (and, below
              the threshold, an implicit row) to satisfy that placement, and
              gap-4/gap-6 still applies to a track that exists but is empty.
              The template conditional stops the 20rem column from being
              reserved; this :if stops the aside from existing in the grid at
              all when there is nothing to place, which is what actually
              removes the gap. --%>
        <aside
          :if={@timeline_events != []}
          id="history-rail"
          class="md:col-span-2 @7xl:col-span-1 @7xl:col-start-3 @7xl:row-start-1 @7xl:overflow-y-auto @7xl:overscroll-contain"
        >
          <Components.timeline_section
            timeline_events={@timeline_events}
            expanded={@timeline_expanded}
            display={@time_display}
          />
        </aside>
      </div>
    </div>
  </div>

  <%!-- Modals --%>
  <%= if @show_delete_confirm do %>
    <Modals.delete_confirm_modal
      media_item={@media_item}
      delete_files={@delete_files}
      delete_preview={@delete_preview}
    />
  <% end %>
  <%= if @show_file_delete_confirm && @file_to_delete do %>
    <Modals.file_delete_confirm_modal
      file_to_delete={@file_to_delete}
      file_delete_mode={@file_delete_mode}
    />
  <% end %>
  <%= if @show_file_details_modal && @file_details do %>
    <Modals.file_details_modal
      file_details={@file_details}
      file_origin={@file_origin}
      current_user_id={@current_user.id}
      display={@time_display}
    />
  <% end %>
  <%= if @show_download_cancel_confirm && @download_to_cancel do %>
    <Modals.download_cancel_confirm_modal download_to_cancel={@download_to_cancel} />
  <% end %>
  <%= if @show_download_delete_confirm && @download_to_delete do %>
    <Modals.download_delete_confirm_modal download_to_delete={@download_to_delete} />
  <% end %>
  <%= if @show_reidentify_modal do %>
    <Modals.reidentify_modal provider={@reidentify_provider} candidates={@reidentify_candidates} />
  <% end %>
  <%= if @fix_match do %>
    <FixMatchModal.fix_match_modal fix_match={@fix_match} media_item={@media_item} />
  <% end %>
  <%= if @find_file_target do %>
    <FindFileComponents.find_file_modal
      title={find_file_title(@find_file_target)}
      query={@find_file_query}
      suggestions={@find_file_suggestions}
      scanning={Map.values(@find_file_runs)}
    />
  <% end %>
  <%= if @show_manual_search_modal do %>
    <Modals.manual_search_modal
      manual_search_context={@manual_search_context}
      existing={@manual_search_existing}
      blocking={@manual_search_blocking}
      media_item={@media_item}
      manual_search_query={@manual_search_query}
      searching={@searching}
      close_after_grab={@close_after_grab}
      download_error={@download_error}
      results_empty?={@results_empty?}
      raw_results_empty?={@raw_search_results == []}
      indexer_progress={@indexer_progress}
      cardigann_summary={@cardigann_summary}
      streams={@streams}
      quality_filter={@quality_filter}
      source_filter={@source_filter}
      codec_filter={@codec_filter}
      filter_options={
        MydiaWeb.MediaLive.Show.SearchHelpers.filter_options(
          @raw_search_results,
          @source_filter,
          @codec_filter
        )
      }
      min_seeders={@min_seeders}
      sort_by={@sort_by}
    />
  <% end %>
  <%!-- After the manual search modal so it stacks on top when opened from the
       dialog's "already downloading" banner. --%>
  <%= if @show_download_details_modal && @download_details do %>
    <Modals.download_details_modal download_details={@download_details} display={@time_display} />
  <% end %>
  <%= if @show_rename_modal do %>
    <RenameModal.rename_files_modal
      rename_previews={@rename_previews}
      rename_selected={@rename_selected}
      renaming_files={@renaming_files}
    />
  <% end %>
  <%= if @show_subtitle_search_modal && @selected_media_file do %>
    <SubtitleModal.subtitle_search_modal
      media_file={@selected_media_file}
      subtitle_search_state={@subtitle_search_state}
      subtitle_search_results={@subtitle_search_results}
      subtitle_providers={@subtitle_providers}
      downloading_subtitle_index={@downloading_subtitle_index}
      selected_languages={@selected_languages}
    />
  <% end %>
  <%= if @show_subtitle_upload_modal && @selected_media_file do %>
    <SubtitleModal.subtitle_upload_modal
      media_file={@selected_media_file}
      uploads={@uploads}
      error={@subtitle_upload_error}
    />
  <% end %>
  <%= if @show_subtitle_manage_modal && @selected_media_file do %>
    <SubtitleModal.subtitle_manage_modal
      media_file={@selected_media_file}
      tracks={@manage_tracks}
    />
  <% end %>
  <%= if @show_category_modal && @category_form do %>
    <Modals.category_override_modal
      media_item={@media_item}
      category_form={@category_form}
      available_categories={@available_categories}
    />
  <% end %>
  <%= if @show_trailer_modal do %>
    <% trailer_url = get_trailer_embed_url(@media_item) %>
    <%= if trailer_url do %>
      <Modals.trailer_modal trailer_url={trailer_url} title={@media_item.title} />
    <% end %>
  <% end %>
  <%= if @show_quality_profile_modal do %>
    <PickerModals.quality_profile_modal
      media_item={@media_item}
      quality_profiles={@quality_profiles}
      default_quality_profile_name={@default_quality_profile_name}
    />
  <% end %>
  <%= if @show_download_audio_modal do %>
    <MydiaWeb.MediaLive.Show.DownloadAudioComponents.download_audio_modal media_item={@media_item} />
  <% end %>
  <%= if @show_target_library_modal do %>
    <PickerModals.target_library_modal
      media_item={@media_item}
      libraries={@target_library_candidates}
    />
  <% end %>
  <%= if @show_add_to_collection_modal do %>
    <PickerModals.add_to_collection_modal
      media_item={@media_item}
      user_collections={@user_collections}
      item_collections={@item_collections}
    />
  <% end %>

  <%!-- Same dialog Discover and the Dashboard use. config_open guards Escape:
        add_config_modal/1 is z-[1000] above this z-999, both bind
        phx-window-keydown, and phx-window-keydown is not scoped by visual
        stacking, so without it one Escape press would close both layers. --%>
  <.live_component
    module={MydiaWeb.Live.Components.TrendingDetailModal}
    id="media-detail-modal"
    item={@selected_item}
    metadata={@selected_metadata}
    loading={@detail_loading}
    current_user={@current_user}
    current_scope={@current_scope}
    open={@selected_item != nil}
    config_open={@add_config != nil}
    add_event="add_selected_item"
    request_event="request_selected_item"
  >
    <:rail>
      <DiscoverComponents.media_rail
        :if={@selected_item}
        id="media-detail-modal-rail"
        items={@selected_recommendations}
        media_type={@selected_item.media_type}
        current_user={@current_user}
        adding_ids={@adding_recommendation_tmdb_ids}
        requesting_item_id={@requesting_recommendation_id}
        can_add={@can_create_media}
        add_event="add_selected_item"
        request_event="request_selected_item"
      />
    </:rail>
  </.live_component>

  <MydiaWeb.AddMediaComponents.add_config_modal
    config={@add_config}
    quality_profiles={@quality_profiles}
  />
</Layouts.app>
