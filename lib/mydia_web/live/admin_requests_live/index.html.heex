<Layouts.app {assigns}>
  <.admin_page page={:requests} count={length(@requests)}>
    <MydiaWeb.AdminRequestsLive.Components.requests_tab
      requests={@requests}
      filter_status={@filter_status}
    />

    <%!-- Detail popup. config_open is false because this page never opens the
        configure-before-adding dialog. --%>
    <.live_component
      module={MydiaWeb.Live.Components.TrendingDetailModal}
      id="request-detail-modal"
      item={@detail_item}
      metadata={@detail_metadata}
      loading={@detail_loading}
      current_user={@current_user}
      open={@detail_item != nil}
      config_open={false}
    >
      <:actions>
        <MydiaWeb.AdminRequestsLive.Components.detail_actions detail_request={@detail_request} />
      </:actions>
    </.live_component>

    <%= if assigns[:show_approve_modal] && @selected_request do %>
      <MydiaWeb.AdminRequestsLive.Components.approve_request_modal
        selected_request={@selected_request}
        approve_form={@approve_form}
        approve_config={@approve_config}
        quality_profiles={@quality_profiles}
      />
    <% end %>

    <%= if assigns[:show_reject_modal] && @selected_request do %>
      <MydiaWeb.AdminRequestsLive.Components.reject_request_modal
        selected_request={@selected_request}
        reject_form={@reject_form}
      />
    <% end %>
  </.admin_page>
</Layouts.app>
