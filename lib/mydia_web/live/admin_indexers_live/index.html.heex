<Layouts.app {assigns}>
  <.admin_page page={:indexers} count={length(@indexers) + length(@library_indexers)}>
    <:actions>
      <MydiaWeb.AdminIndexersLive.Components.header_actions
        cardigann_enabled={@cardigann_enabled}
        library_indexer_stats={@library_indexer_stats}
      />
    </:actions>
    <MydiaWeb.AdminIndexersLive.Components.indexers_tab
      indexers={@indexers}
      indexer_health={@indexer_health}
      library_indexers={@library_indexers}
      library_indexer_stats={@library_indexer_stats}
      cardigann_enabled={@cardigann_enabled}
      cardigann_engine={@cardigann_engine}
      cardigann_cache_bytes={@cardigann_cache_bytes}
      cardigann_engine_expanded={@cardigann_engine_expanded}
      flaresolverr={@flaresolverr}
      flaresolverr_status={@flaresolverr_status}
      retesting_paused={@retesting_paused}
      search_stats={@search_stats}
      search_stats_window={@search_stats_window}
    />
    <MydiaWeb.AdminIndexersLive.Components.modals {assigns} />
    <MydiaWeb.AdminIndexersLive.SearchStatsComponents.failures_modal failures={@search_failures} />
    <MydiaWeb.AdminIndexersLive.LoginComponents.login_prompt {assigns} />
  </.admin_page>
</Layouts.app>
