<Layouts.app {assigns}>
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2">{gettext("Welcome to Mydia")}</h1>
    <p class="text-base-content/70">{gettext("Your personal media management system")}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Movies Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">
          <.icon name="hero-film" class="w-6 h-6 text-primary" /> {gettext("Movies")}
        </h2>
        <p class="text-3xl font-bold">{@movie_count}</p>
        <p class="text-sm text-base-content/60">{gettext("Total movies")}</p>
      </div>
    </div>

    <!-- TV Shows Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">
          <.icon name="hero-tv" class="w-6 h-6 text-primary" /> {gettext("TV Shows")}
        </h2>
        <p class="text-3xl font-bold">{@tv_show_count}</p>
        <p class="text-sm text-base-content/60">{gettext("Total series")}</p>
      </div>
    </div>

    <!-- Downloads Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">
          <.icon name="hero-arrow-down-tray" class="w-6 h-6 text-primary" /> {gettext("Downloads")}
        </h2>
        <p class="text-3xl font-bold">0</p>
        <p class="text-sm text-base-content/60">{gettext("Active downloads")}</p>
      </div>
    </div>

    <!-- Storage Card -->
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">
          <.icon name="hero-circle-stack" class="w-6 h-6 text-primary" /> {gettext("Storage")}
        </h2>
        <p class="text-3xl font-bold">0 GB</p>
        <p class="text-sm text-base-content/60">{gettext("Total storage used")}</p>
      </div>
    </div>
  </div>

  <div class="mt-8">
    <div class="alert alert-info">
      <.icon name="hero-information-circle" class="w-5 h-5" />
      <div>
        <p class="font-semibold">{gettext("Getting Started")}</p>
        <p class="text-sm">
          {gettext("Your media library is empty. Start by adding movies or TV shows!")}
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
