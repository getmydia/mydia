<div class="flex min-h-screen items-center justify-center bg-base-200">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl font-bold">Sign In</h2>
      <p class="text-sm text-base-content/70 mb-4">
        Sign in with your username and password.
      </p>

      <%!-- Display flash messages --%>
      <div :if={Phoenix.Flash.get(@flash, :error)} class="alert alert-error mb-4">
        <.icon name="hero-exclamation-circle" class="size-5 shrink-0" />
        <span>{Phoenix.Flash.get(@flash, :error)}</span>
      </div>

      <div :if={Phoenix.Flash.get(@flash, :info)} class="alert alert-info mb-4">
        <.icon name="hero-information-circle" class="size-5 shrink-0" />
        <span>{Phoenix.Flash.get(@flash, :info)}</span>
      </div>

      <.form for={@changeset} action={~p"/auth/local/login"} id="login-form">
        <div class="form-control">
          <label class="label" for="user_username">
            <span class="label-text">Username</span>
          </label>
          <input
            type="text"
            name="user[username]"
            id="user_username"
            class="input input-bordered w-full"
            autocomplete="username webauthn"
            required
            autofocus
          />
        </div>

        <div class="form-control mt-4">
          <label class="label" for="user_password">
            <span class="label-text">Password</span>
          </label>
          <input
            type="password"
            name="user[password]"
            id="user_password"
            class="input input-bordered w-full"
            required
          />
        </div>

        <div class="form-control mt-6">
          <button type="submit" class="btn btn-primary w-full">
            Log In
          </button>
        </div>
      </.form>

      <div
        :if={@passkeys_available}
        id="passkey-login-section"
        class="hidden mt-4"
        data-options-url={~p"/auth/passkey/options"}
        data-login-url={~p"/auth/passkey/login"}
      >
        <div class="divider text-xs text-base-content/60">or</div>
        <button type="button" id="passkey-login" class="btn btn-outline w-full">
          <.icon name="hero-finger-print" class="size-5" /> Sign in with a passkey
        </button>
        <p id="passkey-login-error" class="hidden text-error text-sm mt-2" role="alert"></p>
      </div>

      <%= if @oidc_configured do %>
        <div class="divider">OR</div>

        <div class="text-center">
          <a href="/auth/oidc" class="btn btn-outline btn-secondary w-full">
            Log in with OIDC
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>
