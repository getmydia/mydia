package mydia:cardigann-deny@1.0.0;

/// Exports every wasi:http and wasi:sockets interface the Cardigann guest
/// imports, with bodies that trap. build.sh composes it under the guest so the
/// final component imports none of them.
world deny {
  export wasi:http/types@0.2.0;
  export wasi:http/outgoing-handler@0.2.0;
  export wasi:sockets/network@0.2.6;
  export wasi:sockets/instance-network@0.2.6;
  export wasi:sockets/udp@0.2.6;
  export wasi:sockets/udp-create-socket@0.2.6;
  export wasi:sockets/tcp@0.2.6;
  export wasi:sockets/tcp-create-socket@0.2.6;
  export wasi:sockets/ip-name-lookup@0.2.6;
}
