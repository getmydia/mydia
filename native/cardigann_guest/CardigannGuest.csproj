<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS8632</NoWarn>
    <RootNamespace>Mydia.CardigannGuest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WasmBuild)' == 'true'">
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <OutputType>Library</OutputType>
    <DefineConstants>$(DefineConstants);WASM_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="shim/**/*.cs" />
    <Compile Include="exports/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include=".prowlarr/src/NzbDrone.Common/EnsureThat/Resources/ExceptionMessages.resx"
                      LogicalName="NzbDrone.Common.EnsureThat.Resources.ExceptionMessages.resources" />
  </ItemGroup>

  <ItemGroup Condition="'$(WasmBuild)' == 'true'">
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <PackageReference Include="runtime.linux-x64.microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26355.1" />
    <Wit Include="wit/cardigann.wit" World="cardigann" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="AngleSharp.Xml" Version="1.0.0" />
    <PackageReference Include="FluentValidation" Version="9.5.4" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.27" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
